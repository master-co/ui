{
  "name": "master-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "bun run --cwd site dev",
    "build": "bun run --cwd site build",
    "build:ui": "bun run --cwd packages/ui build",
    "build:site:cloudflare-pages": "bash scripts/build-site-hosted.sh",
    "preview": "bun run --cwd site preview",
    "test": "bun run --cwd packages/ui test",
    "type-check": "bun run --cwd site type-check && bun run --cwd packages/ui type-check",
    "check": "bun run commit-check && bun run skills:check && bun run check:release && bun run test:release && bun run test && bun run type-check",
    "check:release": "bun scripts/release-config-check.mjs",
    "commit-check": "aronrepo check --from HEAD~1",
    "skills:sync": "master-skills sync",
    "skills:check": "master-skills check",
    "test:site": "node --test site/tests/documentation.e2e.mjs",
    "test:site-hosting": "node --test site/tests/registry-retirement.test.mjs",
    "test:release": "node --test scripts/pages-site-manifest.test.mjs scripts/pages-site-release.test.mjs scripts/pages-release-github.test.mjs scripts/pages-release-target.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/ui.git"
  },
  "devDependencies": {
    "@master/internal-skills": "0.1.6",
    "@types/node": "^24.12.2",
    "aronrepo": "4.0.2",
    "husky": "9.1.7",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
