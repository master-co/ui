{
    "name": "@master/ui.react",
    "type": "module",
    "scripts": {
        "build": "techor build \"src/**/*.tsx\"",
        "dev": "pnpm build --watch",
        "type-check": "tsc --noEmit",
        "lint": "eslint src",
        "e2e": "playwright test -c e2e/playwright-ct.config.ts"
    },
    "license": "MIT",
    "description": "Master UI for React",
    "author": "Aoyue Design LLC.",
    "funding": "https://alpha.ui.master.co/sponsor",
    "homepage": "https://alpha.ui.master.co",
    "bugs": {
        "url": "https://github.com/master-co/ui/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/ui.git",
        "directory": "packages/react"
    },
    "keywords": [
        "component",
        "react",
        "ui",
        "mastercss",
        "reactjs",
        "nextjs",
        "solidjs"
    ],
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "jsnext:main": "./dist/index.mjs",
    "esnext": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "require": "./dist/index.cjs",
            "import": "./dist/index.mjs",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "peerDependencies": {
        "@types/react": ">=15",
        "react": ">= 16.8.0"
    },
    "dependencies": {
        "@master/ui": "workspace:^",
        "clsx": "^2.1.1"
    },
    "devDependencies": {
        "@playwright/experimental-ct-react": "1.41.2",
        "@playwright/test": "1.41.2",
        "shared": "workspace:^"
    }
}