{
  "name": "@master/ui",
  "type": "module",
  "description": "Native HTML and CSS components crafted with Master CSS, with the contracts, behaviors and checker that let people and agents build on them, and React, Svelte and Vue components for the patterns that hold state",
  "license": "MIT",
  "author": "Aoyue Design LLC.",
  "homepage": "https://ui.master.co",
  "bugs": {
    "url": "https://github.com/master-co/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/ui.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "mastercss",
    "css",
    "html",
    "ui",
    "components",
    "contracts",
    "ai",
    "registry",
    "react",
    "svelte",
    "vue"
  ],
  "style": "./master.css",
  "bin": {
    "master-ui": "./bin/master-ui.js"
  },
  "exports": {
    ".": {
      "style": "./master.css",
      "default": "./master.css"
    },
    "./master.css": "./master.css",
    "./theme.css": "./theme.css",
    "./components/*.css": "./components/*.css",
    "./layouts/*.css": "./layouts/*.css",
    "./themes/*.css": "./themes/*.css",
    "./components/*.json": "./components/*.json",
    "./layouts/*.json": "./layouts/*.json",
    "./contract.schema.json": "./contract.schema.json",
    "./contracts.json": "./dist/contracts.json",
    "./theme.json": "./dist/theme.json",
    "./standalone.css": "./dist/standalone.css",
    "./base.css": "./dist/base.css",
    "./dist/*": "./dist/*",
    "./behaviors": {
      "types": "./dist/behaviors/index.d.ts",
      "default": "./behaviors/index.js"
    },
    "./behaviors/*.js": {
      "types": "./dist/behaviors/*.d.ts",
      "default": "./behaviors/*.js"
    },
    "./check": "./check/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "master.css",
    "theme.css",
    "components/*.css",
    "components/*.json",
    "layouts/*.css",
    "layouts/*.json",
    "themes/*.css",
    "behaviors/*.js",
    "frameworks",
    "check",
    "bin",
    "dist",
    "contract.schema.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "masterCSS": {
    "contracts": "./dist/contracts.json",
    "check": "./check/index.js"
  },
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/behaviors/*.test.ts tests/frameworks/sources.test.ts tests/frameworks/react.test.ts tests/frameworks/vue.test.ts tests/frameworks/svelte-server.test.ts && node --conditions=browser --import tsx --test tests/frameworks/svelte.test.ts",
    "prepack": "bun run build",
    "playground": "vite --config tests/frameworks/playground/vite.config.ts",
    "type-check": "bun run build && tsc -p tsconfig.json && svelte-check --tsconfig tests/frameworks/svelte/tsconfig.json && vue-tsc --noEmit -p tests/frameworks/vue/tsconfig.json",
    "test:browser": "bun run build && node --import tsx --test tests/frameworks/browser.test.ts"
  },
  "peerDependencies": {
    "@master/css": "^2.1.0"
  },
  "devDependencies": {
    "@master/css": "2.1.3",
    "@master/css-compiler": "2.1.3",
    "@master/css-preset": "2.1.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "react": "19",
    "react-dom": "19",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue": "3",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
