{
  "name": "@master/ui",
  "type": "module",
  "description": "Native HTML and CSS components crafted with Master CSS, with the contracts, behaviors and checker that let people and agents build on them",
  "license": "MIT",
  "author": "Aoyue Design LLC.",
  "homepage": "https://ui.master.co",
  "bugs": {
    "url": "https://github.com/master-co/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/ui.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "mastercss",
    "css",
    "html",
    "ui",
    "components",
    "design-system",
    "contracts",
    "ai",
    "registry"
  ],
  "style": "./master.css",
  "bin": {
    "master-ui": "./bin/master-ui.js"
  },
  "exports": {
    ".": {
      "style": "./master.css",
      "default": "./master.css"
    },
    "./master.css": "./master.css",
    "./theme.css": "./theme.css",
    "./components/*.css": "./components/*.css",
    "./layouts/*.css": "./layouts/*.css",
    "./themes/*.css": "./themes/*.css",
    "./components/*.json": "./components/*.json",
    "./layouts/*.json": "./layouts/*.json",
    "./contract.schema.json": "./contract.schema.json",
    "./contracts.json": "./dist/contracts.json",
    "./theme.json": "./dist/theme.json",
    "./standalone.css": "./dist/standalone.css",
    "./base.css": "./dist/base.css",
    "./dist/*": "./dist/*",
    "./behaviors": "./behaviors/index.js",
    "./behaviors/*.js": "./behaviors/*.js",
    "./check": "./check/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "master.css",
    "theme.css",
    "components/*.css",
    "components/*.json",
    "layouts/*.css",
    "layouts/*.json",
    "themes/*.css",
    "behaviors/*.js",
    "check",
    "bin",
    "dist",
    "contract.schema.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "masterCSS": {
    "contracts": "./dist/contracts.json",
    "check": "./check/index.js"
  },
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/behaviors/*.test.ts",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "@master/css": "^2.1.0"
  },
  "devDependencies": {
    "@master/css": "2.1.1",
    "@master/css-compiler": "2.1.1",
    "@master/css-preset": "2.1.1",
    "happy-dom": "^21.0.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
