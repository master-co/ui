{
  "name": "@master/ui",
  "type": "module",
  "description": "Native HTML and CSS components crafted with Master CSS",
  "license": "MIT",
  "author": "Aoyue Design LLC.",
  "homepage": "https://ui.master.co",
  "bugs": {
    "url": "https://github.com/master-co/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/ui.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "mastercss",
    "css",
    "html",
    "ui",
    "components",
    "design-system"
  ],
  "style": "./master.css",
  "exports": {
    ".": {
      "style": "./master.css",
      "default": "./master.css"
    },
    "./master.css": "./master.css",
    "./theme.css": "./theme.css",
    "./components/*.css": "./components/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "master.css",
    "theme.css",
    "components/*.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@master/css": "^2.1.0"
  },
  "devDependencies": {
    "@master/css": "2.1.1",
    "@master/css-compiler": "2.1.1",
    "@master/css-preset": "2.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
