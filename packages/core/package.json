{
    "name": "@master/ui",
    "type": "module",
    "scripts": {
        "build": "techor build",
        "dev": "pnpm build --watch",
        "test": "vitest",
        "type-check": "tsc --noEmit",
        "lint": "eslint src"
    },
    "license": "MIT",
    "description": "Beautiful UI designs crafted with Master CSS",
    "author": "Aoyue Design LLC.",
    "funding": "https://alpha.ui.master.co/sponsor",
    "homepage": "https://alpha.ui.master.co",
    "bugs": {
        "url": "https://github.com/master-co/ui/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/ui.git",
        "directory": "packages/core"
    },
    "keywords": [
        "style",
        "html",
        "css",
        "ui",
        "lightweight",
        "mastercss",
        "components",
        "layouts",
        "design",
        "templates",
        "examples"
    ],
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "jsnext:main": "./dist/index.mjs",
    "esnext": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "browser": "./dist/global.min.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "require": "./dist/index.cjs",
            "import": "./dist/index.mjs",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "dependencies": {
        "@master/css": "rc"
    },
    "devDependencies": {
        "@master/css-runtime": "2.0.0-rc.44",
        "shared": "workspace:^"
    }
}