{
    "compilerOptions": {
        "paths": {
            "internal/*": [ "./node_modules/internal/*" ],
            "~/*": [ "./*" ],
        },
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "Bundler",
        "lib": [
            "esnext",
            "dom",
            "dom.iterable"
        ],
        "types": [
            "node"
        ],
        "esModuleInterop": true,
        "strict": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "skipLibCheck": true
    },
    "exclude": [
        "**/dist/**",
        "**/node_modules/**"
    ]
}