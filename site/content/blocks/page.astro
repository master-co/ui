---
import '@master/internal-site/styles/system/pagehead.css'
import DocMain from '@master/internal-site/components/DocMain.astro'
import Link from '@master/internal-site/components/Link.svelte'
import { createPageMetadata } from '@master/internal-site/factories/create-page'
import { siteOf } from '@master/internal-site/astro/site-context'
import ComponentIndex from '~/site/components/ComponentIndex.astro'
import LocalizedText from '~/site/components/LocalizedText.astro'
import dictionaries from '~/site/dictionaries'
import { footerProps } from '~/site/navigation'
import metadata from './metadata'

/** The blocks overview: every block as a cover, four to a row, without the documentation sidebar. */
export const generateMetadata = createPageMetadata(metadata, dictionaries)
const { t } = siteOf(Astro)
---

<DocMain class="component-overview" footerProps={footerProps}>
  <div class="component-overview-body">
    <header class="ui-pagehead">
      <h1>{t('Blocks')}</h1>
      <p><LocalizedText text={t('A block is one stretch of a page with a purpose: a hero, a pricing table, a footer. It is {components} and utilities, composed. Copy the markup and make the words yours; there is nothing to install beyond the library.')}>
        <Link slot="components" href="/components">{t('components')}</Link>
      </LocalizedText></p>
    </header>
    <ComponentIndex kind="blocks" />
  </div>
</DocMain>
