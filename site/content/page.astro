---
import '@master/internal-site/home/design.css'
import '@master/internal-site/home/home.css'
import '../styles/home.css'
import '../styles/home-accents.css'
import DocHeader from '@master/internal-site/components/DocHeader.svelte'
import HomeLamp from '@master/internal-site/home/HomeLamp.svelte'
import HomeFooter from '@master/internal-site/home/HomeFooter.svelte'
import { createPageMetadata } from '@master/internal-site/factories/create-page'
import { createTranslation } from '@master/internal-site/utils/i18n'
import dictionaries from '~/site/dictionaries'
import { footerNavGroups } from '~/site/navigation'
import HomeHero from '~/site/components/home/HomeHero.astro'
import HomePlatform from '~/site/components/home/HomePlatform.astro'
import HomeMarkup from '~/site/components/home/HomeMarkup.astro'
import HomeLibrary from '~/site/components/home/HomeLibrary.astro'
import HomeThemes from '~/site/components/home/HomeThemes.astro'
import HomeCost from '~/site/components/home/HomeCost.astro'
import HomeCompare from '~/site/components/home/HomeCompare.astro'
import HomeContracts from '~/site/components/home/HomeContracts.astro'
import HomeClose from '~/site/components/home/HomeClose.astro'

export const documentStyles = false
export const metadata = {
  title: { absolute: 'Master UI - Native HTML and CSS components for Master CSS' },
  description: 'Native HTML and CSS components on Master CSS tokens, each with a contract people and coding agents write to. Copy the markup, keep your stack, own the source.',
  openGraph: { title: 'Master UI' },
  /** The hero drawn as a card by `scripts/home-cover.mjs`. */
  cover: { src: '/brand/master-ui-og.png', alt: 'Master UI - Craft the most refined interfaces, natively.', width: 1200, height: 630 }
}
/**
 * A translated home page has its title and description in its own language, from the interface dictionary, and its
 * own card: the hero of that edition, `master-ui-og.<locale>.png`, described by its translated headline.
 */
export async function generateMetadata(props: { params: { locale: string } }) {
  const { locale } = props.params
  const $ = await createTranslation(locale, dictionaries)
  const resolved = await createPageMetadata(metadata, dictionaries)(props)
  if (locale === 'en') return resolved
  return { ...resolved, cover: { ...metadata.cover, src: `/brand/master-ui-og.${locale}.png`, alt: `Master UI - ${$('Craft the most refined interfaces, natively.')}` } }
}

const website = Astro.props.params.locale === 'en' && {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Master UI',
  url: new URL('/', Astro.site).href
}
---

{website && <script is:inline type="application/ld+json" set:html={JSON.stringify(website).replace(/</g, '\\u003c')} />}

<DocHeader client:load class="home-header" stickable />
<main class="overflow-clip home-page">
  <HomeHero />
  <HomePlatform />
  <HomeThemes />
  <HomeMarkup />
  <HomeCost />
  <HomeCompare />
  <HomeContracts />
  <HomeLibrary />
  <HomeClose />
  <HomeLamp client:idle={{ timeout: 500 }} />
</main>
<HomeFooter client:idle={{ timeout: 500 }} navGroups={footerNavGroups} wordmark="master ui" />
