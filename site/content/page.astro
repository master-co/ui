---
import '@master/internal-site/home/design.css'
import '@master/internal-site/home/home.css'
import '../styles/home.css'
import '../styles/home-accents.css'
import DocHeader from '@master/internal-site/components/DocHeader.svelte'
import HomeLamp from '@master/internal-site/home/HomeLamp.svelte'
import HomeFooter from '@master/internal-site/home/HomeFooter.svelte'
import { createTranslation } from '@master/internal-site/utils/i18n'
import dictionaries from '~/site/dictionaries'
import { footerNavGroups } from '~/site/navigation'
import HomeHero from '~/site/components/home/HomeHero.astro'
import HomePlatform from '~/site/components/home/HomePlatform.astro'
import HomeMarkup from '~/site/components/home/HomeMarkup.astro'
import HomeLibrary from '~/site/components/home/HomeLibrary.astro'
import HomeThemes from '~/site/components/home/HomeThemes.astro'
import HomeCost from '~/site/components/home/HomeCost.astro'
import HomeCompare from '~/site/components/home/HomeCompare.astro'
import HomeFrameworks from '~/site/components/home/HomeFrameworks.astro'
import HomeContracts from '~/site/components/home/HomeContracts.astro'
import HomeClose from '~/site/components/home/HomeClose.astro'

export const documentStyles = false
export const metadata = {
  title: { absolute: 'Master UI - Native HTML and CSS components for Master CSS' },
  description: 'Interface components written as native HTML and CSS on Master CSS tokens, with a contract for each that people and coding agents write to. Copy the markup, keep your stack, and own the source when you need to.',
}
/** A translated home page has its title and description in its own language, from the interface dictionary. */
export async function generateMetadata({ params }: { params: { locale: string } }) {
  const $ = await createTranslation(params.locale, dictionaries)
  return { title: { absolute: $(metadata.title.absolute) }, description: $(metadata.description) }
}
---

<DocHeader client:load class="home-header" stickable />
<main class="overflow-clip home-page">
  <HomeHero />
  <HomePlatform />
  <HomeThemes />
  <HomeMarkup />
  <HomeCost />
  <HomeCompare />
  <HomeFrameworks />
  <HomeContracts />
  <HomeLibrary />
  <HomeClose />
  <HomeLamp client:idle={{ timeout: 500 }} />
</main>
<HomeFooter client:idle={{ timeout: 500 }} navGroups={footerNavGroups} wordmark="master ui" />
