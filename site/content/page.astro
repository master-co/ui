---
import '@master/internal-site/home/design.css'
import '@master/internal-site/home/home.css'
import '@master/internal-site/home/hero.css'
import '../styles/home.css'
import IconArrowRight from '@tabler/icons-svelte-runes/icons/arrow-right'
import DocHeader from '@master/internal-site/components/DocHeader.svelte'
import HeroCanvas from '@master/internal-site/home/HeroCanvas.svelte'
import HomeAction from '@master/internal-site/home/HomeAction.astro'
import HomeLamp from '@master/internal-site/home/HomeLamp.svelte'
import HomeFooter from '@master/internal-site/home/HomeFooter.svelte'
import Link from '@master/internal-site/components/Link.svelte'
import { siteOf } from '@master/internal-site/astro/site-context'
import generate from '@master/internal-site/utils/generate-metadata'
import dictionaries from '~/site/dictionaries'
import { footerNavGroups } from '~/site/navigation'
import { components } from '~/site/components/catalog'

export const documentStyles = false
export const metadata = {
  title: { absolute: 'Master UI - Native HTML and CSS components for Master CSS' },
  description: 'Accessible interface components written as native HTML and CSS on Master CSS tokens. Copy the markup, keep your stack, and adjust every instance with utilities.',
}
export const generateMetadata = (props: any) => generate(metadata, props, dictionaries)
const { t } = siteOf(Astro)
---

<DocHeader client:load class="home-header" stickable />
<main class="overflow-clip home-page">
  <section data-glyph-host class="relative overflow-hidden isolate home-hero">
    <HeroCanvas client:load class="home-hero-field" />
    <div class="relative app-wrapper home-hero-body home-section-wrap">
      <Link class="home-glass home-hero-pill" href="/components">
        <span class="home-hero-pill-badge">{t('Alpha')}</span>
        <span class="home-hero-pill-label">{t('Native HTML and CSS components')}</span>
        <IconArrowRight aria-hidden="true" size={14} stroke={1.75} />
      </Link>
      {/* One line of markup: the title's text nodes are exactly its words and the single gap the glass mask walks. */}
      <h1 class="home-display" data-glass-title><span class="home-display-line">{t('Interface components')}</span><span class="home-title-gap">{' '}</span><span class="home-display-line">{t('crafted with Master CSS.')}</span></h1>
      <p class="home-hero-lead">{t('Moonstone and obsidian materials, layered light and shadow, written as plain HTML and CSS. Copy the markup into any stack, then adjust each instance with utilities.')}</p>
      <div class="home-hero-actions">
        <HomeAction href="/guide/introduction" variant="primary">
          {t('Get started')}
          <IconArrowRight aria-hidden="true" size={16} stroke={1.75} />
        </HomeAction>
        <HomeAction href="/components" variant="secondary">{t('Browse components')}</HomeAction>
      </div>
    </div>
  </section>
  <section id="components" class="home-section home-components" aria-labelledby="components-title">
    <div class="app-wrapper home-section-wrap">
      <header class="home-section-header">
        <p class="home-eyebrow"><span class="home-eyebrow-index" aria-hidden="true">01</span><span>{t('Components')}</span></p>
        <h2 id="components-title" class="home-lit home-section-heading home-stone-type"><span>{t('Native first,')}</span>{' '}<span>{t('framework ready.')}</span></h2>
        <p class="home-section-body">{t('Every component starts as semantic markup and one stylesheet. Framework bindings for React, Svelte and Vue will build on the same CSS.')}</p>
      </header>
      <div class="home-component-grid">
        {components.map(component => (
          <a class="home-component" href={`/components/${component.slug}`}>
            <span class="home-component-category">{t(component.category)}</span>
            <h3 class="home-component-name">{t(component.name)}</h3>
            <p class="home-component-description">{t(component.description)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <HomeLamp client:idle={{ timeout: 500 }} />
</main>
<HomeFooter client:idle={{ timeout: 500 }} navGroups={footerNavGroups} wordmark="master ui" />
