---
import DocumentShell from '@master/internal-site/sections/document.astro'
import GuideShell from '@master/internal-site/sections/guide.astro'
import DocHeader from '@master/internal-site/components/DocHeader.svelte'
import DocWrapper from '@master/internal-site/components/DocWrapper.astro'

/**
 * The components section. A component page reads in the documentation shell, beside the sidebar.
 * The overview is itself the list of every page, so it takes the full width and leaves the sidebar out.
 */
export const bodyClass = 'bg-surface-base'

// A static build names the page `components.html`; the dev server serves `/components`.
const overview = /\/components(?:\.html|\/)?$/.test(Astro.url.pathname)
---

{overview
  ? <DocumentShell>
      <DocHeader client:load contained />
      <DocWrapper><slot /></DocWrapper>
    </DocumentShell>
  : <GuideShell><slot /></GuideShell>}
