---
import CodeTabs from '@master/internal-site/components/CodeTabs.astro'
import Demo from '@master/internal-site/demo/Demo.svelte'
import PreviewViewport from '~/site/components/PreviewViewport.svelte'
import PreviewGuard from '~/site/components/PreviewGuard.astro'
import DocumentPreviewSwitch from '@master/internal-site/components/DocumentPreviewSwitch.astro'
import CodeLanguageSelect from '~/site/components/CodeLanguageSelect.astro'
import MarkupSource from '~/site/components/MarkupSource.astro'
import { markupLanguages, markupSources, printMarkup } from '~/site/utils/framework-markup'
import { previewDocument, previewHead as head } from '~/site/utils/preview'
import { behaviorsScript, uiSource } from '~/site/utils/ui-source'
import { example as exampleOf, exampleFiles, exampleHtml, exampleScriptUrl } from '~/site/utils/examples'

interface Props {
  /** A stable id, unique within the page. */
  name: string
  title: string
  /** Trusted site-authored markup; never pass user-provided HTML. Give this or `example`, not both. */
  html?: string
  /**
   * A working example in `site/examples`, by its id in the manifest: its markup runs here with its module,
   * served from the site's own origin, and the Code view shows every file it is made of, one tab to a file.
   */
  example?: string
  caption?: string
  /** Utilities for the preview's body. A page starts at the viewport's edge, so the default removes the body's padding. */
  bodyClass?: string
  /** The viewport's height in its own pixels; `100dvh` in the markup resolves to it. */
  height?: number
  /** Authored heights at the two narrower viewport widths; no content measurement is needed. */
  tabletHeight?: number
  phoneHeight?: number
  /** Larger touch targets may need a little more room at each authored viewport width. */
  touchHeight?: { desktop?: number; tablet?: number; phone?: number }
  /** The width the preview opens at. */
  size?: 'desktop' | 'tablet' | 'phone'
  /**
   * Attach the package's behaviors to the preview, for a page that holds a pattern which needs a script. The
   * preview runs the published scripts, and the Code view ends with the two lines a reader writes to do the same.
   */
  behaviors?: boolean
}

/**
 * A layout or a block as a page: a real viewport at a desktop, tablet or phone width, scaled to the column
 * that holds it. The viewport is a window on a striped stage, a margin away from the tray's edge, so where the
 * page ends is plain at every width. The document inside is laid out at the chosen width, so queries, `dvh` and sticky regions
 * behave as they would in a window of that size; only the drawing is scaled.
 * The source sits behind a second view of the same tray: Preview, the default, or Code.
 * Both choices are radios read by the stylesheet: the preview needs no script of its own.
 */
if ((Astro.props.html === undefined) === (Astro.props.example === undefined)) throw new Error(`PagePreview ${Astro.props.name} takes html or example, and only one of them`)
const given = Astro.props.example ? exampleOf(Astro.props.example) : undefined
const { name, title, caption = '', bodyClass = given?.preview.bodyClass ?? 'p(0)', height = given?.preview.height ?? 720, size = given?.preview.size ?? 'desktop', behaviors = false } = Astro.props
const { tabletHeight = given?.preview.tabletHeight ?? height } = Astro.props
const { phoneHeight = given?.preview.phoneHeight ?? tabletHeight, touchHeight = {} } = Astro.props
const html = Astro.props.example ? exampleHtml(Astro.props.example) : Astro.props.html!
const files = Astro.props.example ? exampleFiles(Astro.props.example) : []
const module = Astro.props.example && given?.script ? `\n<script type="module" src="${exampleScriptUrl(Astro.props.example)}"></script>` : ''
const running = behaviors ? `${html}\n<script>${behaviorsScript()};MasterUI.attach()</script>` : `${html}${module}`
const source = behaviors ? `${html}\n<script type="module">\n  import { attach } from '@master/ui/behaviors'\n\n  attach()\n</script>` : html
// Markup is the same in every framework, so the Code view offers it in each. A pattern with a script and a working
// example, whose module drives the markup, stay as they are written.
const sources = Astro.props.example ? [] : behaviors ? [{ ...markupLanguages[0], code: printMarkup(source, 'html') }] : markupSources(source)
const section = { page: 'library', id: name, title, html: [running], css: uiSource(), classes: [], classLists: [], highlighted: [] }
const document = previewDocument(section as Parameters<typeof previewDocument>[0], { html: running, caption: '', bodyClass, head } as Parameters<typeof previewDocument>[1])
const views = [['preview', 'Preview'], ['code', 'Source code tab']] as const
const sizes = [['desktop', 'Desktop'], ['tablet', 'Tablet'], ['phone', 'Phone']] as const
---

<PreviewGuard />
{/* The wrapper owns the preview's place in the column, so a page can widen it without touching the tray. */}
<div class="page-preview" style={`--preview-height-desktop: ${height}px; --preview-height-tablet: ${tabletHeight}px; --preview-height-phone: ${phoneHeight}px; --preview-height-touch-desktop: ${touchHeight.desktop ?? height}px; --preview-height-touch-tablet: ${touchHeight.tablet ?? tabletHeight}px; --preview-height-touch-phone: ${touchHeight.phone ?? phoneHeight}px`}>
<Demo title={title} caption={caption} frame="none" sourceMode="replace" data-component-preview={name} data-page-preview data-preview-background="stripes">
  <Fragment slot="controls">
    <DocumentPreviewSwitch name={`preview-size-${name}`} label="Viewport" kind="size" options={sizes} value={size} />
    <CodeLanguageSelect sources={sources} />
    <DocumentPreviewSwitch name={`preview-view-${name}`} label="View" kind="view" options={views} value="preview" />
  </Fragment>
  <Fragment slot="source">
    {files.length
      ? <Fragment><Fragment set:html="<!--email_off-->" /><CodeTabs tabs={files.map(file => ({ name: file.name, lang: file.lang, beautify: file.lang === 'html', code: file.content }))} /><Fragment set:html="<!--/email_off-->" /></Fragment>
      : <MarkupSource sources={sources} />}
  </Fragment>
  <PreviewViewport client:idle={{ timeout: 500 }} title={title} document={document} height={height} framed background="stripes" />
</Demo>
</div>

<style is:global>
  @layer components {
    /* In an article the preview hangs past the text column by the prose bleed, as every framed surface does. */
    .page-preview {
      margin-block: var(--line, 1.75rem);
      margin-inline: calc(var(--prose-bleed, 0rem) * -1);
    }

    /*
     * The iframe is laid out at --page-preview-width, then its drawing is scaled to the column.
     * Unlike CSS zoom, a transform preserves the document viewport used by WebKit container layout.
     * A length divided by a length is written with the trigonometry every engine has.
     */
    [data-page-preview] {
      /* A desktop is at least 1280px; a tray wider than that is the desktop, so nothing is left empty beside it. */
      --page-preview-width: max(1280px, 100cqw);
      --preview-height: var(--preview-height-desktop);

      &:has([data-size="tablet"]:checked) {
        --page-preview-width: 768px;
        --preview-height: var(--preview-height-tablet);
      }

      &:has([data-size="phone"]:checked) {
        --page-preview-width: 390px;
        --preview-height: var(--preview-height-phone);
      }

      @media (pointer: coarse) {
        --preview-height: var(--preview-height-touch-desktop);

        &:has([data-size="tablet"]:checked) {
          --preview-height: var(--preview-height-touch-tablet);
        }

        &:has([data-size="phone"]:checked) {
          --preview-height: var(--preview-height-touch-phone);
        }
      }

      /* The stage keeps a margin around the window; its inner width determines the drawing scale. */
      & .preview-body {
        container-type: inline-size;
        padding: var(--ui-space-sm);
        overflow: hidden;

        @media (width >= 48rem) {
          padding: var(--ui-space-md);
        }
      }

      /* Reserve the scaled drawing height without changing the iframe's authored viewport. */
      & .preview-viewport {
        --page-preview-scale: min(1, tan(atan2(100cqw, var(--page-preview-width))));
        height: calc(var(--preview-height) * var(--page-preview-scale));
      }

      /* The sheet supplies the material; the transform changes only how the real viewport is drawn. */
      & .preview-viewport > iframe {
        width: var(--page-preview-width);
        max-width: none;
        margin-inline: calc((100% - var(--page-preview-width)) / 2);
        transform: scale(var(--page-preview-scale));
        transform-origin: top center;
      }

      /* A transformed iframe has a stacking context; the idle shield must stay above that context. */
      &[data-preview-guard="idle"] .preview-viewport::before {
        z-index: 1;
      }
    }
  }
</style>
