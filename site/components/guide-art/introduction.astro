---
import { figureTranslator } from '~/site/i18n/figures'
const f = figureTranslator(Astro)
// Inference: markup and implementation meet at a named contract; replacing
// material does not require replacing the interface the markup uses.
// Evidence: components/button.json and button.css; behaviors/index.js.
// The optional script lane describes scripted patterns, not the button above.
---
<div class="contract-scene">
  <div class="sides"><span>{f('Your markup')}</span><span>{f('Component implementation')}</span></div>
  <div class="agreement">
    <div class="html"><span class="file-label">HTML</span><span>&lt;button</span><span class="shared">class="<strong>btn</strong>"&gt;</span><span>Save&lt;/button&gt;</span></div>
    <div class="bridge"><span>{f('contract')}</span><i></i></div>
    <div class="css"><span class="file-label">CSS</span><span class="shared"><strong>.btn</strong> &#123;</span><span class="rule">{f('theme tokens')}</span><span>&#125;</span></div>
  </div>
  <div class="boundary"><span>{f('Elements')}</span><span>{f('Classes')}</span><span>{f('State attributes')}</span><span>{f('Public properties')}</span></div>
  <div class="optional"><span class="optional-label">{f('For patterns that need a script')}</span><div class="state-flow"><span>{f('Input')}</span><span class="arrow"></span><span class="attribute">{f('Update attributes')}</span><span class="arrow"></span><span>{f('CSS draws state')}</span></div></div>
</div>

<style>
  .contract-scene { color: var(--gf-ink); font-size: 14px; line-height: 1.5; }
  .sides { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; color: var(--gf-muted); font-size: 13px; margin-bottom: 12px; }
  .agreement { display: grid; grid-template-columns: 1fr 72px 1fr; align-items: center; }
  .html, .css { display: grid; font-family: var(--font-family-mono, monospace); font-size: 14px; min-width: 0; gap: 6px; padding: 16px; background: var(--gf-soft); border-radius: 7px; }
  .html { border-left: 2px solid var(--gf-ink); }
  .css { border-right: 2px solid var(--gf-ink); }
  .file-label { color: var(--gf-muted); font-size: 13px; margin-bottom: 6px; }
  .shared strong { font-weight: 500; text-decoration: underline; text-underline-offset: 4px; }
  .rule { color: var(--gf-muted); padding-left: 12px; }
  .bridge { position: relative; font-size: 13px; text-align: center; }
  .bridge span { position: relative; top: -10px; }
  .bridge i { display: block; height: 1px; background: var(--gf-ink); }
  .boundary { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 20px; margin-top: 16px; padding: 12px 0; border-block: 1px solid var(--gf-line); font-size: 13px; }
  .optional { margin-top: 24px; border-left: 1px dashed var(--gf-muted); padding-left: 16px; }
  .optional-label { display: block; color: var(--gf-muted); font-size: 13px; margin-bottom: 12px; }
  .state-flow { display: flex; align-items: center; gap: 12px; font-size: 13px; }
  .attribute { padding: 5px 9px; background: var(--gf-soft); border-radius: 3px; }
  .arrow { min-width: 12px; flex: 1; height: 1px; position: relative; background: var(--gf-line); }
  .arrow::after { content: ''; position: absolute; right: 0; top: -3px; width: 6px; height: 6px; border-top: 1px solid var(--gf-muted); border-right: 1px solid var(--gf-muted); transform: rotate(45deg); }
  @container (max-width: 420px) {
    .sides { gap: 36px; }
    .agreement { grid-template-columns: minmax(0, 1fr) 36px minmax(0, 1fr); }
    .html, .css { padding: 12px 8px; font-size: 13px; overflow-wrap: anywhere; }
    .bridge { display: grid; justify-items: center; gap: 8px; }
    .bridge span { position: static; writing-mode: vertical-rl; }
    .bridge i { width: 100%; }
    .boundary { display: grid; grid-template-columns: 1fr 1fr; text-align: center; gap: 8px; }
    .state-flow { display: grid; grid-template-columns: minmax(0, .65fr) 12px minmax(0, 1fr) 12px minmax(0, 1.1fr); gap: 6px; }
    .state-flow > span:not(.arrow) { min-width: 0; }
    .state-flow .arrow { width: 12px; }
  }
</style>
