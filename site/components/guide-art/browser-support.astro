---
// Inference: with the native popover baseline, anchor positioning changes where
// a popover appears; lack of this enhancement leaves the viewport-centered fallback.
// Evidence: theme.css --anchored @supports(position-area: block-end), popover contract.
// Schematic viewports share the same trigger and surface; position is the variable.
---
<div class="support" aria-hidden="true">
  <div class="baseline"><span class="check">✓</span><strong>Baseline available</strong><span>Native popover opens and closes</span></div>
  <div class="query"><span>↓</span><code>Supports anchor positioning?</code></div>
  <div class="branches">
    <div class="branch">
      <div class="answer"><span class="branch-line"></span><strong>Yes</strong><span>enhancement</span></div>
      <div class="viewport anchored">
        <div class="browser-bar"><i></i><i></i><i></i></div>
        <div class="trigger">Open</div>
        <div class="attachment"></div>
        <div class="popover"><span>Popover</span><i></i><i></i></div>
      </div>
      <div class="position">Placed beside its trigger</div>
    </div>
    <div class="branch">
      <div class="answer"><span class="branch-line"></span><strong>No</strong><span>fallback</span></div>
      <div class="viewport centered">
        <div class="browser-bar"><i></i><i></i><i></i></div>
        <div class="trigger">Open</div>
        <div class="center-lines"></div>
        <div class="popover"><span>Popover</span><i></i><i></i></div>
      </div>
      <div class="position">Centered in the viewport</div>
    </div>
  </div>
  <div class="boundary">This fallback still requires popover support.</div>
</div>

<style>
  .support { display: grid; color: var(--gf-ink); font-size: 13px; line-height: 1.45; }
  .baseline { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 5px 9px; padding: 12px 16px; border-block: 1px solid var(--gf-line); }
  .baseline strong { font-weight: 500; font-size: 14px; }
  .baseline > span:last-child { color: var(--gf-muted); }
  .check { font-size: 16px; }
  .query { display: grid; justify-items: center; gap: 7px; padding-block: 14px; }
  .query > span { color: var(--gf-muted); font-size: 22px; line-height: 1; }
  .query code { font: 13px/1.5 var(--font-family-mono, monospace); text-align: center; }
  .branches { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .branch { min-width: 0; }
  .answer { display: flex; gap: 7px; justify-content: center; align-items: center; padding: 14px 0 12px; position: relative; border-top: 1px solid var(--gf-line); }
  .branch-line { position: absolute; height: 8px; width: 1px; background: var(--gf-line); inset: 0 auto auto 50%; }
  .answer strong { font-size: 14px; font-weight: 500; }
  .answer > span:last-child { color: var(--gf-muted); }
  .viewport { height: 200px; position: relative; background: var(--gf-surface); box-shadow: 0 0 0 .5px var(--gf-line); border-radius: 8px; overflow: hidden; }
  .browser-bar { display: flex; gap: 4px; align-items: center; padding-inline: 10px; height: 23px; border-bottom: 1px solid var(--gf-line); }
  .browser-bar i { display: block; width: 3px; height: 3px; border-radius: 50%; background: var(--gf-muted); opacity: .5; }
  .trigger { position: absolute; top: 42px; left: 17px; padding: 5px 12px; box-shadow: 0 0 0 .5px var(--gf-line); border-radius: 5px; background: var(--gf-soft); font-size: 13px; }
  .popover { position: absolute; display: grid; gap: 9px; width: 118px; padding: 12px; border-radius: 7px; box-shadow: 0 0 0 .5px var(--gf-muted); background: var(--gf-soft); }
  .popover span { font-size: 13px; font-weight: 500; }
  .popover i { display: block; height: 4px; width: 84%; background: var(--gf-line); border-radius: 2px; }
  .popover i:last-child { width: 62%; }
  .anchored .popover { left: 17px; top: 81px; }
  .attachment { position: absolute; left: 45px; top: 72px; height: 8px; border-left: 1px dashed var(--gf-muted); }
  .centered .popover { left: 50%; top: calc(50% + 11px); transform: translate(-50%,-50%); }
  .center-lines { position: absolute; inset: 23px 0 0; background: linear-gradient(var(--gf-line),var(--gf-line)) center / 1px 100% no-repeat, linear-gradient(var(--gf-line),var(--gf-line)) center / 100% 1px no-repeat; opacity: .55; }
  .position { margin-top: 11px; text-align: center; font-size: 13px; }
  .boundary { color: var(--gf-muted); text-align: center; margin-top: 23px; font-size: 13px; }
  @container (max-width: 420px) {
    .baseline { justify-content: start; padding-inline: 0; }
    .baseline > span:last-child { flex-basis: 100%; padding-inline-start: 25px; }
    .branches { grid-template-columns: 1fr; gap: 21px; }
    .viewport { height: 190px; }
    .answer { justify-content: start; padding-top: 11px; }
    .branch-line { display: none; }
    .position { text-align: start; }
  }
</style>
