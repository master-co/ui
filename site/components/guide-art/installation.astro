---
import { figureTranslator } from '~/site/i18n/figures'
const f = figureTranslator(Astro)
// Inference: source CSS needs the app's Master CSS compiler; the published
// standalone stylesheet is already compiled and contains no generated utilities.
// Evidence: packages/ui/package.json exports and packages/ui/scripts/build.ts.
---
<div class="routes">
  <div class="route-title">{f('Choose one stylesheet route')}</div>
  <div class="lane">
    <div class="source"><span class="file-icon">CSS</span><span class="filename">@master/ui</span><span class="small">{f('Source + app classes')}</span></div>
    <div class="travel"><span class="arrow"></span><div class="compiler"><span>Master CSS</span><strong>{f('Compile')}</strong></div><span class="arrow"></span></div>
    <div class="output"><span class="diagram-sheet"></span><span>{f('Components')}</span><span class="small">{f('+ generated utilities')}</span></div>
  </div>
  <div class="separator"><span>{f('or')}</span></div>
  <div class="lane">
    <div class="source"><span class="file-icon">CSS</span><span class="filename">standalone.css</span><span class="small">{f('From the package')}</span></div>
    <div class="travel direct"><span class="bypass">{f('Already compiled')}</span><span class="arrow"></span></div>
    <div class="output"><span class="diagram-sheet"></span><span>{f('Components')}</span><span class="small">{f('Your CSS for layout')}</span></div>
  </div>
  <div class="destination"><span class="browser-mark"><i></i><i></i><i></i></span><span>{f('Load the chosen CSS in your page')}</span></div>
</div>

<style>
  .routes { font-size: 14px; line-height: 1.5; color: var(--gf-ink); }
  .route-title { color: var(--gf-muted); font-size: 13px; margin-bottom: 24px; }
  .lane { display: grid; grid-template-columns: minmax(0, 1fr) minmax(100px, 1.25fr) minmax(0, 1fr); gap: 16px; align-items: center; }
  .source, .output { display: grid; justify-items: start; gap: 4px; min-width: 0; }
  .filename { font-family: var(--font-family-mono, monospace); font-size: 13px; overflow-wrap: anywhere; }
  .file-icon { border: .5px solid var(--gf-line); background: var(--gf-soft); border-radius: 3px 9px 3px 3px; height: 48px; width: 39px; display: grid; place-items: end start; padding: 5px; font-size: 13px; margin-bottom: 6px; }
  .small { font-size: 13px; color: var(--gf-muted); }
  .travel { display: flex; align-items: center; min-width: 0; }
  .arrow { flex: 1; min-width: 10px; height: 1px; background: var(--gf-line); position: relative; }
  .arrow::after { content: ''; position: absolute; right: 0; top: -3px; width: 6px; height: 6px; border-top: 1px solid var(--gf-muted); border-right: 1px solid var(--gf-muted); transform: rotate(45deg); }
  .compiler { border-inline: 1px solid var(--gf-muted); padding: 8px 10px; display: grid; text-align: center; background: var(--gf-soft); }
  .compiler span { font-size: 13px; color: var(--gf-muted); }
  .compiler strong { font-weight: 500; }
  .output { border-left: 1px solid var(--gf-line); padding-left: 16px; }
  .diagram-sheet { width: 44px; height: 30px; border: .5px solid var(--gf-line); background: repeating-linear-gradient(to bottom, transparent 0 7px, var(--gf-line) 7px 8px); background-size: 28px 20px; background-position: 8px 4px; background-repeat: no-repeat; margin-bottom: 6px; }
  .separator { display: flex; align-items: center; gap: 12px; margin: 22px 0; color: var(--gf-muted); font-size: 13px; }
  .separator::before, .separator::after { content: ''; flex: 1; height: 1px; background: var(--gf-line); }
  .direct { position: relative; min-height: 70px; }
  .bypass { position: absolute; top: 0; inset-inline: 0; text-align: center; font-size: 13px; color: var(--gf-muted); }
  .destination { margin-top: 26px; padding-top: 18px; border-top: 1px solid var(--gf-line); display: flex; gap: 12px; align-items: center; justify-content: center; font-size: 13px; color: var(--gf-muted); }
  .browser-mark { display: flex; align-items: start; gap: 3px; width: 34px; height: 25px; padding: 4px; border: 1px solid var(--gf-line); border-radius: 3px; flex-shrink: 0; }
  .browser-mark i { width: 3px; height: 3px; border-radius: 50%; background: var(--gf-muted); }
  @container (max-width: 420px) {
    .lane { grid-template-columns: minmax(0, 1fr); gap: 12px; justify-items: center; }
    .source, .output { justify-items: center; text-align: center; }
    .output { border-left: none; padding-left: 0; }
    .travel { flex-direction: column; min-height: 0; gap: 8px; }
    .arrow { flex: none; width: 1px; height: 18px; min-width: 0; }
    .arrow::after { top: auto; bottom: 0; right: -3px; transform: rotate(135deg); }
    .compiler { min-width: 140px; }
    .direct { padding-block: 4px; }
    .bypass { position: static; }
    .separator { margin: 18px 0; }
  }
</style>
