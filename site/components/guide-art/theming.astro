---
/* Inference: a region replaces an inherited theme token, while .btn declares
   its own public property. Evidence: packages/ui/components/button.css .btn
   and packages/ui/theme.css --radius-control. Bounds are schematic. */
---
<div class="scope-map">
  <div class="root-token"><span>Page default</span><code>--radius-control: .625rem</code></div>
  <div class="inheritance">↓ inherited by descendants</div>
  <div class="branches">
    <div class="outside">
      <span class="region-label">Outside checkout</span>
      <div class="button-node">
        <span class="element">.btn</span>
        <span>Continue browsing</span>
        <code>--btn-radius</code>
        <span class="value">← 10px token</span>
      </div>
    </div>
    <div class="checkout">
      <span class="region-label">Checkout subtree</span>
      <code class="override">--radius-control: .25rem</code>
      <span class="inheritance">↓ inherited inside this boundary</span>
      <div class="checkout-buttons">
        {['Review', 'Pay'].map(label => <div class="button-node">
          <span class="element">.btn</span><span>{label}</span>
          <code>--btn-radius</code><span class="value">← 4px token</span>
        </div>)}
      </div>
    </div>
  </div>
  <div class="binding"><code>.btn</code> declares <code>--btn-radius: var(--radius-control)</code></div>
</div>
<style>
  .scope-map { display: grid; gap: 12px; }
  .root-token { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px; padding: 10px; border-bottom: 1px solid var(--gf-line); }
  .root-token span, .region-label { font-weight: 550; }
  .inheritance { display: block; text-align: center; font-size: 13px; color: var(--gf-muted); }
  .branches { display: grid; grid-template-columns: 1fr 2fr; gap: 20px; align-items: stretch; }
  .outside { display: flex; flex-direction: column; justify-content: space-between; gap: 18px; padding: 12px 0; }
  .checkout { padding: 12px; border: 1px dashed var(--gf-line); display: grid; gap: 10px; }
  .region-label { font-size: 13px; }
  .override { justify-self: start; }
  .checkout-buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .button-node { display: grid; gap: 4px; padding: 10px; box-shadow: inset 0 0 0 1px var(--gf-line); background: var(--gf-surface); }
  .element { font-size: 13px; color: var(--gf-muted); }
  .button-node code { margin-top: 8px; }
  .value { font-size: 13px; }
  .binding { margin-top: 4px; text-align: center; font-size: 13px; }
  @container (max-width: 420px) {
    .branches { grid-template-columns: 1fr; gap: 16px; }
    .outside { padding: 0; gap: 8px; }
    .outside .button-node { grid-template-columns: 1fr 1fr; }
    .outside .button-node code { margin: 0; }
  }
</style>
