---
// Inference: a modifier shares its root's element; a part is nested inside the root.
// Evidence: components/dialog.json classes (root dialog, modifier dialog-drawer, part dialog-title).
---
<div class="anatomy" aria-hidden="true">
  <div class="legend"><span class="line-key"></span> One dialog element</div>
  <div class="root">
    <div class="opening"><span>&lt;dialog&gt;</span><span class="attribute">class list</span></div>
    <div class="classes"><span class="root-name">dialog <small>root</small></span><span class="modifier-name">dialog-drawer <small>modifier</small></span></div>
    <div class="same-element"><span></span>Both classes on this element<span></span></div>
    <div class="part">
      <div class="part-label"><span class="tag">&lt;h2&gt;</span><span>child element</span></div>
      <div class="part-class">dialog-title <small>part</small></div>
      <div class="title-text">Release details</div>
    </div>
    <div class="closing">&lt;/dialog&gt;</div>
  </div>
</div>
<style>
  .anatomy { color:var(--gf-ink); font-size:14px; line-height:1.5; max-width:540px; margin-inline:auto; }
  .legend { display:flex; align-items:center; gap:9px; margin-bottom:12px; color:var(--gf-muted); font-size:13px; }
  .line-key { width:22px; border-top:1px solid var(--gf-line); }
  .root { padding:18px 22px 14px; border:1px solid var(--gf-line); border-radius:12px; background:var(--gf-surface); }
  .opening,.closing { font-family:monospace; font-size:13px; color:var(--gf-muted); }
  .opening { display:flex; gap:12px; }
  .attribute { opacity:.8; }
  .classes { display:flex; flex-wrap:wrap; gap:12px 22px; padding-block:14px 8px; }
  .root-name,.modifier-name,.part-class { display:flex; align-items:baseline; flex-wrap:wrap; gap:8px; font-family:monospace; font-size:15px; }
  .root-name { border-bottom:2px solid var(--gf-ink); padding-bottom:4px; }
  .modifier-name { border-bottom:2px dashed var(--gf-muted); padding-bottom:4px; }
  small { font:400 13px/1.4 var(--font-family-sans, sans-serif); color:var(--gf-muted); }
  .same-element { display:flex; align-items:center; gap:9px; color:var(--gf-muted); font-size:13px; margin-block:3px 20px; }
  .same-element > span { flex:1; border-top:1px solid var(--gf-line); }
  .part { margin-left:24px; border-left:2px solid var(--gf-line); padding:4px 0 5px 16px; }
  .part-label { display:flex; align-items:center; gap:10px; color:var(--gf-muted); font-size:13px; }
  .tag { font-family:monospace; }
  .part-class { margin-block:6px 10px; }
  .title-text { font-size:21px; letter-spacing:-.02em; }
  .closing { margin-top:22px; }
  @container (max-width:420px) {
    .root { padding:16px; }
    .classes { gap:10px; flex-direction:column; align-items:flex-start; }
    .same-element { align-items:flex-start; }
    .same-element > span { margin-top:9px; min-width:8px; }
    .part { margin-left:8px; padding-left:12px; }
  }
</style>
