---
// Inference: choosing is a script action; the DOM attribute connects it to the drawn check.
// Evidence: behaviors/listbox.js choose() writes aria-checked; components/listbox.css shows its check.
---
<div class="attribute-flow" aria-hidden="true">
  <div class="input"><span class="key">Enter</span><span>Choose the active option</span></div>
  <div class="flow">
    <div class="behavior"><span class="step-label">Behavior</span><span class="function">listbox</span><span class="detail">Handles the key</span></div>
    <div class="connector"><span>writes</span><span class="arrow"></span></div>
    <div class="state"><span class="step-label">DOM attribute</span><span class="attribute">aria-checked</span><span class="value">false <span>→</span> <b>true</b></span></div>
    <div class="connector"><span>CSS reads</span><span class="arrow"></span></div>
    <div class="appearance"><span class="step-label">Drawn state</span><div class="option"><span>Tokyo</span><svg viewBox="0 0 16 16"><path d="m3.5 8.5 3 3 6-7"/></svg></div><span class="detail">The check appears</span></div>
  </div>
</div>
<style>
  .attribute-flow { color:var(--gf-ink); font-size:14px; line-height:1.5; }
  .input { display:flex; justify-content:center; align-items:center; gap:10px; padding-bottom:24px; font-size:13px; color:var(--gf-muted); }
  .key { padding:4px 9px; border-radius:5px; box-shadow:0 0 0 1px var(--gf-line),0 2px 0 var(--gf-line); background:var(--gf-surface); color:var(--gf-ink); font-family:monospace; }
  .flow { display:grid; grid-template-columns:minmax(0,1fr) 64px minmax(0,1.2fr) 64px minmax(0,1fr); align-items:center; }
  .behavior,.state,.appearance { display:flex; flex-direction:column; align-items:center; min-width:0; gap:10px; }
  .step-label { font-size:13px; color:var(--gf-muted); }
  .function { padding:8px 14px; border-radius:24px; border:1px solid var(--gf-line); font-family:monospace; }
  .detail { color:var(--gf-muted); font-size:13px; text-align:center; }
  .state { padding:12px 4px; border-block:1px solid var(--gf-line); }
  .attribute { font-family:monospace; font-size:13px; white-space:nowrap; }
  .value { display:flex; gap:8px; color:var(--gf-muted); font-family:monospace; }
  .value b { color:var(--gf-ink); font-weight:500; }
  .connector { display:flex; flex-direction:column; align-items:center; gap:8px; font-size:13px; color:var(--gf-muted); white-space:nowrap; }
  .arrow { width:28px; border-top:1px solid var(--gf-muted); position:relative; }
  .arrow::after { content:''; position:absolute; right:0; top:-3px; width:5px; height:5px; border-top:1px solid var(--gf-muted); border-right:1px solid var(--gf-muted); transform:rotate(45deg); }
  .option { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:10px; min-width:100%; border-radius:7px; background:var(--gf-surface); box-shadow:0 0 0 1px var(--gf-line); }
  .option svg { flex:none; width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
  @container (max-width:420px) {
    .input { justify-content:flex-start; flex-wrap:wrap; }
    .flow { grid-template-columns:1fr; gap:14px; }
    .behavior,.state,.appearance { width:100%; max-width:240px; margin-inline:auto; }
    .connector { flex-direction:row; justify-content:center; gap:12px; }
    .arrow { width:20px; transform:rotate(90deg); }
    .option { min-width:190px; }
    .state { padding-block:14px; }
  }
</style>
