---
import { figureTranslator } from '~/site/i18n/figures'
const f = figureTranslator(Astro)
// Inference: static diagnostics and browser verification examine different
// properties of the same edit. Neither branch can stand in for the other.
// Evidence: packages/ui/check/index.js and skills/master-ui/SKILL.md, Verify.
---
<div class="verification">
  <div class="edit"><span class="file-label">{f('Markup written from the project\'s contract')}</span><span class="markup">&lt;button class="btn"&gt;Save&lt;/button&gt;</span></div>
  <div class="split"><span>{f('check both')}</span></div>
  <div class="checks">
    <div class="check static">
      <span class="check-name">{f('Static markup')}</span>
      <div class="terminal"><span class="prompt">$ master-ui check</span><span class="diagnostic"><span class="tick">✓</span> {f('element')}</span><span class="diagnostic"><span class="tick">✓</span> {f('class + base')}</span><span class="diagnostic"><span class="tick">✓</span> {f('required attributes')}</span></div>
      <span class="scope">{f('What source can establish')}</span>
    </div>
    <div class="check rendered">
      <span class="check-name">{f('Rendered interface')}</span>
      <div class="browser"><div class="chrome"><i></i><i></i><i></i></div><div class="viewport"><span class="focus-button">{f('Save')}</span><span class="key">Tab</span></div></div>
      <span class="scope">{f('Keyboard · layout · states')}</span>
    </div>
  </div>
  <div class="result"><span class="join"></span><span>{f('Resolve findings from either check')}</span></div>
</div>

<style>
  .verification { font-size: 14px; line-height: 1.5; color: var(--gf-ink); }
  .edit { display: grid; gap: 10px; justify-items: center; text-align: center; }
  .file-label { font-size: 13px; color: var(--gf-muted); }
  .markup { font-family: var(--font-family-mono, monospace); font-size: 13px; padding: 12px 14px; background: var(--gf-soft); border-radius: 6px; overflow-wrap: anywhere; max-width: 100%; }
  .split { position: relative; height: 60px; margin-inline: 25%; border-bottom: 1px solid var(--gf-line); }
  .split::before { content: ''; width: 1px; height: 100%; position: absolute; left: 50%; background: var(--gf-line); }
  .split span { position: absolute; top: 16px; left: 50%; transform: translateX(-50%); background: var(--gf-surface); padding: 2px 8px; white-space: nowrap; color: var(--gf-muted); font-size: 13px; }
  .checks { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .check { position: relative; display: grid; gap: 10px; padding-top: 24px; min-width: 0; }
  .check::before { content: ''; position: absolute; left: 50%; top: 0; height: 14px; width: 1px; background: var(--gf-line); }
  .check-name { text-align: center; }
  .terminal { background: var(--gf-soft); border-radius: 6px; padding: 13px; font-family: var(--font-family-mono, monospace); font-size: 13px; display: grid; gap: 6px; min-height: 136px; }
  .prompt { padding-bottom: 4px; white-space: nowrap; }
  .diagnostic { color: var(--gf-muted); }
  .tick { display: inline-block; width: 16px; color: var(--gf-ink); }
  .browser { border: 1px solid var(--gf-line); border-radius: 7px; min-height: 136px; overflow: hidden; }
  .chrome { display: flex; gap: 4px; padding: 9px; border-bottom: 1px solid var(--gf-line); background: var(--gf-soft); }
  .chrome i { display: block; width: 4px; height: 4px; background: var(--gf-muted); border-radius: 50%; }
  .viewport { display: flex; min-height: 98px; align-items: center; justify-content: center; gap: 16px; padding: 12px; }
  .focus-button { display: grid; place-items: center; width: 76px; min-height: 36px; border-radius: 8px; background: var(--gf-soft); box-shadow: 0 0 0 .5px var(--gf-line); outline: 1px solid var(--gf-ink); outline-offset: 3px; }
  .key { font-family: var(--font-family-mono, monospace); font-size: 13px; box-shadow: 0 0 0 .5px var(--gf-line); border-radius: 3px; padding: 2px 5px; color: var(--gf-muted); }
  .scope { text-align: center; font-size: 13px; color: var(--gf-muted); }
  .result { display: grid; justify-items: center; color: var(--gf-muted); font-size: 13px; margin-top: 16px; gap: 10px; }
  .join { height: 16px; border-bottom: 1px solid var(--gf-line); border-inline: 1px solid var(--gf-line); width: 50%; }
  @container (max-width: 420px) {
    .checks { grid-template-columns: 1fr; gap: 20px; padding-left: 20px; border-left: 1px solid var(--gf-line); margin-left: 8px; }
    .split { margin-inline: 8px auto; border-bottom: none; height: 42px; border-left: 1px solid var(--gf-line); }
    .split::before { display: none; }
    .split span { top: 8px; left: 10px; transform: none; }
    .check { padding-top: 0; }
    .check::before { width: 15px; height: 1px; left: -20px; top: 11px; }
    .check-name { text-align: left; }
    .terminal, .browser { min-height: 130px; }
    .join { display: none; }
    .result { padding-top: 12px; border-top: 1px solid var(--gf-line); }
  }
</style>
