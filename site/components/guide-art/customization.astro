---
/* Inference: four customization points feed the package implementation; owning
   replaces its source. Not a specificity scale or an amount-of-code scale.
   Evidence: components/button.css, theme.css, master.css; bin/master-ui.js own(). */
---
<div class="ownership-map">
  <div class="package-route">
    <div class="inputs">
      <div><span class="number">1</span><strong>Utility</strong><span>One instance’s layout</span></div>
      <div><span class="number">2</span><strong>Token</strong><span>A shared design value</span></div>
      <div><span class="number">3</span><strong>Property</strong><span>A component’s geometry</span></div>
      <div><span class="number">4</span><strong>Theme</strong><span>Values + material recipes</span></div>
    </div>
    <div class="bracket"><span>keep the implementation</span></div>
    <div class="implementation">
      <span class="owner">Maintained by the package</span>
      <strong>Component source</strong>
      <span class="source-lines"><i></i><i></i><i></i></span>
      <span>Classes · states · behavior</span>
    </div>
  </div>
  <div class="fork">
    <div class="copy"><code>master-ui own</code><span>↓ copy + repoint CSS import</span></div>
    <div class="local-source"><span class="number">5</span><div><span class="owner">Maintained by your project</span><strong>Owned component source</strong><span>Edit structure, states or behavior</span><span>Wire behavior imports to the local copy too.</span></div></div>
  </div>
</div>
<style>
  .ownership-map { display: grid; gap: 16px; }
  .package-route { display: grid; grid-template-columns: minmax(0, 1.3fr) 30px minmax(0, 1fr); align-items: stretch; }
  .inputs { display: grid; gap: 16px; }
  .inputs > div { display: grid; grid-template-columns: 24px 1fr; gap: 0 8px; }
  .inputs > div > span:last-child { grid-column: 2; font-size: 13px; color: var(--gf-muted); }
  strong { font-weight: 550; }
  .number { font-size: 13px; color: var(--gf-muted); }
  .bracket { position: relative; border-right: 1px solid var(--gf-line); border-block: 1px solid var(--gf-line); margin-right: 16px; }
  .bracket::after { content: ''; position: absolute; top: 50%; left: 100%; width: 16px; border-top: 1px solid var(--gf-line); }
  .bracket span { display: none; }
  .implementation { align-self: center; display: grid; gap: 8px; padding: 16px 12px; border: 1px solid var(--gf-line); }
  .owner { font-size: 13px; color: var(--gf-muted); }
  .source-lines { display: grid; gap: 5px; margin: 8px 0; }
  i { display: block; width: 70%; height: 2px; background: var(--gf-line); }
  i:nth-child(2) { width: 90%; } i:nth-child(3) { width: 55%; }
  .implementation > span:last-child { font-size: 13px; }
  .fork { display: grid; grid-template-columns: minmax(0, 1.3fr) 30px minmax(0, 1fr); }
  .copy { grid-column: 3; display: grid; gap: 4px; text-align: center; font-size: 13px; padding-bottom: 16px; }
  .copy span { color: var(--gf-muted); }
  .local-source { grid-column: 1 / -1; display: flex; gap: 12px; padding: 16px; border: 1px dashed var(--gf-line); background: var(--gf-soft); }
  .local-source > div { display: grid; gap: 3px; }
  .local-source > div > span { font-size: 13px; }
  @container (max-width: 420px) {
    .package-route { grid-template-columns: 1fr; gap: 14px; }
    .inputs { grid-template-columns: 1fr 1fr; gap: 16px 10px; }
    .bracket { border-right: 1px solid var(--gf-line); border-left: 1px solid var(--gf-line); border-top: 0; height: 12px; margin: 0 12px 20px; text-align: center; }
    .bracket span { display: inline-block; position: relative; top: 15px; background: var(--gf-surface); padding-inline: 8px; font-size: 13px; color: var(--gf-muted); }
    .bracket::after { display: none; }
    .implementation { justify-items: center; }
    .source-lines { display: none; }
    .fork { grid-template-columns: 1fr; }
    .copy { grid-column: 1; }
  }
</style>
