---
import { figureTranslator } from '~/site/i18n/figures'
const f = figureTranslator(Astro)
// Inference: diff compares saved base with installed upstream; the person merges
// into the working file. accept updates only the saved base and ownership record.
// Evidence: packages/ui/bin/master-ui.js diff()/accept(). File contents schematic.
---
<div class="merge" aria-hidden="true">
  <div class="compare">
    <div class="file base"><span class="file-label">{f('Saved base')}</span><code>ui/.base/menu.css</code><div class="source-lines"><i></i><i class="old"></i><i></i></div></div>
    <div class="diff"><span class="inward">→ &nbsp; ←</span><code>diff</code><span>{f('Compare upstream changes')}</span></div>
    <div class="file upstream"><span class="file-label">{f('Installed package')}</span><code>@master/ui</code><div class="source-lines"><i></i><i class="changed"></i><i></i></div></div>
  </div>
  <div class="manual"><span>↓</span><strong>{f('Review and merge by hand')}</strong></div>
  <div class="working">
    <div class="working-label"><strong>{f('Working copy')}</strong><code>ui/menu.css</code></div>
    <div class="working-lines"><span><i class="changed"></i>{f('Chosen upstream changes')}</span><span><i class="local"></i>{f('Your local changes')}</span></div>
  </div>
  <div class="accept">
    <div class="command"><code>accept</code><span>{f('after merging')}</span></div>
    <div class="new-base"><span>{f('Installed package')} <b>→</b> {f('saved base')}</span><span class="muted">{f('Advances the comparison record')}</span></div>
    <div class="untouched"><span class="equals">=</span><span>{f('Working copy')}<br /><strong>{f('stays as you merged it')}</strong></span></div>
  </div>
</div>

<style>
  .merge { display: grid; color: var(--gf-ink); font-size: 13px; line-height: 1.45; }
  .compare { display: grid; grid-template-columns: minmax(0,1fr) 130px minmax(0,1fr); align-items: center; gap: 16px; }
  .file { padding: 14px; border-radius: 8px; background: var(--gf-surface); box-shadow: 0 0 0 .5px var(--gf-line); min-width: 0; }
  .file-label { display: block; font-size: 14px; font-weight: 500; margin-bottom: 4px; }
  code { font: 13px/1.45 var(--font-family-mono, monospace); overflow-wrap: anywhere; }
  .file code { color: var(--gf-muted); }
  .source-lines { display: grid; gap: 7px; margin-top: 19px; }
  .source-lines i { display: block; height: 5px; width: 80%; background: var(--gf-line); border-radius: 2px; }
  .source-lines i:last-child { width: 58%; }
  .source-lines .old { width: 52%; }
  .source-lines .changed { background: var(--gf-ink); width: 92%; }
  .diff { display: grid; justify-items: center; text-align: center; gap: 6px; color: var(--gf-muted); }
  .diff code { color: var(--gf-ink); font-size: 15px; }
  .inward { font-size: 22px; line-height: 1; }
  .manual { display: grid; justify-items: center; gap: 7px; padding: 17px 0; }
  .manual span { font-size: 24px; color: var(--gf-muted); line-height: 1; }
  .manual strong { font-weight: 500; font-size: 14px; }
  .working { display: flex; gap: 24px; justify-content: space-between; align-items: center; padding: 16px 20px; border-inline-start: 3px solid var(--gf-ink); background: var(--gf-soft); }
  .working-label { display: grid; gap: 3px; }
  .working-label strong { font-size: 14px; font-weight: 500; }
  .working-label code { color: var(--gf-muted); }
  .working-lines { display: grid; gap: 8px; }
  .working-lines span { display: flex; align-items: center; gap: 8px; }
  .working-lines i { display: block; width: 25px; height: 5px; border-radius: 2px; background: var(--gf-ink); flex-shrink: 0; }
  .working-lines .local { background: none; height: 0; border-top: 2px dashed var(--gf-muted); border-radius: 0; }
  .accept { display: grid; grid-template-columns: auto 1fr; gap: 14px 22px; margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--gf-line); }
  .command { display: grid; align-content: start; gap: 4px; grid-row: span 2; }
  .command code { font-size: 15px; }
  .command span, .muted { color: var(--gf-muted); }
  .new-base { display: grid; gap: 3px; }
  .new-base b { padding-inline: 6px; font-size: 16px; font-weight: 400; }
  .untouched { display: flex; gap: 10px; align-items: center; }
  .equals { font-size: 22px; color: var(--gf-muted); }
  .untouched strong { font-weight: 500; }
  @container (max-width: 420px) {
    .compare { grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 10px; }
    .file { padding: 11px; }
    .diff { grid-column: 1 / -1; grid-row: 2; grid-template-columns: auto 1fr; gap: 8px; justify-items: start; text-align: start; margin-top: 4px; padding-top: 10px; border-top: 1px solid var(--gf-line); }
    .inward { display: none; }
    .working { flex-direction: column; align-items: start; gap: 16px; padding: 14px; }
    .accept { grid-template-columns: 1fr; gap: 12px; }
    .command { grid-row: auto; grid-template-columns: auto 1fr; align-items: baseline; gap: 10px; }
  }
</style>
