---
import { figureTranslator } from '~/site/i18n/figures'
const f = figureTranslator(Astro)
// Inference: own/add copy the installed version and keep comparison records;
// registry clients copy hosted files without Master UI's ownership records.
// Evidence: packages/ui/bin/master-ui.js init/own/add and site/scripts/exports.ts.
---
<div class="routes" aria-hidden="true">
  <div class="route-group">
    <div class="source">
      <svg viewBox="0 0 40 40" width="40" height="40" fill="none"><path d="m20 4 15 8v17l-15 8-15-8V12L20 4Zm-15 8 15 8 15-8M20 20v17M12 8l15 8v9" /></svg>
      <strong>{f('Installed package')}</strong>
      <code>@master/ui</code>
    </div>
    <div class="branches">
      <div class="path">
        <span class="verb">import <span>→</span></span>
        <div class="destination dependency"><strong>{f('Application stylesheet')}</strong><span>{f('Reads the package')}</span></div>
      </div>
      <div class="path">
        <span class="verb">own / add <span>→</span></span>
        <div class="destination copy"><strong>{f('Local source in ui/')}</strong><div class="record"><span>{f('saved base')}</span><span>{f('ownership record')}</span></div><span>{f('Compare later with status / diff')}</span></div>
      </div>
    </div>
  </div>
  <div class="route-group hosted">
    <div class="source">
      <svg viewBox="0 0 40 40" width="40" height="40" fill="none"><path d="M10 29a7 7 0 0 1-1-14 11 11 0 0 1 21-1 8 8 0 0 1 0 16H10Zm5-10 5 5 5-5M20 13v11" /></svg>
      <strong>{f('Hosted registry')}</strong>
      <code>/r/*.json</code>
    </div>
    <div class="branches">
      <div class="path">
        <span class="verb"><span class="verb-label">{f('client copies')}</span> <span class="direction">→</span></span>
        <div class="destination copy"><strong>{f('Local source in ui/')}</strong><span>{f('Your own update workflow')}</span><span class="muted">{f('No Master UI base or record')}</span></div>
      </div>
    </div>
  </div>
</div>

<style>
  .routes { display: grid; gap: 28px; color: var(--gf-ink); font-size: 13px; line-height: 1.45; }
  .route-group { display: grid; grid-template-columns: 140px 1fr; gap: 24px; align-items: center; min-width: 0; }
  .source { display: grid; justify-items: center; gap: 6px; text-align: center; }
  .source svg { stroke: var(--gf-muted); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 4px; }
  .source strong { font-size: 14px; font-weight: 500; }
  .source code { font: 13px/1.4 var(--font-family-mono, monospace); color: var(--gf-muted); }
  .branches { display: grid; gap: 20px; border-inline-start: 1px solid var(--gf-line); }
  .path { display: grid; grid-template-columns: 120px minmax(0,1fr); align-items: center; }
  .verb { display: flex; align-items: center; gap: 7px; padding-inline: 10px 7px; color: var(--gf-muted); white-space: nowrap; font-size: 13px; }
  .verb .verb-label { min-width: 0; white-space: normal; }
  .verb span:not(.verb-label) { flex: none; font-size: 18px; line-height: 1; }
  .destination { display: grid; gap: 5px; padding: 12px 14px; min-width: 0; }
  .destination strong { font-weight: 500; font-size: 14px; }
  .dependency { border-block: 1px solid var(--gf-line); }
  .copy { background: var(--gf-surface); box-shadow: 0 0 0 .5px var(--gf-line); border-radius: 9px; }
  .record { display: flex; flex-wrap: wrap; gap: 5px; margin-block: 2px; }
  .record span { padding: 3px 6px; background: var(--gf-soft); border-radius: 3px; font-size: 13px; }
  .muted { color: var(--gf-muted); }
  .hosted { padding-top: 25px; border-top: 1px dashed var(--gf-line); }
  @container (max-width: 420px) {
    .route-group { grid-template-columns: 1fr; gap: 16px; }
    .source { grid-template-columns: 36px 1fr; justify-items: start; text-align: start; column-gap: 10px; }
    .source svg { grid-row: span 2; width: 32px; height: 32px; margin: 0; }
    .source strong { align-self: end; }
    .source code { align-self: start; }
    .branches { margin-inline-start: 15px; gap: 14px; }
    .path { grid-template-columns: 112px minmax(0,1fr); }
    .verb { padding-inline: 8px 5px; gap: 4px; white-space: normal; }
    .destination { padding: 10px; }
  }
</style>
