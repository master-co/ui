---
// Inference: choosing one value branches on whether the options can be scanned.
// Evidence: components/select.json and combobox.json use/instead; both fill one value.
---
<div class="choice-map" aria-hidden="true">
  <div class="question"><span class="question-mark">?</span><span>Choose one value</span></div>
  <div class="branches">
    <div class="branch">
      <span class="condition">Short enough to scan</span>
      <div class="specimen">
        <div class="field"><span>Tokyo</span><span class="chevron">⌄</span></div>
        <div class="options"><span>Tokyo <span>✓</span></span><span>Singapore</span><span>Frankfurt</span></div>
      </div>
      <strong>Select</strong>
      <span class="reason">Read, then choose</span>
    </div>
    <div class="branch">
      <span class="condition">Typing helps find it</span>
      <div class="specimen">
        <div class="field search"><svg viewBox="0 0 20 20"><circle cx="8" cy="8" r="5"/><path d="m12 12 4 4"/></svg><span>Tok<span class="caret"></span></span></div>
        <div class="options filtered"><span><b>Tok</b>yo</span></div>
      </div>
      <strong>Combobox</strong>
      <span class="reason">Search, then choose</span>
    </div>
  </div>
</div>
<style>
  .choice-map { color:var(--gf-ink); font-size:14px; line-height:1.45; padding:8px 0; }
  .question { display:flex; align-items:center; justify-content:center; gap:10px; font-weight:500; }
  .question-mark { display:grid; place-items:center; width:28px; height:28px; border-radius:50%; box-shadow:0 0 0 1px var(--gf-line); color:var(--gf-muted); }
  .branches { display:grid; grid-template-columns:1fr 1fr; gap:36px; margin:28px 20px 0; position:relative; }
  .branches::before { content:''; position:absolute; left:25%; right:25%; top:-16px; height:16px; border-top:1px solid var(--gf-line); border-inline:1px solid var(--gf-line); }
  .branches::after { content:''; position:absolute; left:50%; top:-28px; height:12px; border-left:1px solid var(--gf-line); }
  .branch { display:flex; flex-direction:column; gap:8px; align-items:center; min-width:0; }
  .condition,.reason { color:var(--gf-muted); font-size:13px; }
  .condition { text-align:center; }
  .specimen { width:100%; max-width:210px; min-height:160px; padding-top:8px; }
  .field { display:flex; align-items:center; justify-content:space-between; gap:8px; padding:10px 12px; background:var(--gf-surface); box-shadow:0 0 0 1px var(--gf-line); border-radius:8px; }
  .chevron { color:var(--gf-muted); }
  .options { display:grid; margin-top:6px; padding:4px; background:var(--gf-surface); box-shadow:0 0 0 1px var(--gf-line); border-radius:9px; }
  .options > span { display:flex; justify-content:space-between; padding:4px 8px; }
  .options > span:first-child { background:var(--gf-soft); border-radius:5px; }
  .search { justify-content:flex-start; }
  .search svg { width:16px; height:16px; fill:none; stroke:var(--gf-muted); stroke-width:1.5; }
  .caret { display:inline-block; width:1px; height:14px; margin-left:2px; vertical-align:-2px; background:var(--gf-ink); }
  .filtered > span { justify-content:flex-start; }
  .branch strong { font-size:15px; font-weight:500; }
  @container (max-width:420px) {
    .question { justify-content:flex-start; }
    .branches { grid-template-columns:1fr; gap:28px; margin:24px 0 0 14px; padding-left:24px; border-left:1px solid var(--gf-line); }
    .branches::before,.branches::after { display:none; }
    .branch { position:relative; align-items:flex-start; }
    .branch::before { content:''; position:absolute; left:-24px; top:10px; width:16px; border-top:1px solid var(--gf-line); }
    .specimen { min-height:0; margin-bottom:6px; max-width:240px; }
    .condition { text-align:left; }
  }
</style>
