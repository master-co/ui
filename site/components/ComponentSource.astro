---
import Code from '@master/internal-site/components/Code.astro'
import { componentSource } from '~/site/utils/ui-source'

interface Props {
  /** The component stylesheet in `@master/ui/components`, such as `button`. */
  name: string
}

const { name } = Astro.props
---

<Code lang="css" name={`@master/ui/components/${name}.css`} code={componentSource(name)} />
