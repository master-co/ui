---
import Code from '@master/internal-site/components/Code.astro'
import ExpandContent from '@master/internal-site/components/ExpandContent.svelte'
import { componentSource } from '~/site/utils/ui-source'

interface Props {
  /** The component stylesheet in `@master/ui/components`, such as `button`. */
  name: string
}

/**
 * The component's complete stylesheet, clamped under a canvas fade with one control to show the rest.
 * The whole source stays in the server HTML for search, copying and readers without JavaScript.
 */
const { name } = Astro.props
---

<ExpandContent client:idle={{ timeout: 500 }}>
  <Code lang="css" name={`@master/ui/components/${name}.css`} code={componentSource(name)} />
</ExpandContent>
