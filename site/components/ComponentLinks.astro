---
import ComponentTile from '~/site/components/ComponentTile.astro'

interface Props {
  /** Component slugs, in the order to show them. */
  slugs: string[]
}

/** Other components a page builds on or sits beside, as their covers. Use it in MDX under a Related heading. */
const { slugs } = Astro.props
---

<ul class="component-tiles">
  {slugs.map(slug => <li><ComponentTile slug={slug} description /></li>)}
</ul>
