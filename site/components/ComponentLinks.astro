---
import ComponentTile from '~/site/components/ComponentTile.astro'
import type { LibraryKind } from '~/site/components/catalog'

interface Props {
  /** Slugs in the catalog, in the order to show them. */
  slugs: string[]
  /** The section the slugs belong to: components by default. */
  kind?: LibraryKind
}

/** Other components, blocks or pages a page builds on or sits beside, as their covers. Use it in MDX under a Related heading. */
const { slugs, kind = 'components' } = Astro.props
---

<ul class="component-tiles">
  {slugs.map(slug => <li><ComponentTile slug={slug} kind={kind} description /></li>)}
</ul>
