---
import DocumentTableFrame from '@master/internal-site/components/DocumentTableFrame.astro'
import InlineCode from '@master/internal-site/components/InlineCode.astro'
import { siteOf } from '@master/internal-site/astro/site-context'
import { localizedContract } from '~/site/i18n/contract-copy'
import { contract } from '~/site/utils/ui-source'

interface Props {
  /** The stylesheet's name, such as `button`. */
  name: string
  /** Which part of the contract to show. */
  show?: 'classes' | 'properties' | 'states' | 'keyboard'
  /** Where it is published: `@master/ui/components` by default, or `layouts` for a layout class. */
  directory?: 'components' | 'layouts'
}

/**
 * A table written from the component's contract, the JSON file beside its stylesheet. The page does not
 * repeat what the contract says, so a class or a property is described once and the two cannot drift.
 * The table and its cells use the published UI contract. The shared document frame owns its surface and overflow;
 * its accessible name lets keyboard readers distinguish multiple contract tables.
 */
const { name, show = 'classes', directory = 'components' } = Astro.props
const { locale, t } = siteOf(Astro)
const subject = localizedContract(contract(name, directory), locale)
const base = (entry: { of?: string | string[] }) => entry.of === undefined ? [] : Array.isArray(entry.of) ? entry.of : [entry.of]
const [withBefore, withAfter] = t('Apply with {classes}').split('{classes}')
const [onBefore, onAfter] = t('Set on {class}').split('{class}')
---

{show === 'classes' && (
  <DocumentTableFrame class="contract-table" label={`${subject.title}: ${t('Classes')}`} identifiers><table class="table">
    <thead><tr class="table-row"><th class="table-heading" scope="col">{t('Class')}</th><th class="table-heading" scope="col">{t('Description')}</th></tr></thead>
    <tbody>
      {subject.classes.map(entry => (
        <tr class="table-row">
          <th class="table-cell" scope="row"><InlineCode code={entry.name} /></th>
          <td class="table-cell">
            {entry.description}
            {entry.kind === 'modifier' && base(entry).length > 0 && <span class="block">{withBefore}{base(entry).map((owner, at) => <>{at > 0 && ` ${t('or')} `}<InlineCode code={owner} /></>)}{withAfter}</span>}
          </td>
        </tr>
      ))}
    </tbody>
  </table></DocumentTableFrame>
)}

{show === 'properties' && (
  <DocumentTableFrame class="contract-table" label={`${subject.title}: ${t('Custom properties')}`} identifiers><table class="table">
    <thead><tr class="table-row"><th class="table-heading" scope="col">{t('Property')}</th><th class="table-heading" scope="col">{t('Default')}</th><th class="table-heading" scope="col">{t('Description')}</th></tr></thead>
    <tbody>
      {(subject.properties ?? []).map(property => (
        <tr class="table-row">
          <th class="table-cell" scope="row"><InlineCode code={property.name} /></th>
          <td class="table-cell">{property.default ? <InlineCode code={property.default} /> : ''}</td>
          <td class="table-cell">{property.description}{property.on && <span class="block">{onBefore}<InlineCode code={property.on} />{onAfter}</span>}</td>
        </tr>
      ))}
    </tbody>
  </table></DocumentTableFrame>
)}

{show === 'states' && (
  <DocumentTableFrame class="contract-table" label={`${subject.title}: ${t('States')}`} identifiers><table class="table">
    <thead><tr class="table-row"><th class="table-heading" scope="col">{t('State')}</th><th class="table-heading" scope="col">{t('Mark it with')}</th><th class="table-heading" scope="col">{t('On')}</th><th class="table-heading" scope="col">{t('Description')}</th></tr></thead>
    <tbody>
      {(subject.states ?? []).map(state => (
        <tr class="table-row">
          <th class="table-cell" scope="row">{state.name}</th>
          <td class="table-cell"><InlineCode code={state.mark} /></td>
          <td class="table-cell"><InlineCode code={state.on} /></td>
          <td class="table-cell">{state.description ?? ''}</td>
        </tr>
      ))}
    </tbody>
  </table></DocumentTableFrame>
)}

{show === 'keyboard' && (
  <DocumentTableFrame class="contract-table" label={`${subject.title}: ${t('Keyboard')}`} identifiers><table class="table">
    <thead><tr class="table-row"><th class="table-heading" scope="col">{t('Keys')}</th><th class="table-heading" scope="col">{t('Action')}</th></tr></thead>
    <tbody>
      {(subject.keyboard ?? []).map(item => (
        <tr class="table-row">
          <th class="table-cell" scope="row">{item.keys}</th>
          <td class="table-cell">{item.action}</td>
        </tr>
      ))}
    </tbody>
  </table></DocumentTableFrame>
)}
