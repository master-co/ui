---
/**
 * What `/guide/installation#set-the-viewport` tells a project to do, done for the site: iOS zooms the page onto a
 * focused field whose text is under 16px, and the fields of the previews and the search keep their 14px. The shared
 * shell writes the viewport tag; this caps its scale after it, on iOS alone, where a reader can still pinch to zoom.
 * Layouts that may nest each include it, so it adds the cap once.
 */
---

<script is:inline>
  if (CSS.supports('-webkit-touch-callout', 'none')) {
    const viewport = document.querySelector('meta[name="viewport"]')
    if (viewport && !viewport.content.includes('maximum-scale')) viewport.content += ', maximum-scale=1'
  }
</script>
