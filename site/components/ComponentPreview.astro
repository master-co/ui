---
import Code from '@master/internal-site/components/Code.astro'
import Demo from '@master/internal-site/demo/Demo.svelte'
import PreviewViewport from '~/site/components/PreviewViewport.svelte'
import { demoDocument } from '@master/internal-site/demo/reference/document.ts'
import PreviewGuard from '~/site/components/PreviewGuard.astro'
import DocumentPreviewSwitch from '@master/internal-site/components/DocumentPreviewSwitch.astro'
import { specimenHead as head } from '~/site/utils/preview'
import { behaviorsScript, uiSource } from '~/site/utils/ui-source'

interface Props {
  /** A stable id, unique within the page. */
  name: string
  title: string
  /** Trusted site-authored markup; never pass user-provided HTML. */
  html: string
  caption?: string
  /** Utilities for the preview body, such as layout around the specimen. */
  bodyClass?: string
  /** Offer a light/dark toggle; only for examples about color schemes. Previews otherwise follow the site theme. */
  theme?: boolean
  responsive?: boolean
  /** Reserved before the iframe loads; include room for the example’s interactive states. */
  height: number
  /** Fixed height for trays narrower than 30rem, including wrapped text and touch targets. */
  narrowHeight?: number
  /** Fixed height for trays from 30rem to 40rem, where specimens may stack. */
  mediumHeight?: number
  /**
   * The stage's texture, drawn by `@master/ui`'s `texture` in a fainter ink. Dots, the default, give a specimen
   * a field to be seen against. Use `plain` for running text, which a texture only makes harder to read, and
   * `stripes` for a specimen about empty room.
   */
  background?: 'dots' | 'stripes' | 'plain'
  /** A theme in `@master/ui/themes`, compiled after the library, for examples about theming. */
  stylesheet?: string
  /**
   * Attach the package's behaviors to the preview, for a pattern that needs a script. The preview runs the
   * published scripts, and the Code view ends with the two lines a reader writes to do the same.
   */
  behaviors?: boolean
}

/**
 * One tray: an isolated preview compiled from the published @master/ui source with the Master CSS preset,
 * and the markup a reader copies, behind a second view of the same tray: Preview, the default, or Code.
 * Previews follow the site theme; light and dark come from the same CSS.
 */
const { name, title, html, caption = '', bodyClass = 'flex flex-wrap items-center justify-center gap-md p-lg', theme = false, responsive, height, mediumHeight, narrowHeight, background = 'dots', stylesheet, behaviors = false } = Astro.props
const views = [['preview', 'Preview'], ['code', 'Code']] as const
const running = behaviors ? `${html}\n<script>${behaviorsScript()};MasterUI.attach()</script>` : html
const source = behaviors ? `${html}\n<script type="module">\n  import { attach } from '@master/ui/behaviors'\n\n  attach()\n</script>` : html
const section = { page: 'components', id: name, title, html: [running], css: uiSource(stylesheet), classes: [], classLists: [], highlighted: [] }
const document = demoDocument(section as Parameters<typeof demoDocument>[0], { html: running, caption, bodyClass, head } as Parameters<typeof demoDocument>[1])
---

<PreviewGuard />
<Demo title={title} caption={caption} frame="none" sourceMode="replace" data-component-preview={name} data-preview-background={background}>
  <Fragment slot="controls">
    <DocumentPreviewSwitch name={`preview-view-${name}`} label="View" kind="view" options={views} value="preview" />
  </Fragment>
  <Fragment slot="source">
    {/* Preserve literal example emails through Cloudflare without disabling HTML compression. */}
    <Fragment set:html="<!--email_off-->" />
    <Code lang="html" beautify code={source} />
    <Fragment set:html="<!--/email_off-->" />
  </Fragment>
  <PreviewViewport client:idle={{ timeout: 500 }} title={title} document={document} theme={theme} responsive={responsive} height={height} mediumHeight={mediumHeight} narrowHeight={narrowHeight} background={background} />
</Demo>
