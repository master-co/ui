---
import IconArrowRight from '@tabler/icons-svelte-runes/icons/arrow-right'
import { siteOf } from '@master/internal-site/astro/site-context'
import { components } from '~/site/components/catalog'
import ComponentTile from '~/site/components/ComponentTile.astro'

const { t } = siteOf(Astro)

/** A dozen components that show the range, from a single control to a pattern with no native element. */
const featured = ['button', 'card', 'switch', 'segmented', 'combobox', 'command', 'dialog', 'menu', 'toast', 'calendar', 'chart', 'table']

/** Every category with its count, in catalog order, each linking to its place on the overview. */
const categories = [...components.reduce((counts, component) => counts.set(component.category, (counts.get(component.category) ?? 0) + 1), new Map<string, number>())]
const anchor = (category: string) => category.toLowerCase().replaceAll(' ', '-')
---

<section id="components" class="home-section home-components" aria-labelledby="components-title">
  <div class="app-wrapper home-section-wrap">
    <header class="home-section-header">
      <p class="home-eyebrow"><span class="home-eyebrow-index" aria-hidden="true">07</span><span>{t('Components')}</span></p>
      <h2 id="components-title" class="home-lit home-section-heading home-stone-type"><span>{t('A hundred components,')}</span>{' '}<span>{t('one contract each.')}</span></h2>
      <p class="home-section-body">{t('From a button to a calendar, each has a page with live previews, its markup, its states and keys, and the contract a coding agent reads.')}</p>
    </header>
    <div class="home-component-grid">
      {featured.map(slug => <ComponentTile slug={slug} description />)}
    </div>
    <nav class="ui-catalog-index" aria-label={t('Component categories')}>
      <ul class="ui-catalog-categories">
        {categories.map(([category, count]) => (
          <li><a class="ui-catalog-category" href={`/components#${anchor(category)}`}><span>{t(category)}</span><span class="ui-catalog-count">{count}</span></a></li>
        ))}
      </ul>
      <a class="home-section-link" href="/components">{t('Browse all {count} components').replace('{count}', String(components.length))}<IconArrowRight aria-hidden="true" size={14} stroke={1.75} /></a>
    </nav>
  </div>
</section>
