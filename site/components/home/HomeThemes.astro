---
import '@master/ui/components/badge.css'
import '@master/ui/components/button.css'
import '@master/ui/components/card.css'
import '@master/ui/components/checkbox.css'
import '@master/ui/components/icon.css'
import '@master/ui/components/list.css'
import '@master/ui/components/segmented.css'
import '@master/ui/components/switch.css'
import '@master/ui/components/texture.css'
import '../../styles/home-themes.css'
import IconArrowRight from '@tabler/icons-svelte-runes/icons/arrow-right'
import IconPlayerPause from '@tabler/icons-svelte-runes/icons/player-pause'
import IconPlayerPlay from '@tabler/icons-svelte-runes/icons/player-play'
import Link from '@master/internal-site/components/Link.svelte'
import { siteOf } from '@master/internal-site/astro/site-context'
import { code, scopedStyles, styles, tokenCount, type StyleId } from './customize'

const { t } = siteOf(Astro)

/* Each style's tokens, scoped to its own picture of the composition; this part needs no script. */
const styleClass = (id: StyleId) => `home-customize-style-${id}`
/*
 * The chosen style's picture and file are shown by the radio that chose it, so choosing works before the script
 * that plays them in turn and wipes one across another.
 */
const chosen = styles.map(style => `.home-customize:has([name="home-customize-style"][value="${style.id}"]:checked) :is(.${styleClass(style.id)}, [data-customize-source="${style.id}"]){visibility:visible;z-index:1}`).join('\n')
const scoped = `${scopedStyles(styleClass)}\n${chosen}`

/* The route's stops; each thumbnail is a view into the same drawing as the cover. */
const stops = [
    { view: 'boathouse', name: 'Boathouse', detail: 'Start · 0.0 km', end: '1,430 m' },
    { view: 'ridge', name: 'Larch ridge', detail: '2.6 km', end: '1,618 m' },
    { view: 'summit', name: 'Summit', detail: '4.1 km', end: '1,842 m' },
]
const activities = ['Walk', 'Run', 'Cycle']
const index = (value: number) => String(value + 1).padStart(2, '0')

/* The customization ladder, from /guide/customization: each step reaches further and leaves less upstream. */
const ladder = [
    { name: 'Utility', anchor: 'utility', reach: 'One instance', example: 'class="btn w-full"', upstream: 'Everything follows upstream' },
    { name: 'Token', anchor: 'token', reach: 'Every component that reads it', example: '--radius-control: .5rem', upstream: 'Everything follows upstream' },
    { name: 'Property', anchor: 'property', reach: 'One component’s size or spacing', example: '--btn-height: 2rem', upstream: 'Everything follows upstream' },
    { name: 'Theme', anchor: 'theme', reach: 'The whole material', example: "@import './themes/app.css'", upstream: 'Every component follows upstream' },
    { name: 'Own', anchor: 'own-a-component', reach: 'Structure, parts, states and behavior', example: 'npx master-ui own menu', upstream: 'The other components follow upstream' },
]
---

{/*
  Customize: one composition of real components in four styles, each a theme file of tokens. The four pictures
  stand in one cell, so the stage is as tall as the tallest and changing style moves nothing after it. The styles
  play in turn, each wiping across the one before; the console picks one, pauses the turn, sets the scheme and
  prints the file.
*/}
<section id="customize" class="home-section home-customize" aria-labelledby="customize-title">
  <Fragment set:html={`<style>${scoped}</style>`} />
  <div class="app-wrapper home-section-wrap">
    <header class="home-section-header">
      <p class="home-eyebrow"><span class="home-eyebrow-index" aria-hidden="true">02</span><span>{t('Customize')}</span></p>
      <h2 id="customize-title" class="home-lit home-section-heading home-stone-type"><span>{t('Same markup,')}</span>{' '}<span>{t('your material.')}</span></h2>
      <p class="home-section-body">{t('Colors, corners and shadows come from the theme’s tokens: retune the library instead of overriding it.')}</p>
      <Link class="home-section-link" href="/guide/customization">{t('Choose a customization')}<IconArrowRight aria-hidden="true" stroke={1.75} /></Link>
    </header>
    <figure class="home-customize-figure" data-customize aria-label={t('One card in four styles')}>
      <div class="home-customize-stage" data-customize-stage>
        {styles.map((style, order) => (
          <div class:list={['home-customize-layer', 'texture', styleClass(style.id)]} data-customize-layer={style.id} role="group" aria-label={t('{name} style').replace('{name}', t(style.name))}>
            <p class="home-customize-tag" aria-hidden="true"><span>{index(order)}</span><span>{t(style.name)}</span></p>
            <article class="card card-split home-customize-card">
              <img class="card-media" src={`/home/customize/${style.id}.svg`} alt={t(style.alt)} width="1200" height="1000" loading="lazy" decoding="async">
              <header class="card-header">
                <p class="card-title">{t('Lake Ilse loop')}</p>
                <p class="card-description">{t('6.2 km · 2 h 10 min')}</p>
                <div class="card-action"><span class="badge badge-success badge-dot">{t('Route open')}</span></div>
              </header>
              <div class="card-body home-customize-body">
                <div class="home-customize-controls">
                  <div class="segmented" role="radiogroup" aria-label={t('Activity')}>
                    {activities.map((activity, choice) => (
                      <label class="segmented-item"><input type="radio" class="segmented-input" name={`home-customize-activity-${style.id}`} value={activity.toLowerCase()} checked={choice === 0}>{t(activity)}</label>
                    ))}
                  </div>
                  <label class="check home-customize-offline"><input type="checkbox" role="switch" class="switch" checked> {t('Offline map')}</label>
                </div>
                <ol class="list" aria-label={t('Stops')}>
                  {stops.map(stop => (
                    <li class="list-row">
                      <img class="list-media home-customize-thumb" src={`/home/customize/${style.id}.svg#${stop.view}`} alt="" width="40" height="40" loading="lazy" decoding="async">
                      <div class="list-body">
                        <p class="list-title">{t(stop.name)}</p>
                        <p class="list-description">{t(stop.detail)}</p>
                      </div>
                      <span class="list-end">{stop.end}</span>
                    </li>
                  ))}
                </ol>
              </div>
              <footer class="card-footer">
                <button type="button" class="btn">{t('Save')}</button>
                <button type="button" class="btn btn-primary">{t('Start route')}</button>
              </footer>
            </article>
          </div>
        ))}
        <span class="home-customize-seam" aria-hidden="true"></span>
      </div>

      <div class="home-customize-console">
        <div class="home-customize-bar">
          <p class="home-annotation" id="customize-styles-label">{t('Styles')}</p>
          <button type="button" class="btn btn-quiet btn-square btn-sm home-customize-play" aria-label={t('Play the styles in turn')} data-customize-play hidden>
            <IconPlayerPause class="icon home-customize-when-playing" aria-hidden="true" stroke={1.75} />
            <IconPlayerPlay class="icon home-customize-when-stopped" aria-hidden="true" stroke={1.75} />
          </button>
          <label class="check home-customize-scheme"><input type="checkbox" role="switch" class="switch switch-sm" data-customize-dark>{t('Dark')}</label>
          {/* The stage starts in the page's own scheme, before the first paint. */}
          <script is:inline>
            (() => {
              const root = document.documentElement
              const input = document.querySelector('[data-customize-dark]')
              const scheme = getComputedStyle(root).colorScheme
              if (input) input.checked = /dark/.test(scheme) && (!/light/.test(scheme) || matchMedia('(prefers-color-scheme: dark)').matches)
            })()
          </script>
        </div>
        <div class="home-customize-options" role="radiogroup" aria-labelledby="customize-styles-label">
          {styles.map((style, order) => (
            <label class="home-customize-option">
              <input type="radio" class="home-customize-option-input" name="home-customize-style" value={style.id} checked={order === 0}>
              <span class="home-customize-option-index" aria-hidden="true">{index(order)}</span>
              <span class="home-customize-option-name">{t(style.name)}</span>
              <span class="home-customize-option-summary">{t(style.summary)}</span>
              <span class="home-customize-option-time" aria-hidden="true"></span>
            </label>
          ))}
        </div>
        <div class="home-customize-sources">
          {styles.map(style => (
            <div class="home-customize-source" data-customize-source={style.id}>
              <p class="home-customize-file"><span class="home-customize-file-name">themes/{style.id}.css</span><span>{t('{count} tokens').replace('{count}', String(tokenCount(style)))}</span></p>
              <pre class="home-customize-code" tabindex="0" aria-label={t('The theme file for {name}').replace('{name}', t(style.name))}><code set:html={code(style).map(line => `<span class="l">${line || ' '}</span>`).join('')} /></pre>
            </div>
          ))}
        </div>
      </div>
    </figure>

    <ol class="home-customize-ladder" aria-label={t('Customization, from one instance to the whole component')}>
      {ladder.map((step, order) => (
        <li class="home-customize-step">
          <p class="home-customize-step-index home-annotation" aria-hidden="true">{index(order)}</p>
          <h3 class="home-customize-step-name"><Link href={`/guide/customization#${step.anchor}`}>{t(step.name)}</Link></h3>
          <p class="home-customize-step-reach">{t(step.reach)}</p>
          <code class="home-customize-step-code">{step.example}</code>
          <p class="home-customize-step-upstream">{t(step.upstream)}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const figure = document.querySelector<HTMLElement>('[data-customize]')
  const stage = figure?.querySelector<HTMLElement>('[data-customize-stage]')
  const play = figure?.querySelector<HTMLButtonElement>('[data-customize-play]')
  const dark = figure?.querySelector<HTMLInputElement>('[data-customize-dark]')

  if (figure && stage && play && dark) {
    const layers = [...stage.querySelectorAll<HTMLElement>('[data-customize-layer]')]
    const radios = [...figure.querySelectorAll<HTMLInputElement>('[name="home-customize-style"]')]
    const motion = matchMedia('(prefers-reduced-motion: reduce)')
    let current = Math.max(0, radios.findIndex(radio => radio.checked))

    /*
     * Changing style: the new picture wipes in over the old one, which stays whole underneath until it is covered,
     * so for a moment both are seen side by side. Which picture and which file are shown follows the radio.
     */
    const settle = () => {
      stage.removeAttribute('data-wiping')
      layers.forEach(layer => layer.removeAttribute('data-entering'))
      layers.forEach(layer => layer.removeAttribute('data-leaving'))
    }
    const show = (next: number) => {
      if (next === current) return
      settle()
      const after = layers[next]
      layers[current].setAttribute('data-leaving', '')
      radios[next].checked = true
      // A reflow between the two, so a wipe that is cut short starts again from the edge.
      void after.offsetWidth
      after.setAttribute('data-entering', '')
      stage.setAttribute('data-wiping', '')
      current = next
    }
    stage.addEventListener('animationend', event => {
      if ((event.target as HTMLElement).hasAttribute('data-entering')) settle()
    })

    /*
     * The turn. The thin line under the chosen style runs for as long as the style is shown, and its end moves
     * the turn on; pausing the line pauses the turn, so a style resumes where it stopped. The turn is paused while
     * the pointer rests on the stage, while focus is in the stage or the file, while the figure is off screen and
     * while the tab is hidden. Choosing a style or using the card stops it until Play is pressed again; with
     * reduced motion it does not start by itself.
     */
    let playing = !motion.matches
    const holds = new Set<string>(['screen'])
    const sync = () => {
      figure.toggleAttribute('data-playing', playing)
      figure.toggleAttribute('data-paused', holds.size > 0)
      play.setAttribute('aria-label', playing ? 'Pause the styles' : 'Play the styles in turn')
    }
    const hold = (reason: string, on: boolean) => {
      if (on) holds.add(reason)
      else holds.delete(reason)
      sync()
    }
    const stop = () => {
      playing = false
      sync()
    }
    figure.addEventListener('animationend', event => {
      if (event.animationName === 'home-customize-time') show((current + 1) % layers.length)
    })
    play.addEventListener('click', () => {
      playing = !playing
      sync()
    })
    // The control needs this script, so it waits for it.
    play.hidden = false

    figure.addEventListener('change', event => {
      const input = event.target as HTMLInputElement
      if (input.name !== 'home-customize-style') return
      stop()
      show(radios.indexOf(input))
    })
    // Choosing the style already shown holds it too.
    figure.querySelector('.home-customize-options')?.addEventListener('click', stop)

    stage.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') hold('pointer', true) })
    stage.addEventListener('pointerleave', () => hold('pointer', false))
    const held = (element: EventTarget | null) => element instanceof Element && !!element.closest('[data-customize-stage], .home-customize-code')
    figure.addEventListener('focusin', event => hold('focus', held(event.target)))
    figure.addEventListener('focusout', event => { if (!held(event.relatedTarget)) hold('focus', false) })
    new IntersectionObserver(([entry]) => hold('screen', !entry.isIntersecting), { threshold: 0.35 }).observe(figure)
    document.addEventListener('visibilitychange', () => hold('tab', document.hidden))
    motion.addEventListener('change', () => { if (motion.matches) stop() })

    /* What the reader changes in the card is drawn in every style, so changing style keeps it; it also stops the turn. */
    const fields = (layer: HTMLElement) => [...layer.querySelectorAll<HTMLInputElement>('input')]
    stage.addEventListener('change', event => {
      const source = event.target as HTMLInputElement
      const layer = source.closest<HTMLElement>('[data-customize-layer]')
      if (!layer) return
      const order = fields(layer).indexOf(source)
      for (const other of layers) {
        if (other === layer) continue
        const target = fields(other)[order]
        if (target) target.checked = source.checked
      }
      stop()
    })
    stage.addEventListener('click', event => {
      if ((event.target as Element).closest('button')) stop()
    })

    /* The stage follows the page's scheme when that changes; the switch sets it on its own until then. */
    const pageIsDark = () => {
      const root = document.documentElement
      const scheme = getComputedStyle(root).colorScheme
      return /dark/.test(scheme) && (!/light/.test(scheme) || matchMedia('(prefers-color-scheme: dark)').matches)
    }
    let page = pageIsDark()
    new MutationObserver(() => {
      if (pageIsDark() === page) return
      page = pageIsDark()
      dark.checked = page
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'style', 'data-theme'] })

    sync()
  }
</script>
