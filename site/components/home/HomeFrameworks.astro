---
import '@master/ui/components/accordion.css'
import '@master/ui/components/button.css'
import '@master/ui/components/icon.css'
import '@master/ui/components/scroll-area.css'
import '@master/ui/components/tabs.css'
import '../../styles/home-frameworks.css'
import IconArrowRight from '@tabler/icons-svelte-runes/icons/arrow-right'
import IconCheck from '@tabler/icons-svelte-runes/icons/check'
import IconCopy from '@tabler/icons-svelte-runes/icons/copy'
import Link from '@master/internal-site/components/Link.svelte'
import { siteOf } from '@master/internal-site/astro/site-context'
import { frameworkComponents, frameworkFile, stylesheets } from './frameworks/data'
import { frameworkExamples } from './frameworks/examples'
import { highlightSource } from './frameworks/highlight'

const { t } = siteOf(Astro)

/** Each stylesheet a framework component renders, with that component's name. */
const owners = new Map(frameworkComponents.map(component => [component.contract, component.name]))
const cells = stylesheets.map(name => ({ name, owner: owners.get(name) }))
let order = 0
const ownedCount = cells.filter(cell => cell.owner).length
const markupCount = stylesheets.length - ownedCount

/** What a framework component may own, in the words of the frameworks guide. */
const owns = ['A value the application reads or sets', 'Rows rendered from data', 'Ids that join parts', 'A lifetime']

const count = (text: string, value: number) => t(text).replace('{count}', String(value))

/** The copy button's name says which file it copies. */
const copyLabel = (file: string) => t('Copy {file}').replace('{file}', file)
---

{/*
  Frameworks: the proportion first, as two figures over one bar that opens onto every stylesheet, then the same
  card in React, Svelte and Vue beside the one kind of thing that is a framework component.
*/}
<section id="frameworks" class="home-section" aria-labelledby="frameworks-title">
  <div class="app-wrapper home-section-wrap">
    <header class="home-section-header">
      <p class="home-eyebrow"><span class="home-eyebrow-index" aria-hidden="true">06</span><span>{t('Frameworks')}</span></p>
      <h2 id="frameworks-title" class="home-lit home-section-heading home-stone-type"><span>{t('Any framework,')}</span>{' '}<span>{t('no bindings.')}</span></h2>
      <p class="home-section-body">{t('No bindings package, no wrappers. Most components are a class on a native element, plain markup with nothing to hydrate; where the framework owns a part, its component is copied into your project.')}</p>
      <Link class="home-section-link" href="/guide/frameworks">{t('Framework components')}<IconArrowRight aria-hidden="true" stroke={1.75} /></Link>
    </header>

    <div class="ui-frameworks" data-frameworks>
      {/* One accordion row: closed, the figures and the bar still say the proportion; open, every stylesheet. */}
      <div class="accordion ui-frameworks-ledger">
        <details class="accordion-item">
          <summary class="accordion-trigger ui-frameworks-summary">
            <span class="ui-frameworks-hidden">{count('Of {count} component stylesheets,', stylesheets.length)} {count('{count} are markup in every framework', markupCount)} {count('and {count} have a framework component.', ownedCount)}</span>
            <span class="ui-frameworks-figure" aria-hidden="true">
              <span class="ui-frameworks-count">{markupCount}</span>
              <span class="ui-frameworks-label home-annotation"><span class="ui-frameworks-key"></span>{t('Markup in any framework')}</span>
            </span>
            <span class="ui-frameworks-figure ui-frameworks-figure-owned" aria-hidden="true">
              <span class="ui-frameworks-count">{ownedCount}</span>
              <span class="ui-frameworks-label home-annotation"><span class="ui-frameworks-key ui-frameworks-key-owned"></span>{t('Framework components')}</span>
            </span>
            <span class="ui-frameworks-split" style={`--markup: ${markupCount}; --owned: ${ownedCount}`} aria-hidden="true"><span></span><span></span></span>
            <span class="ui-frameworks-total home-annotation" aria-hidden="true">{count('{count} stylesheets', stylesheets.length)} <span>@master/ui/components</span></span>
            <span class="ui-frameworks-toggle home-annotation" aria-hidden="true"><span class="ui-frameworks-more">{t('Show all')}</span><span class="ui-frameworks-less">{t('Hide')}</span></span>
          </summary>
          <div class="accordion-content ui-frameworks-content">
            <ol class="ui-frameworks-cells" aria-label={t('Every component stylesheet')}>
              {cells.map(cell => cell.owner ? (
                <li class="ui-frameworks-cell" data-owned style={`--order: ${order++}`}>
                  <span class="ui-frameworks-name">{cell.name}{cell.owner !== cell.name && <span class="ui-frameworks-alias"> · {cell.owner}</span>}<span class="ui-frameworks-hidden">{t(', a framework component')}</span></span>
                </li>
              ) : (
                <li class="ui-frameworks-cell"><span class="ui-frameworks-name">{cell.name}</span></li>
              ))}
            </ol>
            <p class="ui-frameworks-owned home-annotation" aria-hidden="true">
              {frameworkComponents.map(component => <span>{component.name}</span>)}
            </p>
            <div class="ui-frameworks-test">
              <p class="home-annotation">{t('A framework component exists when the framework owns one of these')}</p>
              <ul class="ui-frameworks-owns">
                {owns.map((thing, index) => <li><span class="ui-frameworks-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span>{t(thing)}</span></li>)}
              </ul>
            </div>
          </div>
        </details>
      </div>

      <div class="ui-frameworks-bar">
        <div class="tabs tabs-sm" role="tablist" aria-label={t('Framework')} data-frameworks-tabs>
          {frameworkExamples.map((example, index) => (
            <button type="button" class="tabs-item" role="tab" id={`frameworks-tab-${example.id}`} aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`frameworks-panel-${example.id}`} tabindex={index === 0 ? undefined : '-1'} data-value={example.id}>{example.title}</button>
          ))}
        </div>
        <p class="home-annotation">{t('The same classes in all three')}</p>
      </div>
      {frameworkExamples.map((example, index) => (
        <div class="ui-frameworks-panel" role="tabpanel" id={`frameworks-panel-${example.id}`} aria-labelledby={`frameworks-tab-${example.id}`} hidden={index !== 0}>
          <figure class="ui-frameworks-slab">
            <figcaption class="ui-frameworks-file home-annotation">
              <span class="ui-frameworks-file-name">{example.markup.file}</span><span class="ui-frameworks-role"><span class="ui-frameworks-key" aria-hidden="true"></span>{t('Markup')}</span>
              <button type="button" class="btn btn-quiet btn-square btn-sm ui-frameworks-copy" aria-label={copyLabel(example.markup.file)} data-frameworks-copy>
                <IconCopy class="icon ui-frameworks-copy-idle" aria-hidden="true" size={16} stroke={1.75} />
                <IconCheck class="icon ui-frameworks-copy-done" aria-hidden="true" size={16} stroke={1.75} />
              </button>
            </figcaption>
            <pre class="ui-frameworks-pre scroll-area scroll-area-inline" tabindex="0" translate="no" aria-label={example.markup.file}><code set:html={highlightSource(example.markup.code, example.language)} /></pre>
            <p class="ui-frameworks-note home-annotation">{t(example.markup.note)}</p>
          </figure>
          <figure class="ui-frameworks-slab">
            <figcaption class="ui-frameworks-file home-annotation">
              <span class="ui-frameworks-file-name">{example.component.file}</span><span class="ui-frameworks-role"><span class="ui-frameworks-key ui-frameworks-key-owned" aria-hidden="true"></span>{t('Framework component')}</span>
              <button type="button" class="btn btn-quiet btn-square btn-sm ui-frameworks-copy" aria-label={copyLabel(example.component.file)} data-frameworks-copy>
                <IconCopy class="icon ui-frameworks-copy-idle" aria-hidden="true" size={16} stroke={1.75} />
                <IconCheck class="icon ui-frameworks-copy-done" aria-hidden="true" size={16} stroke={1.75} />
              </button>
            </figcaption>
            <p class="ui-frameworks-command"><code>npx master-ui add stepper</code>Add stepper: <span>ui/{frameworkFile('stepper', example.id)},</span> <span>ui/{example.helper}.</span></p>
            <pre class="ui-frameworks-pre scroll-area scroll-area-inline" tabindex="0" translate="no" aria-label={example.component.file}><code set:html={highlightSource(example.component.code, example.language)} /></pre>
            <p class="ui-frameworks-note home-annotation">{t(example.component.note)}</p>
          </figure>
        </div>
      ))}
      <span class="ui-frameworks-hidden" aria-live="polite" data-frameworks-copy-status data-copied={t('Copied')} data-failed={t('Copy failed')}></span>
    </div>
  </div>
</section>

<script>
  import { tabs } from '@master/ui/behaviors/tabs.js'

  const root = document.querySelector<HTMLElement>('[data-frameworks]')
  const list = root?.querySelector<HTMLElement>('[data-frameworks-tabs]')
  if (list) tabs(list)

  // Each slab copies its code as written; the line numbers are drawn, so they stay behind.
  if (root) {
    const status = root.querySelector<HTMLElement>('[data-frameworks-copy-status]')
    let copiedTimer: ReturnType<typeof setTimeout> | undefined
    root.addEventListener('click', async event => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-frameworks-copy]')
      const code = button?.closest('.ui-frameworks-slab')?.querySelector('pre code')
      if (!button || !code) return
      const text = code.textContent ?? ''
      let copied = false
      try {
        await navigator.clipboard.writeText(text)
        copied = true
      } catch {
        // Where the Clipboard API is refused, a selected text area still copies within the same click.
        const area = document.createElement('textarea')
        area.value = text
        area.setAttribute('readonly', '')
        area.style.cssText = 'position:fixed;inset:0 auto auto 0;opacity:0;pointer-events:none'
        document.body.append(area)
        area.select()
        copied = document.execCommand('copy')
        area.remove()
        button.focus()
      }
      root.querySelectorAll('[data-frameworks-copy][data-status]').forEach(other => other.removeAttribute('data-status'))
      button.dataset.status = copied ? 'copied' : 'failed'
      if (status) status.textContent = (copied ? status.dataset.copied : status.dataset.failed) ?? ''
      clearTimeout(copiedTimer)
      copiedTimer = setTimeout(() => {
        button.removeAttribute('data-status')
        if (status) status.textContent = ''
      }, 1800)
    })
  }
</script>
