---
import '@master/ui/components/icon.css'
import '@master/ui/components/segmented.css'
import '@master/ui/components/table.css'
import '../../styles/home-cost.css'
import '../../styles/home-compare.css'
import IconArrowUpRight from '@tabler/icons-svelte-runes/icons/arrow-up-right'
import { siteOf } from '@master/internal-site/astro/site-context'
import results from '../../../benchmarks/shadcn-cost/results.json'

/*
 * Compared: the committed results of benchmarks/shadcn-cost, read at build time. Nothing here is typed in by
 * hand; the sentences that name a case are chosen from the figures.
 */
const { t, locale, i18n } = siteOf(Astro)
const list = new Intl.ListFormat(i18n.hreflangOfLocale[locale] ?? locale, { type: 'conjunction' })
const kB = (bytes: number) => bytes ? (bytes / 1000).toFixed(1) : '0'
const repository = 'https://github.com/master-co/ui/tree/main/benchmarks/shadcn-cost'

interface Size { raw: number, gzip: number }
interface Case { html: Size, css: Size, js: Size, react: Size, jsWithoutReact: Size, total: Size }
const master = results.masterUi as Record<string, Case & { behaviors: string[], stylesheets: string[] }>
const shadcn = results.shadcn as Record<string, Record<string, Case>>
const bases = Object.keys(shadcn)
const baseLabel: Record<string, string> = { base: 'Base UI', radix: 'Radix' }
const runtimes = ['with', 'without'] as const

const total = (entry: Case, runtime: typeof runtimes[number]) => entry.html.gzip + entry.css.gzip + (runtime === 'with' ? entry.js.gzip : entry.jsWithoutReact.gzip)
const js = (entry: Case, runtime: typeof runtimes[number]) => runtime === 'with' ? entry.js.gzip : entry.jsWithoutReact.gzip

const rows = [
    { id: 'none', name: t('The setup alone'), note: t('no component') },
    { id: 'button', name: t('Button') },
    { id: 'card', name: t('Card') },
    { id: 'dialog', name: t('Dialog') },
    { id: 'tabs', name: t('Tabs'), note: t('Master UI: tabs.js') },
    { id: 'select', name: t('Select'), note: t('Master UI: native, no script') },
    { id: 'tooltip', name: t('Tooltip') },
    { id: 'all', name: t('All six') },
]

/*
 * One scale for every state: the largest total the toggles can show. Bars compare across rows and within one,
 * and a toggle moves only the bars whose figures it changes; Master UI's stay put, as its figures do.
 */
const scale = Math.max(...bases.flatMap(base => runtimes.flatMap(runtime => rows.flatMap(row => [total(master[row.id], runtime), total(shadcn[base][row.id], runtime)]))))
const share = (value: number) => (value / scale).toFixed(4)
/*
 * A bar's figures for every state the toggles can show: its length on the scale, and the share of it that is
 * HTML, CSS and JavaScript, so the bar is drawn in its three parts.
 */
const style = (entry: (base: string) => Case) => bases.flatMap(base => runtimes.flatMap(runtime => {
    const value = entry(base)
    return [
        `--share-${base}-${runtime}:${share(total(value, runtime))}`,
        `--html-${base}-${runtime}:${value.html.gzip}`,
        `--css-${base}-${runtime}:${value.css.gzip}`,
        `--js-${base}-${runtime}:${js(value, runtime)}`,
    ]
})).join(';')

/*
 * The two bars of a row, each with its figures for every state the toggles can show; the states a toggle does
 * not select are hidden by the stylesheet. Master UI's figures do not depend on the base.
 */
const marks = (id: string) => [
    {
        id: 'master', who: 'Master UI', style: style(() => master[id]),
        states: runtimes.map(runtime => ({ when: [`home-compare-when-${runtime}`], label: 'Master UI', entry: master[id], runtime })),
    },
    {
        id: 'shadcn', who: 'shadcn/ui', style: style(base => shadcn[base][id]),
        states: bases.flatMap(base => runtimes.map(runtime => ({ when: [`home-compare-when-${runtime}`, `home-compare-when-${base}`], label: `shadcn/ui, ${baseLabel[base] ?? base}`, entry: shadcn[base][id], runtime }))),
    },
]

/* How many times the bytes of all six shadcn/ui ships against Master UI's, for each state; said only where it is more. */
const ratios = bases.flatMap(base => runtimes.map(runtime => ({ base, runtime, value: total(shadcn[base].all, runtime) / total(master.all, runtime) })))
    .filter(entry => entry.value > 1)
    .map(entry => ({ ...entry, ratio: entry.value.toFixed(1) }))

/* Where shadcn/ui ships less CSS than Master UI, said in words chosen from the figures. */
const gaps = rows.filter(row => row.id !== 'none').map(row => ({ row, gap: Math.min(...bases.map(base => master[row.id].css.gzip - shadcn[base][row.id].css.gzip)) }))
const smallerCss = gaps.filter(entry => entry.gap > 0)
const widest = smallerCss.toSorted((a, b) => b.gap - a.gap)[0]
const caseName = (row: typeof rows[number]) => row.id === 'all' ? t('all six') : row.name
const date = new Date(results.date)
const day = date.toISOString().slice(0, 10)
const shadcnVersions = results.versions.shadcn as Record<string, Record<string, string>>
const first = shadcnVersions[bases[0]]
const combobox = master.combobox

/* The answer in one sentence, for the default view; it names JavaScript as the gap only while the figures say so. */
const allMaster = master.all
const allShadcn = shadcn[bases[0]].all
const gap = total(allShadcn, 'with') - total(allMaster, 'with')
const headline = (gap > 0 && allShadcn.js.gzip - allMaster.js.gzip >= gap
    ? t('All six on one page: {master} kB with Master UI, {shadcn} kB with shadcn/ui on {base}, gzipped. The gap is JavaScript.')
    : t('All six on one page: {master} kB with Master UI, {shadcn} kB with shadcn/ui on {base}, gzipped.'))
    .replace('{master}', kB(total(allMaster, 'with'))).replace('{shadcn}', kB(total(allShadcn, 'with'))).replace('{base}', baseLabel[bases[0]] ?? bases[0])
---

{/*
  Compared: what the same six components cost a page with Master UI and with shadcn/ui, each built for
  production the standard way. One row per component, two marks on one scale, each labelled.
*/}
<section id="compare" class="home-section home-compare" aria-labelledby="compare-title">
  <div class="app-wrapper home-section-wrap">
    <header class="home-section-header">
      <p class="home-eyebrow"><span class="home-eyebrow-index" aria-hidden="true">05</span><span>{t('Compared')}</span></p>
      <h2 id="compare-title" class="home-lit home-section-heading home-stone-type"><span>{t('The same components,')}</span>{' '}<span>{t('weighed the same way.')}</span></h2>
      <p class="home-section-body">{t('Six common components, built for production with Master UI and shadcn/ui, measured by one script.')} {headline}</p>
      <a class="home-section-link" href={repository}>{t('Read the benchmark and run it')}<IconArrowUpRight aria-hidden="true" size={14} stroke={1.75} /></a>
    </header>
    <figure class="home-cost-tray" aria-labelledby="compare-caption">
      <div class="home-cost-bar">
        <ul class="home-compare-legend" aria-hidden="true">
          <li class="home-compare-key home-compare-key-html">HTML</li>
          <li class="home-compare-key home-compare-key-css">CSS</li>
          <li class="home-compare-key home-compare-key-js">JavaScript</li>
        </ul>
        <div class="home-cost-actions home-compare-controls">
          <div class="home-compare-control">
            <span id="compare-runtime-label" class="home-cost-hidden">{t('React and React DOM')}</span>
            <div class="segmented segmented-sm" role="radiogroup" aria-labelledby="compare-runtime-label">
              <label class="segmented-item"><input type="radio" class="segmented-input" name="home-compare-runtime" value="with" checked>{t('With React')}</label>
              <label class="segmented-item"><input type="radio" class="segmented-input" name="home-compare-runtime" value="without">{t('Without React')}</label>
            </div>
          </div>
          {bases.length > 1 && (
            <div class="home-compare-control">
              <span id="compare-base-label" class="home-annotation">{t('shadcn/ui on')}</span>
              <div class="segmented segmented-sm" role="radiogroup" aria-labelledby="compare-base-label">
                {bases.map((base, index) => (
                  <label class="segmented-item"><input type="radio" class="segmented-input" name="home-compare-base" value={base} checked={index === 0}>{baseLabel[base] ?? base}</label>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
      <div class="home-cost-sheet home-compare-sheet">
        <table class="table home-compare-table">
          <caption id="compare-caption" class="home-cost-hidden">{t('First load, gzipped: HTML, CSS and JavaScript of each page, in kB')}</caption>
          <thead>
            <tr class="table-row">
              <th class="table-heading" scope="col">{t('Component')}</th>
              <th class="table-heading" scope="col">
                <span class="home-compare-head">
                  <span class="home-compare-head-title">{t('First load, gzipped')}<span class="home-compare-head-unit">, kB</span></span>
                  <span class="home-compare-total">{t('Total')}</span>
                  <span class="home-compare-css">CSS</span>
                  <span class="home-compare-js">JS</span>
                </span>
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map(row => (
              <tr class:list={['table-row', { 'home-compare-sum': row.id === 'all' }]}>
                <th class="table-cell home-compare-name" scope="row">
                  <span>{row.name}</span>
                  {row.note && <span class="home-compare-name-note">{row.note}</span>}
                  {row.id === 'all' && ratios.length > 0 && (
                    <span class="home-compare-ratio">
                      {ratios.map(entry => (
                        <span class:list={['home-compare-state', `home-compare-when-${entry.runtime}`, `home-compare-when-${entry.base}`]}><span class="home-compare-ratio-figure">{entry.ratio}×</span> {t('lighter with Master UI')}</span>
                      ))}
                    </span>
                  )}
                </th>
                <td class="table-cell">
                  <div class="home-compare-bars">
                    {marks(row.id).map(mark => (
                      <div class={`home-compare-bar home-compare-mark-${mark.id}`} style={mark.style}>
                        <span class="home-compare-who" aria-hidden="true">{mark.who}</span>
                        <span class="home-compare-track" aria-hidden="true"><span class="home-compare-fill"><span class="home-compare-part home-compare-part-html"></span><span class="home-compare-part home-compare-part-css"></span><span class="home-compare-part home-compare-part-js"></span></span></span>
                        <span class="home-compare-figure">
                          {mark.states.map(state => (
                            <span class:list={['home-compare-state', ...state.when]}>
                              <span class="home-cost-hidden">{state.label}: </span>
                              <span class="home-compare-total">{kB(total(state.entry, state.runtime))}<span class="home-compare-unit"> kB</span></span>
                              <span class="home-compare-css"><span class="home-compare-label"><span class="home-compare-label-comma">, </span>CSS </span>{kB(state.entry.css.gzip)}</span>
                              <span class="home-compare-js"><span class="home-compare-label"><span class="home-compare-label-comma">, </span>JS </span>{kB(js(state.entry, state.runtime))}</span>
                            </span>
                          ))}
                        </span>
                      </div>
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {/* How it was measured, closed until asked for: the figure reads without it. */}
      <details class="home-notes">
        <summary class="home-notes-summary">
          <span class="home-notes-title">{t('How it was measured')}</span>
          <span class="home-notes-meta">{day} · shadcn/ui {first.shadcn} · Vite {first.vite}</span>
        </summary>
      <ol class="home-cost-notes" id="compare-notes">
        <li><span class="home-cost-note-mark" aria-hidden="true">1</span>{t('Every file the built page loads first, gzipped: the HTML, its stylesheets and its module scripts. Master UI writes the markup in the HTML; shadcn/ui renders it from JavaScript. React and React DOM are {size} kB of that JavaScript on every shadcn/ui page; “Without React” leaves them out. Lightning CSS minifies both builds’ CSS, so it weighs less here than in the unminified figures above.').replace('{size}', kB(shadcn[bases[0]].none.react.gzip))}</li>
        <li><span class="home-cost-note-mark" aria-hidden="true">2</span>{smallerCss.length
          ? t('CSS alone, shadcn/ui ships less for {cases}, since Tailwind writes only the utilities a page uses. The widest gap is {widest}: {master} kB against {shadcn} kB.').replace('{cases}', list.format(smallerCss.map(entry => caseName(entry.row)))).replace('{widest}', caseName(widest.row)).replace('{master}', kB(master[widest.row.id].css.gzip)).replace('{shadcn}', kB(Math.max(...bases.map(base => shadcn[base][widest.row.id].css.gzip))))
          : t('CSS alone, Master UI ships no more than shadcn/ui in any case.')}{widest ? ` ${t('A Master UI {name} compiles {count} stylesheets after the theme, itself and what it composes: {list}.').replace('{name}', caseName(widest.row).toLowerCase()).replace('{count}', String(master[widest.row.id].stylesheets.length)).replace('{list}', list.format(master[widest.row.id].stylesheets.map(file => file.replace(/^.*\//, '').replace(/\.css$/, ''))))}` : ''}</li>
        <li><span class="home-cost-note-mark" aria-hidden="true">3</span>{t('Master UI needs a script only where no native element does the job. Tabs that switch panels in place load the tabs behavior; the select measured is a native select, which needs none. Drawn as a combobox, a select costs {css} kB of CSS and {js} kB of JavaScript.').replace('{css}', kB(combobox.css.gzip)).replace('{js}', kB(combobox.js.gzip))}</li>
        <li><span class="home-cost-note-mark" aria-hidden="true">4</span>{t('shadcn/ui {shadcn} ({styles}) on Vite {vite}, React {react}, Tailwind CSS {tailwind}; Master UI from commit {commit} on the same Vite. Built with Vite’s defaults, gzipped by node:zlib, on {date} ({machine}); 1 kB is 1,000 bytes.')
          .replace('{shadcn}', first.shadcn)
          .replace('{styles}', bases.map(base => shadcnVersions[base].style).join(', '))
          .replace('{vite}', first.vite)
          .replace('{react}', first.react)
          .replace('{tailwind}', first.tailwindcss)
          .replace('{commit}', (results.versions.masterUi.commit ?? '').slice(0, 7))
          .replace('{date}', day)
          .replace('{machine}', `${results.machine.cpu}, Node ${results.machine.node}`)}{' '}<a href={repository}>benchmarks/shadcn-cost</a></li>
      </ol>
      </details>
    </figure>
  </div>
</section>
