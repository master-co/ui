import IconArrowRight from '@tabler/icons-svelte-runes/icons/arrow-right'
import Link from '@master/internal-site/components/Link.svelte'
import { siteOf } from '@master/internal-site/astro/site-context'
import SetupPromptButton from './SetupPromptButton.astro'
import { columnStarts, drawPanel, matrixPool } from './matrix'

const { t } = siteOf(Astro)

/**
 * Eight columns, wider than the hero, so the plane runs past every edge of the window. Each column starts with
 * twenty-two panels drawn here, enough to fill the view with or without script; the script then scrolls each column and
 * recycles a panel that leaves one end to the other, drawing the next panel of the pool into it, so a column has
 * no end and the whole pool passes in turn. Columns start far apart in the pool and take turns climbing and
 * falling, each at its own pace.
 */
const columnCount = 8
const slots = 22
const starts = columnStarts(columnCount)
/** Pixels a second. */
const speeds = [34, 26, 40, 30, 44, 28, 38, 32]
---

{/*
  The hero: the words on the left, and on the right the library itself, a plane of its components tilted away in
  perspective, every column scrolling past. The plane is decoration, inert and hidden from assistive technology;
  everything the hero says is in the words, which read the same without it.
*/}
<section class="ui-hero" aria-labelledby="hero-title" data-hero>
  <div class="ui-hero-body app-wrapper home-section-wrap">
    <div class="ui-hero-reading">
      <Link class="ui-hero-pill" href="/components">
        <span class="ui-hero-pill-badge">{t('Alpha')}</span>
        <span class="ui-hero-pill-label">{t('Native HTML and CSS components')}</span>
        <IconArrowRight aria-hidden="true" size={14} stroke={1.75} />
      </Link>
      <h1 id="hero-title" class="ui-hero-title">{t('Beautiful interface crafted with Master CSS.')}</h1>
      <p class="ui-hero-lead">{t('Native elements and modern CSS do the work: dialogs, menus, tooltips and selects open, anchor and animate with zero JavaScript to start.')}</p>
      {/* A stone action and a glass pill that copies the guide's setup prompt. */}
      <div class="ui-hero-actions">
        <Link class="ui-hero-start" href="/guide/introduction">
          {t('Get started')}
          <IconArrowRight aria-hidden="true" size={16} stroke={1.75} />
        </Link>
        <SetupPromptButton />
      </div>
    </div>
  </div>
  <div class="ui-matrix" aria-hidden="true" inert data-matrix>
    <div class="ui-matrix-plane">
      {starts.map((start, column) => (
        <div class="ui-matrix-column" data-start={start} data-speed={speeds[column]} data-reverse={column % 2 ? '' : undefined}>
          {Array.from({ length: slots }, (_, slot) => <div class="ui-matrix-panel" set:html={drawPanel(start + slot, column * 100 + slot)} />)}
        </div>
      ))}
    </div>
    {matrixPool.map(panel => <template data-panel set:html={panel} />)}
  </div>
</section>

<script>
  /*
   * The matrix scrolls with no end: each column moves at its own pace, and a panel that leaves one end is taken
   * off and the next panel of the pool is drawn at the other, so the DOM stays the same size however long the page
   * is open. The plane also leans a few degrees toward the pointer. It all stops while the hero is out of view or
   * the page is hidden, and with reduced motion nothing moves.
   */
  const hero = document.querySelector<HTMLElement>('[data-hero]')
  const matrix = hero?.querySelector<HTMLElement>('[data-matrix]')
  const motion = matchMedia('(prefers-reduced-motion: reduce)')
  if (hero && matrix) {
    const templates = [...matrix.querySelectorAll<HTMLTemplateElement>('template[data-panel]')]
    const size = templates.length
    const plane = matrix.querySelector<HTMLElement>('.ui-matrix-plane')!
    let place = 10_000
    const heights = new WeakMap<Element, number>()
    const gap = () => parseFloat(getComputedStyle(plane).rowGap || getComputedStyle(plane).gap) || 20
    const draw = (index: number) => {
      const panel = document.createElement('div')
      panel.className = 'ui-matrix-panel'
      panel.innerHTML = templates[((index % size) + size) % size].innerHTML.replaceAll('__K__', String(place++))
      return panel
    }
    const height = (panel: Element) => {
      let value = heights.get(panel)
      if (value === undefined) heights.set(panel, value = (panel as HTMLElement).offsetHeight)
      return value
    }
    let spacing = gap()
    /**
     * How far down the plane a column must reach, whatever the heights of the panels it happens to hold: past the
     * view's lower edge with room for the lean. Panels are added or dropped at the far end to keep it there.
     */
    const reach = () => plane.offsetHeight * 0.85
    const columns = [...matrix.querySelectorAll<HTMLElement>('.ui-matrix-column')].map(element => {
      const start = Number(element.dataset.start)
      const length = [...element.children].reduce((sum, panel) => sum + height(panel) + spacing, 0)
      return { element, head: start, tail: start + element.children.length - 1, offset: 0, length, speed: Number(element.dataset.speed), direction: element.hasAttribute('data-reverse') ? 1 : -1 }
    })
    type Column = typeof columns[number]
    const append = (column: Column) => {
      const panel = draw(++column.tail)
      column.element.append(panel)
      column.length += height(panel) + spacing
    }
    const fill = (column: Column) => {
      const target = reach()
      while (column.offset + column.length < target) append(column)
    }
    columns.forEach(fill)
    let frame = 0
    let last = 0
    let visible = false
    const step = (now: number) => {
      frame = 0
      const dt = Math.min((now - (last || now)) / 1000, 0.1)
      last = now
      for (const column of columns) {
        column.offset += column.direction * column.speed * dt
        const { element } = column
        if (column.direction < 0) {
          // Climbing: the first panel, once wholly past the top, goes; the next panel of the pool joins the foot.
          let first = element.firstElementChild!
          while (column.offset <= -(height(first) + spacing)) {
            column.offset += height(first) + spacing
            column.length -= height(first) + spacing
            first.remove()
            column.head++
            first = element.firstElementChild!
          }
          fill(column)
        } else {
          // Falling: once a gap opens at the top, the last panel goes and the panel before the first joins the top.
          while (column.offset > 0) {
            const panel = draw(--column.head)
            element.prepend(panel)
            column.offset -= height(panel) + spacing
            column.length += height(panel) + spacing
          }
          // The foot only needs to reach so far; what hangs below it is dropped.
          let last = element.lastElementChild!
          while (column.offset + column.length - (height(last) + spacing) >= reach()) {
            column.length -= height(last) + spacing
            last.remove()
            column.tail--
            last = element.lastElementChild!
          }
        }
        element.style.translate = `0 ${column.offset.toFixed(2)}px`
      }
      schedule()
    }
    const schedule = () => {
      if (frame || !visible || document.hidden || motion.matches) return
      frame = requestAnimationFrame(step)
    }
    const stop = () => {
      cancelAnimationFrame(frame)
      frame = 0
      last = 0
    }
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting
      if (visible) schedule()
      else stop()
    }).observe(matrix)
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : schedule()))
    motion.addEventListener('change', () => (motion.matches ? stop() : schedule()))
    addEventListener('resize', () => { spacing = gap() })

    hero.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || motion.matches) return
      const rect = hero.getBoundingClientRect()
      const x = (event.clientX - rect.left) / rect.width - 0.5
      const y = (event.clientY - rect.top) / rect.height - 0.5
      matrix.style.setProperty('--matrix-lean-x', `${(x * 5).toFixed(2)}deg`)
      matrix.style.setProperty('--matrix-lean-y', `${(-y * 4).toFixed(2)}deg`)
    })
    hero.addEventListener('pointerleave', () => {
      matrix.style.removeProperty('--matrix-lean-x')
      matrix.style.removeProperty('--matrix-lean-y')
    })
  }
</script>
