---
import '@master/ui/layouts/bento.css'
import '@master/ui/components/accordion.css'
import '@master/ui/components/avatar.css'
import '@master/ui/components/badge.css'
import '@master/ui/components/button.css'
import '@master/ui/components/card.css'
import '@master/ui/components/carousel.css'
import '@master/ui/components/chart.css'
import '@master/ui/components/chip.css'
import '@master/ui/components/composer.css'
import '@master/ui/components/dialog.css'
import '@master/ui/components/figure.css'
import '@master/ui/components/icon.css'
import '@master/ui/components/input.css'
import '@master/ui/components/kbd.css'
import '@master/ui/components/menu.css'
import '@master/ui/components/segmented.css'
import '@master/ui/components/select.css'
import '@master/ui/components/slider.css'
import '@master/ui/components/surface.css'
import '@master/ui/components/texture.css'
import '@master/ui/components/thread.css'
import '@master/ui/components/toolbar.css'
import '@master/ui/components/tooltip.css'
import IconArrowRight from '@tabler/icons-svelte-runes/icons/arrow-right'
import Link from '@master/internal-site/components/Link.svelte'
import { siteOf } from '@master/internal-site/astro/site-context'
import { platformFeatures } from './platform'

const { t } = siteOf(Astro)
---

{/*
  The platform does the work: a bento of small, real scenes, each with the feature it rests on. Every scene is the
  library's markup on this page; none of them loads a script.
*/}
<section id="platform" class="home-section ui-platform" aria-labelledby="platform-title">
  <div class="app-wrapper home-section-wrap">
    <header class="home-section-header">
      <p class="home-eyebrow"><span class="home-eyebrow-index" aria-hidden="true">01</span><span>{t('Platform')}</span></p>
      <h2 id="platform-title" class="home-lit home-section-heading home-stone-type"><span>{t('Modern CSS and the platform')}</span>{' '}<span>{t('do the work.')}</span></h2>
      <p class="home-section-body">{t('Where the browser has an element or a feature for the job, the component uses it. Try each one: none of them loads a script.')}</p>
      <Link class="home-section-link" href="/guide/browser-support">{t('Browser support')}<IconArrowRight aria-hidden="true" size={14} stroke={1.75} /></Link>
    </header>
    {/* The library's own bento, dense, since the tiles can be read in any order: four columns on a wide stage, two below, one on a phone. */}
    <ul class="bento bento-dense ui-platform-grid">
      {platformFeatures.map(feature => (
        <li class:list={['ui-platform-cell', 'home-reveal-item', feature.size !== 'cell' && `bento-${feature.size}`]} data-size={feature.size}>
          <div class="ui-platform-scene texture" data-feature={feature.id} set:html={feature.html} />
          <div class="ui-platform-text">
            <h3 class="ui-platform-cell-title">{t(feature.title)}</h3>
            <p class="ui-platform-summary">{t(feature.summary)}</p>
            <p class="ui-platform-names" translate="no">{feature.names.map((name, index) => <>{index > 0 && ' '}<code>{name}</code></>)}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
