---
import '@master/ui/components/accordion.css'
import '@master/ui/components/button.css'
import '@master/ui/components/card.css'
import '@master/ui/components/checkbox.css'
import '@master/ui/components/chip.css'
import '@master/ui/components/icon.css'
import '@master/ui/components/input.css'
import '@master/ui/components/kbd.css'
import '@master/ui/components/scroll-area.css'
import '@master/ui/components/segmented.css'
import '@master/ui/components/switch.css'
import '@master/ui/components/tabs.css'
import '@master/ui/components/texture.css'
import '@master/ui/components/toast.css'
import '../../styles/home-frameworks.css'
import IconArrowRight from '@tabler/icons-svelte-runes/icons/arrow-right'
import IconCheck from '@tabler/icons-svelte-runes/icons/check'
import IconCopy from '@tabler/icons-svelte-runes/icons/copy'
import Link from '@master/internal-site/components/Link.svelte'
import { siteOf } from '@master/internal-site/astro/site-context'
import { forgeExamples, forgeFrameworks, forgeSource, highlight, type ForgeFramework } from './forge'
import { frameworkComponents, stylesheets } from './frameworks/data'
import { highlightSource } from './frameworks/highlight'

const { t } = siteOf(Astro)
const lines = (code: string) => code.split('\n').length

/** An example in one framework: its file, its line count and its code highlighted, line by line. */
const source = (example: typeof forgeExamples[number], framework: ForgeFramework) => {
  const { file, code } = forgeSource(example, framework.id)
  return { file, lines: lines(code), html: 'language' in framework ? highlightSource(code, framework.language) : highlight(code) }
}

/** Each stylesheet a framework component renders, with that component's name. */
const owners = new Map(frameworkComponents.map(component => [component.contract, component.name]))
const cells = stylesheets.map(name => ({ name, owner: owners.get(name) }))
let order = 0
const ownedCount = cells.filter(cell => cell.owner).length
const markupCount = stylesheets.length - ownedCount

/** What a framework component may own, in the words of the frameworks guide. */
const owns = ['A value the application reads or sets', 'Rows rendered from data', 'Ids that join parts', 'A lifetime']

const count = (text: string, value: number) => t(text).replace('{count}', String(value))
---

{/*
  Markup in, material out, in any framework: each example is written out as code, then drawn by the library on the
  same page. The slab writes it as plain HTML or as a React, Svelte or Vue file, and the specimen beside it stays
  as it is, because every one of them is the same classes on the same elements. Under them, the proportion of
  stylesheets that are markup in every framework, and the few a framework component is copied for.
  The code is real text and the specimen is real markup; the decode and the reveal only stage their arrival.
*/}
<section id="markup" class="home-section ui-markup" aria-labelledby="markup-title">
  <div class="app-wrapper home-section-wrap">
    <header class="home-section-header">
      <p class="home-eyebrow"><span class="home-eyebrow-index" aria-hidden="true">03</span><span>{t('HTML first')}</span></p>
      <h2 id="markup-title" class="home-lit home-section-heading home-stone-type"><span>{t('Markup in,')}</span>{' '}<span>{t('material out.')}</span></h2>
      <p class="home-section-body">{t('A component is a class on a native element, so the same markup works in plain HTML, React, Svelte and Vue. There is no runtime to install and nothing to hydrate: the browser draws the material from one stylesheet, and every state from the element’s own attributes.')}</p>
      <Link class="home-section-link" href="/guide/frameworks">{t('Framework components')}<IconArrowRight aria-hidden="true" stroke={1.75} /></Link>
    </header>
    <figure class="ui-forge" data-forge>
      <div class="ui-forge-bar">
        <div class="tabs tabs-sm" role="tablist" aria-label={t('Examples')} data-forge-tabs>
          {forgeExamples.map((example, index) => (
            <button type="button" class="tabs-item" role="tab" id={`forge-tab-${example.id}`} aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`forge-panel-${example.id}`} tabindex={index === 0 ? undefined : '-1'} data-value={example.id}>{t(example.label)}</button>
          ))}
        </div>
        {/* One choice for every example: the slab rewrites its code, the specimen stays. */}
        <div class="segmented segmented-sm ui-forge-frameworks" role="radiogroup" aria-label={t('Framework')} data-forge-frameworks>
          {forgeFrameworks.map((framework, index) => (
            <label class="segmented-item">
              <input type="radio" class="segmented-input" name="forge-framework" value={framework.id} checked={index === 0} />
              {framework.title}
            </label>
          ))}
        </div>
      </div>
      {forgeExamples.map((example, index) => (
        <div class="ui-forge-panel" role="tabpanel" id={`forge-panel-${example.id}`} aria-labelledby={`forge-tab-${example.id}`} hidden={index !== 0} data-forge-panel>
          <div class="ui-forge-code">
            {forgeFrameworks.map((framework, place) => {
              const { file, lines, html } = source(example, framework)
              return (
                <div class="ui-forge-source" hidden={place !== 0} data-forge-source={framework.id}>
                  <div class="ui-forge-file home-annotation">
                    <span class="ui-forge-file-name" translate="no">{file}</span>
                    <span class="ui-forge-lines">{lines} {t('lines')}</span>
                    <button type="button" class="btn btn-quiet btn-square btn-sm ui-forge-copy" aria-label={t('Copy {file}').replace('{file}', file)} data-forge-copy>
                      <IconCopy class="icon ui-forge-copy-idle" aria-hidden="true" size={16} stroke={1.75} />
                      <IconCheck class="icon ui-forge-copy-done" aria-hidden="true" size={16} stroke={1.75} />
                    </button>
                  </div>
                  <pre class="ui-forge-pre scroll-area scroll-area-inline" tabindex="0" translate="no" aria-label={file}><code set:html={html} /></pre>
                </div>
              )
            })}
          </div>
          <div class="ui-forge-stage texture" data-forge-stage>
            <p class="ui-forge-status home-annotation"><span class="ui-forge-status-dot" aria-hidden="true"></span>{t('Drawn by the stylesheet alone')}</p>
            <span class="ui-forge-scan" aria-hidden="true"></span>
            <div class="ui-forge-specimen" data-example={example.id} set:html={example.html} />
          </div>
        </div>
      ))}

      {/* One accordion row: closed, the figures and the bar still say the proportion; open, every stylesheet. */}
      <div id="frameworks" class="accordion ui-frameworks-ledger">
        <details class="accordion-item">
          <summary class="accordion-trigger ui-frameworks-summary">
            <span class="ui-frameworks-hidden">{count('Of {count} component stylesheets,', stylesheets.length)} {count('{count} are markup in every framework', markupCount)} {count('and {count} have a framework component.', ownedCount)}</span>
            <span class="ui-frameworks-figure" aria-hidden="true">
              <span class="ui-frameworks-count">{markupCount}</span>
              <span class="ui-frameworks-label home-annotation"><span class="ui-frameworks-key"></span>{t('Markup in any framework')}</span>
            </span>
            <span class="ui-frameworks-figure ui-frameworks-figure-owned" aria-hidden="true">
              <span class="ui-frameworks-count">{ownedCount}</span>
              <span class="ui-frameworks-label home-annotation"><span class="ui-frameworks-key ui-frameworks-key-owned"></span>{t('Framework components')}</span>
            </span>
            <span class="ui-frameworks-split" style={`--markup: ${markupCount}; --owned: ${ownedCount}`} aria-hidden="true"><span></span><span></span></span>
            <span class="ui-frameworks-total home-annotation" aria-hidden="true">{count('{count} stylesheets', stylesheets.length)} <span>@master/<wbr />ui/<wbr />components</span></span>
            <span class="ui-frameworks-toggle home-annotation" aria-hidden="true"><span class="ui-frameworks-more">{t('Show all')}</span><span class="ui-frameworks-less">{t('Hide')}</span></span>
          </summary>
          <div class="accordion-content ui-frameworks-content">
            <ol class="ui-frameworks-cells" aria-label={t('Every component stylesheet')}>
              {cells.map(cell => cell.owner ? (
                <li class="ui-frameworks-cell" data-owned style={`--order: ${order++}`}>
                  <span class="ui-frameworks-name">{cell.name}{cell.owner !== cell.name && <span class="ui-frameworks-alias"> · {cell.owner}</span>}<span class="ui-frameworks-hidden">{t(', a framework component')}</span></span>
                </li>
              ) : (
                <li class="ui-frameworks-cell"><span class="ui-frameworks-name">{cell.name}</span></li>
              ))}
            </ol>
            <p class="ui-frameworks-owned home-annotation" aria-hidden="true">
              {frameworkComponents.map(component => <span>{component.name}</span>)}
            </p>
            <div class="ui-frameworks-test">
              <p class="home-annotation">{t('A framework component exists when the framework owns one of these')}</p>
              <ul class="ui-frameworks-owns">
                {owns.map((thing, index) => <li><span class="ui-frameworks-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span>{t(thing)}</span></li>)}
              </ul>
            </div>
          </div>
        </details>
      </div>
      <span class="sr-only" aria-live="polite" data-forge-copy-status data-copied={t('Copied')} data-failed={t('Copy failed')}></span>
    </figure>
  </div>
</section>

<script>
  import { tabs } from '@master/ui/behaviors/tabs.js'

  const figure = document.querySelector<HTMLElement>('[data-forge]')
  const motion = matchMedia('(prefers-reduced-motion: reduce)')
  /** Letters, digits and the marks markup is written with: in the monospace face, each is as wide as what it stands in for. */
  const glyphs = '<>="#_*:;.abcdeghiklmnoprstuvwxyz0123456789'
  /** A glyph that holds for one step of the flicker: the same character, index and step always give the same glyph. */
  const glyph = (index: number, step: number) => glyphs[Math.abs(Math.imul(index * 31 + step, 2654435761) >> 7) % glyphs.length]
  /** Each text node's own text, kept before any decode or blanking touches it. */
  const originals = new WeakMap<Text, string>()
  /** Panels written out already: a panel decodes the first time it is shown, and is simply there after that. */
  const written = new WeakSet<HTMLElement>()
  let running = 0
  let finish: (() => void) | undefined

  const textNodes = (root: HTMLElement) => {
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
    const nodes: Text[] = []
    for (let node = walker.nextNode(); node; node = walker.nextNode()) {
      const text = node as Text
      if (!originals.has(text)) originals.set(text, text.data)
      nodes.push(text)
    }
    return nodes
  }

  /** The code a panel shows: the source in the framework chosen, the others hidden beside it. */
  const shownCode = (panel: HTMLElement) => panel.querySelector<HTMLElement>('[data-forge-source]:not([hidden]) code')

  /**
   * Clears a panel's code to its whitespace and, unless the specimen is already there, hides the specimen too, so
   * neither shows and then vanishes when the decode starts.
   */
  function blank(panel: HTMLElement, reveal = true) {
    const code = shownCode(panel)
    const stage = panel.querySelector<HTMLElement>('[data-forge-stage]')
    if (code) textNodes(code).forEach(node => { node.data = originals.get(node)!.replace(/\S/g, ' ') })
    if (!reveal) return
    stage?.style.setProperty('--reveal', '0')
    stage?.setAttribute('data-revealing', '')
  }

  /**
   * Writes a panel's code out: line by line, each character flickers through a few glyphs before it settles, and
   * the specimen beside it is uncovered from the left as the last lines land. Only the text changes, and every
   * glyph is as wide as the character it stands for, so nothing reflows. Written again in another framework, the
   * code decodes and the specimen stays: it is the same material whichever framework writes it.
   */
  function play(panel: HTMLElement, reveal = true) {
    const code = shownCode(panel)
    const stage = panel.querySelector<HTMLElement>('[data-forge-stage]')
    if (!code || !stage) return
    finish?.()
    written.add(panel)
    const nodes: { node: Text, text: string, settle: number[] }[] = []
    let line = 0
    let column = 0
    let count = 0
    for (const node of textNodes(code)) {
      const text = originals.get(node)!
      // Indexed by UTF-16 unit, as the tick reads the text.
      const settle = text.split('').map(character => {
        if (character === '\n') { line++; column = 0; return 0 }
        column++
        count++
        return line * 48 + column * 3.5 + ((count * 37) % 100) * 1.2
      })
      nodes.push({ node, text, settle })
    }
    const typed = line * 48 + 380
    const revealFrom = typed * 0.4
    const revealFor = 1000
    const end = reveal ? Math.max(typed, revealFrom + revealFor) : typed
    const start = performance.now()
    blank(panel, reveal)
    code.setAttribute('aria-busy', 'true')
    finish = () => {
      cancelAnimationFrame(running)
      nodes.forEach(({ node, text }) => { node.data = text })
      code.removeAttribute('aria-busy')
      stage.style.setProperty('--reveal', '1')
      stage.removeAttribute('data-revealing')
      finish = undefined
    }
    const tick = (now: number) => {
      const elapsed = now - start
      // The flicker steps about fourteen times a second, slower than the frames, so each glyph can be seen.
      const step = Math.floor(elapsed / 70)
      let index = 0
      for (const { node, text, settle } of nodes) {
        let out = ''
        for (let position = 0; position < text.length; position++, index++) {
          const character = text[position]
          if (character === ' ' || character === '\n' || elapsed >= settle[position]) out += character
          // A character waiting its turn stays blank until its line is reached, then flickers.
          else out += elapsed > settle[position] - 200 ? glyph(index, step) : ' '
        }
        if (node.data !== out) node.data = out
      }
      if (reveal) {
        const progress = Math.min(Math.max((elapsed - revealFrom) / revealFor, 0), 1)
        stage.style.setProperty('--reveal', (1 - Math.pow(1 - progress, 3)).toFixed(4))
      }
      if (elapsed < end) running = requestAnimationFrame(tick)
      else finish?.()
    }
    running = requestAnimationFrame(tick)
  }

  if (figure) {
    const status = figure.querySelector<HTMLElement>('[data-forge-copy-status]')
    let copiedTimer: ReturnType<typeof setTimeout> | undefined
    // Copies the example as written, settling a decode first so the clipboard never takes the glyphs in flight.
    figure.addEventListener('click', async event => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-forge-copy]')
      const panel = button?.closest<HTMLElement>('[data-forge-panel]')
      const code = button?.closest('[data-forge-source]')?.querySelector('code')
      if (!button || !panel || !code) return
      // A slab still blank, waiting to come into view, is settled at once: played and finished before any paint.
      if (!written.has(panel)) play(panel)
      finish?.()
      const text = code.textContent ?? ''
      let copied = false
      try {
        await navigator.clipboard.writeText(text)
        copied = true
      } catch {
        // Where the Clipboard API is refused, a selected text area still copies within the same click.
        const area = document.createElement('textarea')
        area.value = text
        area.setAttribute('readonly', '')
        area.style.cssText = 'position:fixed;inset:0 auto auto 0;opacity:0;pointer-events:none'
        document.body.append(area)
        area.select()
        copied = document.execCommand('copy')
        area.remove()
        button.focus()
      }
      figure.querySelectorAll('[data-forge-copy][data-status]').forEach(other => other.removeAttribute('data-status'))
      button.dataset.status = copied ? 'copied' : 'failed'
      if (status) status.textContent = (copied ? status.dataset.copied : status.dataset.failed) ?? ''
      clearTimeout(copiedTimer)
      copiedTimer = setTimeout(() => {
        button.removeAttribute('data-status')
        if (status) status.textContent = ''
      }, 1800)
    })

    const list = figure.querySelector<HTMLElement>('[data-forge-tabs]')
    if (list) tabs(list)
    const current = () => figure.querySelector<HTMLElement>('[data-forge-panel]:not([hidden])')

    // One framework for every example: each slab shows its source in it, and the panel in view writes it out.
    figure.querySelector('[data-forge-frameworks]')?.addEventListener('change', event => {
      const framework = (event.target as HTMLInputElement).value
      const panel = current()
      // A decode in flight settles before its code is hidden, and code still blank is put back, so the source
      // comes back whole.
      finish?.()
      const before = panel && shownCode(panel)
      if (before) textNodes(before).forEach(node => { node.data = originals.get(node)! })
      figure.querySelectorAll<HTMLElement>('[data-forge-source]').forEach(source => { source.hidden = source.dataset.forgeSource !== framework })
      if (!panel || motion.matches) return
      // Before the figure has come into view, the new code waits blank for its first decode, as the first one did.
      if (written.has(panel)) play(panel, false)
      else blank(panel)
    })
    list?.addEventListener('change', () => {
      const panel = current()
      if (!panel) return
      // A toast dismissed earlier comes back with its panel.
      panel.querySelectorAll<HTMLDialogElement>('dialog.toast:not([open])').forEach(dialog => dialog.show())
      // Leaving a panel mid-decode settles it, so it is whole when it is shown again.
      if (written.has(panel)) finish?.()
      else if (motion.matches) written.add(panel)
      else play(panel)
    })
    if (!motion.matches) {
      // The first example writes itself out once the figure's top is above the window's lower two fifths, so
      // on a laptop the middle of the stage, where the specimen lands, is in view by the time it is uncovered.
      const seen = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return
        seen.disconnect()
        const panel = current()
        if (panel && !written.has(panel)) play(panel)
      }, { rootMargin: '0px 0px -40% 0px' })
      const panel = current()
      if (panel) blank(panel)
      seen.observe(figure)
      // A page printed before the slab came into view prints the example whole, not its blank; a reader who turns
      // motion off mid-decode, or before the slab arrives, gets the example whole at once, as the contracts run does.
      const settle = () => {
        seen.disconnect()
        const shown = current()
        if (shown && !written.has(shown)) play(shown)
        finish?.()
      }
      addEventListener('beforeprint', settle)
      motion.addEventListener('change', () => { if (motion.matches) settle() })
    }
  }
</script>
