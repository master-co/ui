---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'
import Demo from '@master/internal-site/demo/Demo.svelte'

interface Props { name: string; title: string }
const { name, title } = Astro.props
const drawings = import.meta.glob<{ default: AstroComponentFactory }>('./guide-art/*.astro', { eager: true })
const Art = drawings[`./guide-art/${name}.astro`]?.default
if (!Art) throw new Error(`Missing Guide illustration: ${name}`)
---

<Demo title={title} frameClassName="guide-figure" data-guide-figure={name} padding="sm">
  <div class="guide-figure-art" aria-hidden="true"><Art /></div>
  <Fragment slot="caption"><div class="guide-figure-caption"><slot /></div></Fragment>
</Demo>

<style>
  :global(.guide-figure) {
    --gf-ink: var(--ui-text-strong);
    --gf-muted: var(--ui-text-muted);
    --gf-line: var(--ui-line-strong);
    --gf-surface: var(--ui-surface-canvas);
    --gf-soft: var(--ui-surface-tray);
    container-type: inline-size;
    margin-block: 2rem;
    color: var(--gf-ink);
  }
  .guide-figure-art {
    width: 100%;
    font-size: .875rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  /* The caption is ordinary MDX: one explanation for sighted readers, assistive
     technology, search and the portable Markdown adapter. */
  .guide-figure-caption :global(p) { margin: 0; }
  .guide-figure-caption :global(strong) { color: var(--gf-ink); font-weight: 550; }
  .guide-figure-caption :global(code) {
    display: inline-block;
    max-width: 100%;
    font-size: inherit;
    overflow-wrap: anywhere;
    white-space: normal;
    vertical-align: baseline;
  }
  .guide-figure-art :global(code) { font-size: .8125rem; overflow-wrap: anywhere; white-space: normal; }
  @media (forced-colors: active) {
    :global(.guide-figure) { --gf-ink: CanvasText; --gf-muted: CanvasText; --gf-line: CanvasText; --gf-surface: Canvas; --gf-soft: Canvas; }
  }
</style>
