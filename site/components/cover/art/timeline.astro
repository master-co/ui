---
/** Timeline: three events on one line: a dot for each, a hairline between them, and the latest in ink. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:12px 16px 16px 12px; --gap:3px">
  <span class="cover-line" style="align-items:stretch; --gap:10px"><span class="cover-stack" style="align-items:center; width:24px; --gap:3px"><span class="cover-center" style="height:20px"><i class="cover-dot cover-ink"></i></span><i class="cover-rule cover-rule-upright" style="flex:1; margin:0"></i></span><span class="cover-stack" style="padding:7px 0 16px"><i class="cover-bar cover-bar-strong" style="width:72px"></i><i class="cover-bar" style="width:112px"></i></span></span>
  <span class="cover-line" style="align-items:stretch; --gap:10px"><span class="cover-stack" style="align-items:center; width:24px; --gap:3px"><span class="cover-center" style="height:20px"><i class="cover-dot"></i></span><i class="cover-rule cover-rule-upright" style="flex:1; margin:0"></i></span><span class="cover-stack" style="padding:7px 0 16px"><i class="cover-bar cover-bar-strong" style="width:56px"></i><i class="cover-bar" style="width:96px"></i></span></span>
  <span class="cover-line" style="align-items:stretch; --gap:10px"><span class="cover-stack" style="align-items:center; width:24px; --gap:3px"><span class="cover-center" style="height:20px"><i class="cover-dot"></i></span></span><span class="cover-stack" style="padding:7px 0 0px"><i class="cover-bar cover-bar-strong" style="width:64px"></i><i class="cover-bar" style="width:80px"></i></span></span>
</span>
