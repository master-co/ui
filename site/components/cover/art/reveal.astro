---
/** Reveal: three cards down a page; the first has arrived, the next is on its way up, and the last has only begun to show. */
---

<span class="cover-stack" style="width:184px; --gap:10px">
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); padding:12px 14px"><i class="cover-bar cover-bar-strong" style="width:64px"></i><i class="cover-bar" style="width:120px"></i></span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); padding:12px 14px; opacity:.6; translate:0 5px"><i class="cover-bar cover-bar-strong" style="width:48px"></i><i class="cover-bar" style="width:104px"></i></span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); padding:12px 14px; opacity:.24; translate:0 12px"><i class="cover-bar cover-bar-strong" style="width:72px"></i><i class="cover-bar" style="width:88px"></i></span>
</span>
