---
import Glyph from '../Glyph.astro'
/** Expand: a long text closed: its first lines fade out at the foot, over the toggle that opens it. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:18px 16px 16px; --gap:12px; --glyph:14px">
  <span class="cover-stack cover-fade-foot" style="--gap:10px"><i class="cover-bar" style="width:160px"></i><i class="cover-bar" style="width:168px"></i><i class="cover-bar" style="width:144px"></i><i class="cover-bar" style="width:164px"></i></span>
  <span class="cover-line" style="--gap:4px"><i class="cover-bar cover-bar-strong" style="width:56px"></i><Glyph name="chevron-down" /></span>
</span>
