---
import Glyph from '../Glyph.astro'
/** Toolbar: a small sheet holding quiet 32px controls 4px inside it; one is toggled on. */
---

<span class="cover-sheet cover-line" style="--r:calc(var(--radius-control-sm) + 4px / var(--corner-scale)); padding:4px; --gap:2px">
  <span class="cover-control cover-control-sm cover-square cover-pressed"><Glyph name="bold" /></span>
  <span class="cover-control cover-control-sm cover-square cover-quiet"><Glyph name="italic" /></span>
  <span class="cover-control cover-control-sm cover-square cover-quiet"><Glyph name="underline" /></span>
  <i class="cover-rule cover-rule-upright"></i>
  <span class="cover-control cover-control-sm cover-square cover-quiet"><Glyph name="align-left" /></span>
  <span class="cover-control cover-control-sm cover-square cover-quiet"><Glyph name="link" /></span>
</span>
