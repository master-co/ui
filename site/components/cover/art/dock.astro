---
/** Dock: a tray of glass holding four pictures that swell toward the last, under the pointer, over the tray's edge, with its name in ink above it. */
---

<span class="cover-stack" style="align-items:flex-end; --gap:20px">
  <span class="cover-tip" style="margin-right:12px"><i class="cover-bar" style="width:36px"></i></span>
  <span class="cover-float cover-line" style="--r:calc(var(--radius-control) + 8px / var(--corner-scale)); box-sizing:border-box; height:56px; padding:8px; --gap:6px; align-items:flex-end">
    <span class="cover-media" style="--r:var(--radius-control); width:40px; height:40px"><span class="cover-dot" style="--d:4px; position:absolute; bottom:-6px; left:calc(50% - 2px)"></span></span>
    <span class="cover-media" style="--r:calc(var(--radius-control) * 1.09); width:44px; height:44px"></span>
    <span class="cover-media" style="--r:calc(var(--radius-control) * 1.275); width:51px; height:51px"></span>
    <span class="cover-media" style="--r:calc(var(--radius-control) * 1.5); width:60px; height:60px"></span>
  </span>
</span>
