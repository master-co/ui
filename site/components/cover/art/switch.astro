---
/** Switch: two settings rows on a sheet, one on (ink) and one off. */
---

<span class="cover-sheet cover-stack" style="width:192px; --gap:0">
  <span class="cover-line" style="justify-content:space-between; padding:15px 16px">
    <span class="cover-stack">
      <i class="cover-bar cover-bar-strong" style="width:56px"></i>
      <i class="cover-bar" style="width:88px"></i>
    </span>
    <i class="cover-switch cover-switch-on"></i>
  </span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="justify-content:space-between; padding:15px 16px">
    <span class="cover-stack">
      <i class="cover-bar cover-bar-strong" style="width:44px"></i>
      <i class="cover-bar" style="width:72px"></i>
    </span>
    <i class="cover-switch"></i>
  </span>
</span>
