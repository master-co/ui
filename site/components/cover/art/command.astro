---
import Glyph from '../Glyph.astro'
/** Command palette: a floating sheet over the dimmed page: one search field on a hairline, and commands with the keys on the first. */
---

<span class="cover-sheet" style="position:absolute; top:6px; left:-12px; width:264px; height:240px"></span>
<i class="cover-scrim"></i>
<span class="cover-float cover-stack" style="width:204px; --gap:0">
  <span class="cover-line" style="height:44px; padding:0 14px; --gap:10px; --glyph:18px; color:var(--color-text-muted)"><Glyph name="search" /><i class="cover-bar cover-bar-faint" style="width:88px"></i></span>
  <i class="cover-rule"></i>
  <span class="cover-stack" style="padding:6px; --gap:0">
    <span class="cover-row cover-row-active"><Glyph name="plus" /><i class="cover-bar cover-bar-strong" style="width:72px"></i><span class="cover-key cover-end">↵</span></span>
    <span class="cover-row"><Glyph name="copy" /><i class="cover-bar" style="width:56px"></i></span>
  </span>
</span>
