---
/** Card: a raised sheet with media 4px inside it, a title and a line of description. */
---

<span class="cover-sheet cover-stack" style="width:168px; padding:4px; --gap:0">
  <span class="cover-media" style="height:56px"></span>
  <span class="cover-stack" style="padding:14px 12px 12px">
    <i class="cover-bar cover-bar-strong" style="width:64px"></i>
    <i class="cover-bar" style="width:112px"></i>
  </span>
</span>
