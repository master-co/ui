---
import Glyph from '../Glyph.astro'
/** Chip: filter pills in two rows; the chosen one is ink and carries a check. */
---

<span class="cover-line" style="flex-wrap:wrap; justify-content:center; width:208px">
  <span class="cover-chip cover-ink"><Glyph name="check" /><i class="cover-bar" style="width:32px"></i></span>
  <span class="cover-chip"><i class="cover-bar cover-bar-strong" style="width:40px"></i></span>
  <span class="cover-chip"><i class="cover-bar cover-bar-strong" style="width:28px"></i></span>
  <span class="cover-chip"><i class="cover-bar cover-bar-strong" style="width:48px"></i></span>
  <span class="cover-chip"><i class="cover-bar cover-bar-strong" style="width:36px"></i></span>
</span>
