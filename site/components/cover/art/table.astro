---
import Glyph from '../Glyph.astro'
/** Table: three rows of data on hairlines under quiet headings; the first heading sorts, and figures line up on their end. */
---

<span class="cover-sheet cover-stack" style="width:204px; --gap:0; color:var(--color-text-muted)">
  <span class="cover-line" style="height:28px; padding:0 14px; --gap:4px"><i class="cover-bar cover-bar-faint" style="width:36px"></i><span style="--glyph:12px"><Glyph name="selector" /></span><span class="cover-end cover-line" style="justify-content:flex-end; width:52px"><i class="cover-bar cover-bar-faint" style="width:28px"></i></span><span class="cover-line" style="justify-content:flex-end; width:40px"><i class="cover-bar cover-bar-faint" style="width:24px"></i></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:30px; padding:0 14px; --gap:4px"><i class="cover-bar cover-bar-strong" style="width:64px"></i><span class="cover-end cover-line" style="justify-content:flex-end; width:52px"><i class="cover-bar" style="width:32px"></i></span><span class="cover-line" style="justify-content:flex-end; width:40px"><i class="cover-bar" style="width:20px"></i></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:30px; padding:0 14px; --gap:4px"><i class="cover-bar cover-bar-strong" style="width:48px"></i><span class="cover-end cover-line" style="justify-content:flex-end; width:52px"><i class="cover-bar" style="width:40px"></i></span><span class="cover-line" style="justify-content:flex-end; width:40px"><i class="cover-bar" style="width:28px"></i></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:30px; padding:0 14px; --gap:4px"><i class="cover-bar cover-bar-strong" style="width:72px"></i><span class="cover-end cover-line" style="justify-content:flex-end; width:52px"><i class="cover-bar" style="width:28px"></i></span><span class="cover-line" style="justify-content:flex-end; width:40px"><i class="cover-bar" style="width:24px"></i></span></span>
</span>
