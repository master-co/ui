---
import Glyph from '../Glyph.astro'
/** List: three people, each with an avatar, two lines and something at the end; the hairlines start at the text. */
---

<span class="cover-sheet cover-stack" style="--cover-surface:var(--color-surface-raised); width:204px; --gap:0; --glyph:14px; color:var(--color-text-muted)">
  <span class="cover-line" style="padding:8px 14px; --gap:12px"><i class="cover-avatar cover-avatar-photo"></i><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:64px"></i><i class="cover-bar" style="width:96px"></i></span><span class="cover-end"><span class="cover-badge"><i class="cover-bar" style="width:24px"></i></span></span></span>
  <i class="cover-rule" style="margin-left:58px"></i>
  <span class="cover-line" style="padding:8px 14px; --gap:12px"><span class="cover-avatar">MK</span><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:48px"></i><i class="cover-bar" style="width:80px"></i></span><span class="cover-end"><Glyph name="chevron-right" /></span></span>
  <i class="cover-rule" style="margin-left:58px"></i>
  <span class="cover-line" style="padding:8px 14px; --gap:12px"><span class="cover-avatar">JL</span><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:72px"></i><i class="cover-bar" style="width:64px"></i></span><span class="cover-end"><Glyph name="chevron-right" /></span></span>
</span>
