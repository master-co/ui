---
/** Masonry: pictures and notes of their own heights in four lanes, packed so no row of gaps is left, the lanes ending where they end. */
---

<span class="cover-line" style="align-items:flex-start; --gap:6px">
  <span class="cover-stack" style="width:47px; --gap:6px">
    <span class="cover-media" style="--r:var(--radius-control); height:58px"></span>
    <span class="cover-sheet cover-stack" style="--r:var(--radius-control); padding:9px 8px; --gap:6px"><i class="cover-bar cover-bar-strong" style="width:24px"></i><i class="cover-bar cover-bar-faint" style="width:30px"></i></span>
    <span class="cover-media" style="--r:var(--radius-control); height:26px"></span>
  </span>
  <span class="cover-stack" style="width:47px; --gap:6px">
    <span class="cover-media" style="--r:var(--radius-control); height:32px"></span>
    <span class="cover-media" style="--r:var(--radius-control); height:76px"></span>
  </span>
  <span class="cover-stack" style="width:47px; --gap:6px">
    <span class="cover-media" style="--r:var(--radius-control); height:44px"></span>
    <span class="cover-sheet cover-stack" style="--r:var(--radius-control); padding:9px 8px; --gap:6px"><i class="cover-bar cover-bar-faint" style="width:30px"></i><i class="cover-bar cover-bar-faint" style="width:26px"></i><i class="cover-bar cover-bar-faint" style="width:18px"></i></span>
    <span class="cover-media" style="--r:var(--radius-control); height:30px"></span>
  </span>
  <span class="cover-stack" style="width:47px; --gap:6px">
    <span class="cover-media" style="--r:var(--radius-control); height:70px"></span>
    <span class="cover-media" style="--r:var(--radius-control); height:36px"></span>
  </span>
</span>
