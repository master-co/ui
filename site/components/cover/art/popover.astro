---
/** Popover: the button that opened it, sunk while open, and a floating sheet with a title, a line and a field. */
---

<span class="cover-stack" style="align-items:flex-start; --gap:6px">
  <span class="cover-control cover-control-sm cover-pressed"><i class="cover-bar cover-bar-strong" style="width:44px"></i></span>
  <span class="cover-float cover-stack" style="--r:var(--radius-control-lg); width:176px; padding:16px; --gap:12px">
    <span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:64px"></i><i class="cover-bar" style="width:128px"></i></span>
    <span class="cover-well" style="--r:var(--radius-control-sm); height:32px"></span>
  </span>
</span>
