---
/** Carousel: one slide in view and its neighbors running off both sides, over a marker for each slide. */
---

<span class="cover-stack" style="align-items:center; --gap:14px">
  <span class="cover-line" style="--gap:12px"><span class="cover-sheet" style="flex:none; width:148px; height:88px; padding:4px"><span class="cover-media" style="display:block; height:100%"></span></span><span class="cover-sheet" style="flex:none; width:148px; height:88px; padding:4px"><span class="cover-media" style="display:block; height:100%"></span></span><span class="cover-sheet" style="flex:none; width:148px; height:88px; padding:4px"><span class="cover-media" style="display:block; height:100%"></span></span></span>
  <span class="cover-line" style="--gap:6px"><i class="cover-dot" style="--d:6px"></i><i class="cover-dot cover-ink" style="--d:6px"></i><i class="cover-dot" style="--d:6px"></i></span>
</span>
