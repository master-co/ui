---
/** Keypad: the first rows of a phone's keys, each a raised face with a large figure, running on below the stage. */
---

<span class="cover-stack" style="position:absolute; top:18px; left:26px; width:188px; --gap:8px; font-size:18px">
  <span class="cover-line"><span class="cover-sheet cover-center" style="--r:var(--radius-control-lg); flex:1; height:48px">1</span><span class="cover-sheet cover-center" style="--r:var(--radius-control-lg); flex:1; height:48px">2</span><span class="cover-sheet cover-center" style="--r:var(--radius-control-lg); flex:1; height:48px">3</span></span>
  <span class="cover-line"><span class="cover-sheet cover-center" style="--r:var(--radius-control-lg); flex:1; height:48px">4</span><span class="cover-well cover-center" style="--r:var(--radius-control-lg); flex:1; height:48px">5</span><span class="cover-sheet cover-center" style="--r:var(--radius-control-lg); flex:1; height:48px">6</span></span>
  <span class="cover-line"><span class="cover-sheet cover-center" style="--r:var(--radius-control-lg); flex:1; height:48px">7</span><span class="cover-sheet cover-center" style="--r:var(--radius-control-lg); flex:1; height:48px">8</span><span class="cover-sheet cover-center" style="--r:var(--radius-control-lg); flex:1; height:48px">9</span></span>
</span>
