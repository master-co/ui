---
import Glyph from '../Glyph.astro'
/** Bullets: four lines of what is included: a check hung before each, and a dash before the one that is not. */
---

<span class="cover-sheet cover-stack" style="width:192px; padding:16px 16px 16px 14px; --gap:12px; --glyph:14px">
  <span class="cover-line" style="--gap:10px"><Glyph name="check" /><i class="cover-bar" style="width:104px"></i></span>
  <span class="cover-line" style="--gap:10px"><Glyph name="check" /><i class="cover-bar" style="width:128px"></i></span>
  <span class="cover-line" style="--gap:10px"><Glyph name="check" /><i class="cover-bar" style="width:84px"></i></span>
  <span class="cover-line" style="--gap:10px; color:var(--color-text-muted)"><Glyph name="minus" /><i class="cover-bar cover-bar-faint" style="width:112px"></i></span>
</span>
