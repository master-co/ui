---
import Glyph from '../Glyph.astro'
/** Pager: the page before and the page after, side by side: a quiet word with its arrow over a title, the second set to the end. */
---

<span class="cover-line" style="width:212px; --gap:8px; --glyph:12px; color:var(--color-text-muted)">
  <span class="cover-flat cover-stack" style="flex:1; padding:14px 12px; --gap:10px"><span class="cover-line" style="--gap:5px"><Glyph name="chevron-left" /><i class="cover-bar cover-bar-faint" style="width:32px"></i></span><i class="cover-bar cover-bar-strong" style="width:60px"></i></span>
  <span class="cover-flat cover-stack" style="flex:1; align-items:flex-end; padding:14px 12px; --gap:10px"><span class="cover-line" style="--gap:5px"><i class="cover-bar cover-bar-faint" style="width:20px"></i><Glyph name="chevron-right" /></span><i class="cover-bar cover-bar-strong" style="width:48px"></i></span>
</span>
