---
import Glyph from '../Glyph.astro'
/** Composer: a lifted sheet in use: the words being written with their caret, over quiet tools and the send button in ink. */
---

<span class="cover-sheet cover-focus cover-stack" style="width:204px; --gap:0">
  <span class="cover-line" style="height:46px; padding:4px 16px 0; --gap:4px"><i class="cover-bar cover-bar-strong" style="width:104px"></i><i class="cover-caret"></i></span>
  <span class="cover-line" style="padding:8px; --gap:2px; --r:calc(var(--radius-surface) - 8px / var(--corner-scale))">
    <span class="cover-control cover-control-sm cover-square cover-quiet" style="--r:inherit"><Glyph name="plus" /></span>
    <span class="cover-control cover-control-sm cover-square cover-quiet" style="--r:inherit"><Glyph name="paperclip" /></span>
    <span class="cover-control cover-control-sm cover-square cover-ink cover-end" style="--r:inherit"><Glyph name="arrow-up" /></span>
  </span>
</span>
