---
import Glyph from '../Glyph.astro'
/** Poll: three answers after a vote, each filled from its start as far as its share; the chosen one has an ink contour and a check. */
---

<span class="cover-stack" style="width:196px; --gap:6px; --glyph:12px">
  <span class="cover-flat cover-chosen cover-line" style="--r:var(--radius-control); height:34px; padding:0 12px; overflow:clip; background:linear-gradient(90deg, color-mix(in oklab, var(--color-surface-inverse) 13%, transparent) 58%, transparent 0) var(--color-surface-raised)"><i class="cover-bar cover-bar-strong" style="width:56px"></i><Glyph name="check" /><span class="cover-end"><i class="cover-bar cover-bar-strong" style="width:18px"></i></span></span>
  <span class="cover-flat cover-line" style="--r:var(--radius-control); height:34px; padding:0 12px; overflow:clip; background:linear-gradient(90deg, color-mix(in oklab, var(--color-surface-inverse) 7%, transparent) 30%, transparent 0) var(--color-surface-raised)"><i class="cover-bar cover-bar-strong" style="width:44px"></i><span class="cover-end"><i class="cover-bar" style="width:18px"></i></span></span>
  <span class="cover-flat cover-line" style="--r:var(--radius-control); height:34px; padding:0 12px; overflow:clip; background:linear-gradient(90deg, color-mix(in oklab, var(--color-surface-inverse) 7%, transparent) 12%, transparent 0) var(--color-surface-raised)"><i class="cover-bar cover-bar-strong" style="width:72px"></i><span class="cover-end"><i class="cover-bar" style="width:18px"></i></span></span>
</span>
