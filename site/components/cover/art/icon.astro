---
import Glyph from '../Glyph.astro'
/** Icon: one icon in a small, a default and a large control, sized by the control that holds it. */
---

<span class="cover-line" style="--gap:12px">
  <span class="cover-control cover-control-sm cover-square"><Glyph name="bell" /></span>
  <span class="cover-control cover-square"><Glyph name="bell" /></span>
  <span class="cover-control cover-control-lg cover-square"><Glyph name="bell" /></span>
</span>
