---
import Glyph from '../Glyph.astro'
/** Tags: a focused field on a sheet that holds two values as chips, and the caret where the next one is typed. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:16px; --gap:10px">
  <i class="cover-bar cover-bar-strong" style="width:40px"></i>
  <span class="cover-well cover-focus cover-line" style="height:38px; padding:0 10px 0 6px; --gap:4px">
    <span class="cover-value"><i class="cover-bar cover-bar-strong" style="width:30px"></i><Glyph name="x" /></span>
    <span class="cover-value"><i class="cover-bar cover-bar-strong" style="width:40px"></i><Glyph name="x" /></span>
    <i class="cover-caret" style="margin-left:4px"></i>
  </span>
  <i class="cover-bar cover-bar-faint" style="width:104px"></i>
</span>
