---
import Glyph from '../Glyph.astro'
/** Select: the field as a well with its chevron, and its list open under it; the current option carries a check. */
---

<span class="cover-stack" style="width:176px; --gap:6px">
  <span class="cover-well cover-line" style="height:38px; padding:0 10px 0 12px">
    <i class="cover-bar cover-bar-strong" style="width:64px"></i>
    <span class="cover-end"><Glyph name="chevron-down" /></span>
  </span>
  <span class="cover-float cover-stack" style="--r:calc(var(--radius-control-sm) + 4px / var(--corner-scale)); padding:4px; --gap:0">
    <span class="cover-row"><i class="cover-bar" style="width:56px"></i></span>
    <span class="cover-row cover-row-checked"><i class="cover-bar cover-bar-strong" style="width:64px"></i><span class="cover-end"><Glyph name="check" /></span></span>
    <span class="cover-row"><i class="cover-bar" style="width:48px"></i></span>
  </span>
</span>
