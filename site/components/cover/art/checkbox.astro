---
/** Checkbox: three options on a sheet, the first checked: a small well filled with ink. */
---

<span class="cover-sheet cover-stack" style="width:176px; padding:18px 16px; --gap:14px">
  <span class="cover-line" style="--gap:10px"><i class="cover-check cover-check-on"></i><i class="cover-bar cover-bar-strong" style="width:88px"></i></span>
  <span class="cover-line" style="--gap:10px"><i class="cover-check"></i><i class="cover-bar" style="width:64px"></i></span>
  <span class="cover-line" style="--gap:10px"><i class="cover-check"></i><i class="cover-bar" style="width:104px"></i></span>
</span>
