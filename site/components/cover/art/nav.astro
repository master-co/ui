---
import Glyph from '../Glyph.astro'
/** Nav: a sidebar group of three destinations; the current one has risen as a small sheet. */
---

<span class="cover-sheet cover-stack" style="width:172px; padding:6px; --gap:2px">
  <span class="cover-line" style="height:24px; padding:0 8px"><i class="cover-bar cover-bar-faint" style="width:40px"></i></span>
  <span class="cover-row"><Glyph name="home" /><i class="cover-bar" style="width:56px"></i></span>
  <span class="cover-row cover-row-current"><Glyph name="user" /><i class="cover-bar cover-bar-strong" style="width:64px"></i></span>
  <span class="cover-row"><Glyph name="adjustments" /><i class="cover-bar" style="width:48px"></i></span>
</span>
