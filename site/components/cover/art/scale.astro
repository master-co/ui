---
/** Scale: a row of five numbers under a question, the fourth one chosen in ink, and the names of its two ends. */
---

<span class="cover-sheet cover-stack" style="width:204px; padding:16px; --gap:12px">
  <i class="cover-bar cover-bar-strong" style="width:128px"></i>
  <span class="cover-stack" style="--gap:7px">
    <span class="cover-line" style="--gap:4px; font-size:12px">
      <span class="cover-flat cover-center" style="--r:var(--radius-control-sm); flex:1; height:34px">1</span>
      <span class="cover-flat cover-center" style="--r:var(--radius-control-sm); flex:1; height:34px">2</span>
      <span class="cover-flat cover-center" style="--r:var(--radius-control-sm); flex:1; height:34px">3</span>
      <span class="cover-day cover-ink" style="flex:1; width:auto; height:34px">4</span>
      <span class="cover-flat cover-center" style="--r:var(--radius-control-sm); flex:1; height:34px">5</span>
    </span>
    <span class="cover-line" style="justify-content:space-between"><i class="cover-bar cover-bar-faint" style="width:36px"></i><i class="cover-bar cover-bar-faint" style="width:44px"></i></span>
  </span>
</span>
