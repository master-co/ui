---
/** Countdown: hours, minutes and seconds as figures in three small raised tiles, each with its label under it. */
---

<span class="cover-stack" style="--gap:8px">
  <span class="cover-line" style="--gap:10px; color:var(--color-text-strong); font:var(--font-weight-control) 28px/1 var(--font-family-sans); font-variant-numeric:tabular-nums; letter-spacing:-.02em">
    <span class="cover-sheet cover-center" style="--r:var(--radius-control-lg); width:56px; height:56px">04</span>
    <span class="cover-sheet cover-center" style="--r:var(--radius-control-lg); width:56px; height:56px">12</span>
    <span class="cover-sheet cover-center" style="--r:var(--radius-control-lg); width:56px; height:56px">30</span>
  </span>
  <span class="cover-line" style="--gap:10px">
    <span class="cover-center" style="width:56px"><i class="cover-bar" style="width:28px"></i></span>
    <span class="cover-center" style="width:56px"><i class="cover-bar" style="width:36px"></i></span>
    <span class="cover-center" style="width:56px"><i class="cover-bar" style="width:36px"></i></span>
  </span>
</span>
