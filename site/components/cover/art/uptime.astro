---
/** Uptime: a service's name and state over a row of days, each a quiet tick, with the two that went wrong standing out. */
---

<span class="cover-sheet cover-stack" style="width:204px; padding:16px; --gap:14px">
  <span class="cover-line" style="justify-content:space-between"><i class="cover-bar cover-bar-strong" style="width:44px"></i><span class="cover-badge"><i class="cover-dot" style="--d:6px"></i><i class="cover-bar" style="width:36px"></i></span></span>
  <span class="cover-line" style="--gap:2px">
    <i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick" style="--tone:62%"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick" style="--tone:100%"></i><i class="cover-tick" style="--tone:62%"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i><i class="cover-tick"></i>
  </span>
  <span class="cover-line" style="justify-content:space-between"><i class="cover-bar cover-bar-faint" style="width:36px"></i><i class="cover-bar cover-bar-faint" style="width:28px"></i></span>
</span>
