---
/** Range: a label and its two values over one thin well, filled with ink between the two pearl thumbs. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:18px 18px 24px; --gap:20px">
  <span class="cover-line"><i class="cover-bar cover-bar-strong" style="width:40px"></i><span class="cover-end cover-line" style="--gap:5px"><i class="cover-bar" style="width:18px"></i><i class="cover-bar cover-bar-faint" style="width:8px"></i><i class="cover-bar" style="width:18px"></i></span></span>
  <span class="cover-track cover-span" style="--from:26%; --to:72%"><i class="cover-knob" style="--fill:26%"></i><i class="cover-knob" style="--fill:72%"></i></span>
</span>
