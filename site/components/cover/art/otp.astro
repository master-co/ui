---
/** OTP: four slots under a label; two hold a digit, the third has focus and the last waits. */
---

<span class="cover-sheet cover-stack" style="padding:14px 12px 12px; --gap:12px">
  <i class="cover-bar cover-bar-strong" style="width:56px"></i>
  <span class="cover-line">
    <span class="cover-well cover-center" style="width:40px; height:44px; font-size:18px">4</span>
    <span class="cover-well cover-center" style="width:40px; height:44px; font-size:18px">7</span>
    <span class="cover-well cover-focus cover-center" style="width:40px; height:44px"><i class="cover-caret"></i></span>
    <span class="cover-well" style="width:40px; height:44px"></span>
  </span>
</span>
