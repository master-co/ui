---
import Glyph from '../Glyph.astro'
/** Tab bar: the bottom of a small screen: three destinations as an icon over a label, the current one in ink on a soft pill. */
---

<span class="cover-sheet cover-stack" style="position:absolute; top:-80px; bottom:6px; left:24px; width:192px; justify-content:flex-end; overflow:hidden; --r:1.5rem; --gap:0">
  <span class="cover-stack" style="padding:0 16px 18px"><i class="cover-bar cover-bar-faint cover-bar-figure" style="width:88px"></i><span class="cover-stack" style="padding-top:6px"><i class="cover-bar cover-bar-faint" style="width:160px"></i><i class="cover-bar cover-bar-faint" style="width:120px"></i></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:56px; padding:0 4px; --gap:0">
    <span class="cover-stack" style="flex:1; align-items:center; --gap:4px"><span class="cover-pill cover-pill-current"><Glyph name="home" /></span><i class="cover-bar cover-bar-strong" style="width:24px"></i></span><span class="cover-stack" style="flex:1; align-items:center; --gap:4px"><span class="cover-pill"><Glyph name="search" /></span><i class="cover-bar" style="width:28px"></i></span><span class="cover-stack" style="flex:1; align-items:center; --gap:4px"><span class="cover-pill"><Glyph name="user" /></span><i class="cover-bar" style="width:20px"></i></span>
  </span>
</span>
