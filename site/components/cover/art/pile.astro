---
/** Pile: one card with a title and a line, and the edges of two more sheets under it, each narrower and fainter. */
---

<span class="cover-stack" style="position:relative; width:196px; padding-bottom:12px; --gap:0">
  <span class="cover-sheet" style="position:absolute; inset:16px 16px 0; opacity:.5; background:var(--color-surface-raised-low); box-shadow:var(--shadow-flat)"></span>
  <span class="cover-sheet" style="position:absolute; inset:16px 8px 6px; opacity:.8; background:var(--color-surface-raised-low); box-shadow:var(--shadow-flat)"></span>
  <span class="cover-sheet cover-line" style="padding:18px 16px; --gap:12px">
    <span class="cover-stack" style="--gap:9px"><i class="cover-bar cover-bar-strong" style="width:96px"></i><i class="cover-bar" style="width:72px"></i></span>
    <span class="cover-end cover-badge"><i class="cover-bar" style="width:12px"></i></span>
  </span>
</span>
