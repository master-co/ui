---
import Glyph from '../Glyph.astro'
/** Combobox: a focused field with what was typed, and the matches under it with the keys on the first. */
---

<span class="cover-stack" style="width:184px; --gap:6px">
  <span class="cover-well cover-focus cover-line" style="height:40px; padding:0 10px 0 12px; --gap:4px">
    <i class="cover-bar cover-bar-strong" style="width:36px"></i>
    <i class="cover-caret"></i>
    <span class="cover-end"><Glyph name="chevron-up" /></span>
  </span>
  <span class="cover-float cover-stack" style="--r:calc(var(--radius-control-sm) + 4px / var(--corner-scale)); padding:4px; --gap:0">
    <span class="cover-row cover-row-active"><i class="cover-bar cover-bar-strong" style="width:72px"></i></span>
    <span class="cover-row"><i class="cover-bar" style="width:96px"></i></span>
  </span>
</span>
