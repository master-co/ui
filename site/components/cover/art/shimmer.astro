---
/** Shimmer: a spinner and a line of words on a sheet; the words are quiet at both ends and strong where the light is passing. */
---

<span class="cover-sheet cover-line" style="padding:18px 20px 18px 18px; --gap:12px">
  <i class="cover-spinner" style="--d:16px; color:var(--color-text-muted)"></i>
  <span class="cover-line" style="--gap:5px">
    <i class="cover-bar cover-bar-faint" style="width:22px"></i>
    <i class="cover-bar" style="width:30px"></i>
    <i class="cover-bar cover-bar-strong" style="width:38px"></i>
    <i class="cover-bar" style="width:18px"></i>
    <i class="cover-bar cover-bar-faint" style="width:26px"></i>
  </span>
</span>
