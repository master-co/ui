---
/** Breakdown: a whole as parts along one bar, in steps of ink with a well for what is left, and its legend under it. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:16px; --gap:14px">
  <span class="cover-line" style="justify-content:space-between"><i class="cover-bar cover-bar-strong" style="width:56px"></i><i class="cover-bar" style="width:36px"></i></span>
  <span class="cover-line" style="--gap:2px">
    <i class="cover-part" style="--w:42"></i>
    <i class="cover-part" style="--w:26; --tone:60%"></i>
    <i class="cover-part" style="--w:14; --tone:36%"></i>
    <i class="cover-part" style="--w:6; --tone:21%"></i>
    <i class="cover-part cover-well" style="--w:30"></i>
  </span>
  <span class="cover-line" style="flex-wrap:wrap; --gap:10px 14px">
    <span class="cover-line" style="--gap:6px"><i class="cover-legend"></i><i class="cover-bar" style="width:32px"></i></span>
    <span class="cover-line" style="--gap:6px"><i class="cover-legend" style="--tone:60%"></i><i class="cover-bar" style="width:24px"></i></span>
    <span class="cover-line" style="--gap:6px"><i class="cover-legend" style="--tone:36%"></i><i class="cover-bar" style="width:28px"></i></span>
    <span class="cover-line" style="--gap:6px"><i class="cover-legend" style="--tone:21%"></i><i class="cover-bar" style="width:36px"></i></span>
    <span class="cover-line" style="--gap:6px"><i class="cover-legend cover-well"></i><i class="cover-bar" style="width:24px"></i></span>
  </span>
</span>
