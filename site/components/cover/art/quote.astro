---
/** Quote: three lines hanging from a soft rail, and under them who said it, the name in ink. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:20px 16px; --gap:0">
  <span class="cover-quote cover-stack" style="--gap:14px">
    <span class="cover-stack" style="--gap:10px"><i class="cover-bar cover-bar-strong" style="width:144px"></i><i class="cover-bar cover-bar-strong" style="width:152px"></i><i class="cover-bar cover-bar-strong" style="width:96px"></i></span>
    <span class="cover-line"><i class="cover-bar" style="width:40px"></i><i class="cover-bar cover-bar-faint" style="width:56px"></i></span>
  </span>
</span>
