---
/** Table of contents: a column of links on a hairline rail under its caption; the section in view is ink with a mark on the rail. */
---

<span class="cover-sheet cover-stack" style="width:176px; padding:16px 16px 14px; --gap:10px">
  <i class="cover-bar cover-bar-faint" style="width:64px"></i>
  <span class="cover-rail cover-stack" style="--gap:0">
    <span class="cover-line" style="height:24px; padding-left:14px"><i class="cover-bar" style="width:72px"></i></span><span class="cover-line cover-rail-current" style="height:24px; padding-left:14px"><i class="cover-bar cover-bar-strong" style="width:96px"></i></span><span class="cover-line" style="height:24px; padding-left:28px"><i class="cover-bar" style="width:60px"></i></span><span class="cover-line" style="height:24px; padding-left:14px"><i class="cover-bar" style="width:80px"></i></span>
  </span>
</span>
