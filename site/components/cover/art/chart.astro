---
/** Chart: a week of bars standing on their baseline, tinted, with the one that matters in ink, and a name under each. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:16px 16px 14px; --gap:0">
  <span class="cover-line" style="align-items:flex-end; height:80px; --gap:6px">
    <i class="cover-column" style="--h:46%"></i>
    <i class="cover-column" style="--h:64%"></i>
    <i class="cover-column" style="--h:38%"></i>
    <i class="cover-column cover-ink" style="--h:92%"></i>
    <i class="cover-column" style="--h:74%"></i>
    <i class="cover-column" style="--h:28%"></i>
    <i class="cover-column" style="--h:20%"></i>
  </span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="justify-content:space-around; padding-top:10px; --gap:6px">
    <i class="cover-bar cover-bar-faint" style="width:12px"></i>
    <i class="cover-bar cover-bar-faint" style="width:12px"></i>
    <i class="cover-bar cover-bar-faint" style="width:12px"></i>
    <i class="cover-bar cover-bar-strong" style="width:12px"></i>
    <i class="cover-bar cover-bar-faint" style="width:12px"></i>
    <i class="cover-bar cover-bar-faint" style="width:12px"></i>
    <i class="cover-bar cover-bar-faint" style="width:12px"></i>
  </span>
</span>
