---
/** Citation: two lines of a sentence on a sheet, each claim followed by its small numbered mark; the one being read is ink. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:20px 18px; --gap:14px">
  <span class="cover-line" style="--gap:5px"><i class="cover-bar" style="width:52px"></i><i class="cover-bar" style="width:68px"></i><span class="cover-cite">1</span></span>
  <span class="cover-line" style="--gap:5px"><i class="cover-bar" style="width:36px"></i><i class="cover-bar" style="width:44px"></i><span class="cover-cite cover-ink">2</span><i class="cover-bar" style="width:28px"></i></span>
  <span class="cover-line" style="--gap:5px"><i class="cover-bar" style="width:72px"></i><i class="cover-bar" style="width:24px"></i></span>
</span>
