---
/** Data list: four facts about one thing; terms in one column, and every value starts on the same edge. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:4px 16px; --gap:0">
  <span class="cover-line" style="height:30px; --gap:0"><span style="width:76px"><i class="cover-bar cover-bar-faint" style="width:40px"></i></span><i class="cover-bar cover-bar-strong" style="width:72px"></i></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:30px; --gap:0"><span style="width:76px"><i class="cover-bar cover-bar-faint" style="width:56px"></i></span><i class="cover-bar cover-bar-strong" style="width:48px"></i></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:30px; --gap:0"><span style="width:76px"><i class="cover-bar cover-bar-faint" style="width:32px"></i></span><i class="cover-bar cover-bar-strong" style="width:88px"></i></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:30px; --gap:0"><span style="width:76px"><i class="cover-bar cover-bar-faint" style="width:48px"></i></span><i class="cover-bar cover-bar-strong" style="width:40px"></i></span>
</span>
