---
import Glyph from '../Glyph.astro'
/** Trace: four steps on one line: two that open, one of them open on its detail, and the one that is running in ink. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:10px 14px 10px 12px; --gap:0; --glyph:12px; color:var(--color-text-muted)">
  <span class="cover-line" style="height:26px; --gap:8px"><span class="cover-center" style="width:20px"><i class="cover-dot" style="--d:6px"></i></span><i class="cover-bar" style="width:76px"></i><Glyph name="chevron-right" /><span class="cover-end"><i class="cover-bar cover-bar-faint" style="width:14px"></i></span></span>
  <span class="cover-line" style="height:26px; --gap:8px"><span class="cover-center" style="width:20px"><i class="cover-dot" style="--d:6px"></i></span><i class="cover-bar" style="width:56px"></i><Glyph name="chevron-down" /><span class="cover-end"><i class="cover-bar cover-bar-faint" style="width:24px"></i></span></span>
  <span class="cover-line" style="align-items:stretch; --gap:8px"><span class="cover-center" style="width:20px"><i class="cover-rule cover-rule-upright" style="height:100%; margin:0"></i></span><span class="cover-stack" style="padding:2px 0 8px; --gap:6px"><i class="cover-bar cover-bar-faint" style="width:132px"></i><i class="cover-bar cover-bar-faint" style="width:88px"></i></span></span>
  <span class="cover-line" style="height:26px; --gap:8px"><span class="cover-center" style="width:20px"><i class="cover-dot" style="--d:6px"></i></span><i class="cover-bar" style="width:64px"></i><span class="cover-end"><i class="cover-bar cover-bar-faint" style="width:18px"></i></span></span>
  <span class="cover-line" style="height:26px; --gap:8px"><span class="cover-center" style="width:20px"><i class="cover-dot cover-ink" style="--d:6px; box-shadow:0 0 0 3px color-mix(in oklab, var(--color-text-strong) 12%, transparent)"></i></span><i class="cover-bar cover-bar-strong" style="width:84px"></i></span>
</span>
