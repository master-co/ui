---
import Glyph from '../Glyph.astro'
/** Breadcrumb: three steps of a path between chevrons; the last, where you are, is strong. */
---

<span class="cover-sheet cover-line" style="height:46px; padding:0 16px; --gap:6px; --glyph:14px; color:var(--color-text-muted)">
  <i class="cover-bar" style="width:28px"></i><Glyph name="chevron-right" /><i class="cover-bar" style="width:40px"></i><Glyph name="chevron-right" /><i class="cover-bar cover-bar-strong" style="width:48px"></i>
</span>
