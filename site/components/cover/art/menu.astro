---
import Glyph from '../Glyph.astro'
/** Menu: the button that opened it, sunk while open, and a floating list with the pointer on its first row. */
---

<span class="cover-stack" style="align-items:flex-start; --gap:6px">
  <span class="cover-control cover-control-sm cover-pressed" style="padding-right:8px"><i class="cover-bar cover-bar-strong" style="width:40px"></i><Glyph name="chevron-down" /></span>
  <span class="cover-float cover-stack" style="--r:calc(var(--radius-control-sm) + 4px / var(--corner-scale)); width:164px; padding:4px; --gap:0">
    <span class="cover-row cover-row-active"><Glyph name="pencil" /><i class="cover-bar cover-bar-strong" style="width:48px"></i></span>
    <span class="cover-row"><Glyph name="copy" /><i class="cover-bar" style="width:72px"></i></span>
    <span class="cover-row"><Glyph name="archive" /><i class="cover-bar" style="width:56px"></i></span>
  </span>
</span>
