---
import Glyph from '../Glyph.astro'
/** Accordion: three rows on hairlines; the first is open to its panel and the others are closed. */
---

<span class="cover-sheet cover-stack" style="width:200px; --gap:0; --glyph:14px; color:var(--color-text-muted)">
  <span class="cover-line" style="height:38px; padding:0 14px 0 16px"><i class="cover-bar cover-bar-strong" style="width:72px"></i><span class="cover-end"><Glyph name="chevron-up" /></span></span>
  <span class="cover-stack" style="padding:0 16px 14px"><i class="cover-bar" style="width:152px"></i><i class="cover-bar" style="width:108px"></i></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:38px; padding:0 14px 0 16px"><i class="cover-bar cover-bar-strong" style="width:56px"></i><span class="cover-end"><Glyph name="chevron-down" /></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:38px; padding:0 14px 0 16px"><i class="cover-bar cover-bar-strong" style="width:88px"></i><span class="cover-end"><Glyph name="chevron-down" /></span></span>
</span>
