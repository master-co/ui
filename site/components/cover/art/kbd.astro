---
/** Kbd: two commands and their shortcuts as raised keycaps at the end of each row. */
---

<span class="cover-sheet cover-stack" style="width:196px; --gap:0">
  <span class="cover-line" style="height:40px; padding:0 12px 0 16px"><i class="cover-bar cover-bar-strong" style="width:56px"></i><span class="cover-end cover-line" style="--gap:4px"><span class="cover-key">⌘</span><span class="cover-key">K</span></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:40px; padding:0 12px 0 16px"><i class="cover-bar cover-bar-strong" style="width:72px"></i><span class="cover-end cover-line" style="--gap:4px"><span class="cover-key">⇧</span><span class="cover-key">⌘</span><span class="cover-key">P</span></span></span>
</span>
