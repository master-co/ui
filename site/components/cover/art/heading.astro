---
/** Heading: a short line over a title of two large lines, and the paragraph under it. */
---

<span class="cover-sheet cover-stack" style="width:204px; padding:18px 18px 20px; --gap:0">
  <i class="cover-bar cover-bar-faint" style="width:44px"></i>
  <span class="cover-stack" style="padding:12px 0 14px; --gap:7px"><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:148px"></i><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:104px"></i></span>
  <span class="cover-stack"><i class="cover-bar" style="width:164px"></i><i class="cover-bar" style="width:120px"></i></span>
</span>
