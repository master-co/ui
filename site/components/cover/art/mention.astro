---
/** Mention: a sentence on a sheet with one name in it, set apart on a faint tint with no edge. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:20px 18px; --gap:12px">
  <span class="cover-line" style="--gap:6px">
    <span class="cover-tone cover-skeleton cover-line" style="--r:calc(var(--radius-chip) - 2px); height:18px; padding:0 6px"><i class="cover-bar cover-bar-strong" style="width:52px"></i></span>
    <i class="cover-bar" style="width:36px"></i>
    <i class="cover-bar" style="width:44px"></i>
  </span>
  <span class="cover-line" style="--gap:6px"><i class="cover-bar" style="width:64px"></i><i class="cover-bar" style="width:28px"></i><i class="cover-bar" style="width:48px"></i></span>
  <span class="cover-line" style="--gap:6px"><i class="cover-bar" style="width:40px"></i></span>
</span>
