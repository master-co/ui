---
/** Tabs: three words on one hairline, the current one underlined in ink, over the panel they switch. */
---

<span class="cover-sheet cover-stack" style="width:200px; --gap:0">
  <span class="cover-line" style="height:42px; padding:0 16px; --gap:20px; box-shadow:inset 0 -1px 0 var(--color-line-divider)">
    <span class="cover-tab cover-tab-current"><i class="cover-bar cover-bar-strong" style="width:36px"></i></span>
    <span class="cover-tab"><i class="cover-bar" style="width:44px"></i></span>
    <span class="cover-tab"><i class="cover-bar" style="width:28px"></i></span>
  </span>
  <span class="cover-stack" style="padding:18px 16px 20px; --gap:10px">
    <i class="cover-bar cover-bar-faint" style="width:144px"></i>
    <i class="cover-bar cover-bar-faint" style="width:112px"></i>
    <i class="cover-bar cover-bar-faint" style="width:128px"></i>
  </span>
</span>
