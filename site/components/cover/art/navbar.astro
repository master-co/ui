---
/** Navbar: the top of a page: its brand, two links and an action on one bar, over a hairline and the content under it. */
---

<span class="cover-sheet cover-stack" style="position:absolute; top:10px; left:-12px; width:264px; height:240px; overflow:hidden; --gap:0">
  <span class="cover-line" style="height:56px; padding:0 28px; --gap:16px">
    <i class="cover-bar cover-bar-strong" style="width:52px"></i>
    <span class="cover-end cover-line" style="--gap:16px"><i class="cover-bar" style="width:28px"></i><i class="cover-bar" style="width:32px"></i></span>
    <span class="cover-control cover-control-sm cover-ink"><i class="cover-bar" style="width:28px"></i></span>
  </span>
  <i class="cover-rule"></i>
  <span class="cover-stack" style="padding:22px 28px; --gap:10px"><i class="cover-bar cover-bar-faint cover-bar-figure" style="width:112px"></i><span class="cover-stack" style="padding-top:6px"><i class="cover-bar cover-bar-faint" style="width:184px"></i><i class="cover-bar cover-bar-faint" style="width:148px"></i></span></span>
</span>
