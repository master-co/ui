---
import Glyph from '../Glyph.astro'
/** Panel: two floating panels over the work, one folded to its header behind, the other in front with its header, its body and its resize corner. */
---

<span style="position:relative; display:block; width:208px; height:128px">
  <span class="cover-float cover-line" style="position:absolute; top:0; left:0; width:148px; height:44px; --r:calc(var(--radius-control-sm) + 6px / var(--corner-scale)); padding:6px 6px 6px 12px; --gap:2px">
    <i class="cover-bar cover-bar-strong" style="width:40px"></i>
    <span class="cover-control cover-control-sm cover-square cover-pressed" style="margin-left:auto"><Glyph name="minus" /></span>
    <span class="cover-control cover-control-sm cover-square cover-quiet"><Glyph name="x" /></span>
  </span>
  <span class="cover-float cover-stack" style="position:absolute; top:22px; left:40px; width:168px; overflow:clip; --r:calc(var(--radius-control-sm) + 6px / var(--corner-scale)); --gap:0">
    <span class="cover-line" style="height:44px; padding:6px 6px 6px 12px; --gap:2px">
      <i class="cover-bar cover-bar-strong" style="width:52px"></i>
      <span class="cover-control cover-control-sm cover-square cover-quiet" style="margin-left:auto"><Glyph name="minus" /></span>
      <span class="cover-control cover-control-sm cover-square cover-quiet"><Glyph name="x" /></span>
    </span>
    <i class="cover-rule"></i>
    <span class="cover-stack" style="padding:12px 12px 14px; --gap:10px">
      <i class="cover-bar" style="width:112px"></i>
      <i class="cover-bar" style="width:84px"></i>
      <i class="cover-bar" style="width:100px"></i>
    </span>
    <i class="cover-resize"></i>
  </span>
</span>
