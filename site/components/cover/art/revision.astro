---
/** Revision: three lines of a sentence in which one phrase is struck and the words that replace it lie on a wash over an underline. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:16px; --gap:6px">
  <span class="cover-line" style="height:18px"><i class="cover-bar" style="width:52px"></i><i class="cover-bar cover-bar-struck" style="width:40px; margin-inline:3px"></i><span class="cover-mark cover-mark-inserted"><i class="cover-bar cover-bar-strong" style="width:48px"></i></span></span>
  <span class="cover-line" style="height:18px"><i class="cover-bar" style="width:140px"></i></span>
  <span class="cover-line" style="height:18px"><i class="cover-bar" style="width:36px"></i><span class="cover-mark cover-mark-inserted"><i class="cover-bar cover-bar-strong" style="width:64px"></i></span><i class="cover-bar" style="width:28px"></i></span>
</span>
