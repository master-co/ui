---
/** Dialog: a floating sheet over the page it dims, with a title, two lines and its two actions. */
---

<span class="cover-sheet" style="position:absolute; top:6px; left:-12px; width:264px; height:240px"></span>
<i class="cover-scrim"></i>
<span class="cover-float cover-stack" style="--r:1.25rem; width:184px; padding:18px 18px 16px; --gap:18px">
  <span class="cover-stack" style="--gap:10px">
    <i class="cover-bar cover-bar-strong" style="width:80px"></i>
    <i class="cover-bar" style="width:148px"></i>
    <i class="cover-bar" style="width:104px"></i>
  </span>
  <span class="cover-line" style="justify-content:flex-end">
    <span class="cover-control cover-control-sm"><i class="cover-bar cover-bar-strong" style="width:32px"></i></span>
    <span class="cover-control cover-control-sm cover-ink"><i class="cover-bar" style="width:40px"></i></span>
  </span>
</span>
