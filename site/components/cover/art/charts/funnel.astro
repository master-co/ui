---
/** Funnel chart: four stages of one flow, each narrowing to the next and a step lighter than the one before. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:14px 16px; --gap:0">
  <svg class="cover-plot" viewBox="0 0 164 96" style="width:164px; height:96px">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" width="164" height="96" style="overflow:visible">
      <path class="cover-plot-shape" d="M0 0.7H100L79 24.3H21Z" />
      <path class="cover-plot-shape" style="--tone:79%" d="M21 25.7H79L67 49.3H33Z" />
      <path class="cover-plot-shape" style="--tone:59%" d="M33 50.7H67L58 74.3H42Z" />
      <path class="cover-plot-shape" style="--tone:38%" d="M42 75.7H58L58 99.3H42Z" />
    </svg>
  </svg>
</span>
