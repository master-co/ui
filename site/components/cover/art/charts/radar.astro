  <svg class="cover-plot" viewBox="-44 -44 88 88" style="width:112px; height:112px">
    <path class="cover-plot-hair" d="M0 -10L8.66 -5L8.66 5L0 10L-8.66 5L-8.66 -5ZM0 -20L17.32 -10L17.32 10L0 20L-17.32 10L-17.32 -10ZM0 -30L25.98 -15L25.98 15L0 30L-25.98 15L-25.98 -15ZM0 -40L34.64 -20L34.64 20L0 40L-34.64 20L-34.64 -20ZM0 0L0 -40M0 0L34.64 -20M0 0L34.64 20M0 0L0 40M0 0L-34.64 20M0 0L-34.64 -20" />
    <path class="cover-plot-line" style="--tone:36%; --w:1.5px" d="M0 -23.2L29.1 -16.8L21.48 12.4L0 32L-17.32 10L-26.33 -15.2Z" />
    <path class="cover-plot-shape" style="--tone:12%" d="M0 -34.4L24.25 -14L31.87 18.4L0 24L-27.02 15.6L-22.17 -12.8Z" />
    <path class="cover-plot-line" d="M0 -34.4L24.25 -14L31.87 18.4L0 24L-27.02 15.6L-22.17 -12.8Z" />
