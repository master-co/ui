---
/** Donut chart: four slices of a ring in steps of ink, a figure and what it counts in the middle, and the legend beside it. */
---

<span class="cover-sheet cover-line" style="width:196px; padding:16px; align-items:center; --gap:18px">
  <span style="position:relative; display:block; flex:none; width:92px; height:92px">
    <svg class="cover-plot" viewBox="-50 -50 100 100" style="width:92px; height:92px">
      <path class="cover-plot-shape" d="M0.55 -48.143A1.8 1.8 0 0 1 2.438 -49.941A50 50 0 0 1 14.781 47.765A1.8 1.8 0 0 1 12.505 46.493L9.417 34.464A1.8 1.8 0 0 1 10.599 32.306A34 34 0 0 0 2.232 -33.927A1.8 1.8 0 0 1 0.55 -35.723Z" />
      <path class="cover-plot-shape" style="--tone:60%" d="M11.44 46.767A1.8 1.8 0 0 1 10.059 48.978A50 50 0 0 1 -49.241 8.678A1.8 1.8 0 0 1 -47.694 6.58L-35.372 5.023A1.8 1.8 0 0 1 -33.379 6.466A34 34 0 0 0 6.275 33.416A1.8 1.8 0 0 1 8.351 34.737Z" />
      <path class="cover-plot-shape" style="--tone:36%" d="M-47.832 5.488A1.8 1.8 0 0 1 -49.852 3.841A50 50 0 0 1 -31.327 -38.97A1.8 1.8 0 0 1 -28.743 -38.625L-21.442 -28.577A1.8 1.8 0 0 1 -21.747 -26.135A34 34 0 0 0 -33.939 2.038A1.8 1.8 0 0 1 -35.51 3.932Z" />
      <path class="cover-plot-shape" style="--tone:21%" d="M-27.853 -39.272A1.8 1.8 0 0 1 -27.382 -41.836A50 50 0 0 1 -2.438 -49.941A1.8 1.8 0 0 1 -0.55 -48.143L-0.55 -35.723A1.8 1.8 0 0 1 -2.232 -33.927A34 34 0 0 0 -18.136 -28.759A1.8 1.8 0 0 1 -20.552 -29.224Z" />
    </svg>
    <span style="position:absolute; inset:0; display:grid; place-content:center; justify-items:center; gap:6px">
      <i class="cover-bar cover-bar-strong" style="width:30px"></i>
      <i class="cover-bar cover-bar-faint" style="width:20px"></i>
    </span>
  </span>
  <span class="cover-stack" style="--gap:9px">
    <span class="cover-line" style="--gap:6px"><i class="cover-legend"></i><i class="cover-bar" style="width:34px"></i></span>
    <span class="cover-line" style="--gap:6px"><i class="cover-legend" style="--tone:60%"></i><i class="cover-bar" style="width:26px"></i></span>
    <span class="cover-line" style="--gap:6px"><i class="cover-legend" style="--tone:36%"></i><i class="cover-bar" style="width:30px"></i></span>
    <span class="cover-line" style="--gap:6px"><i class="cover-legend" style="--tone:21%"></i><i class="cover-bar" style="width:22px"></i></span>
  </span>
</span>
