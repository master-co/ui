---
/** Pie chart: a circle of four slices in steps of ink, parted by a gap, with the legend that names them beside it. */
---

<span class="cover-sheet cover-line" style="width:196px; padding:16px; align-items:center; --gap:18px">
  <svg class="cover-plot" viewBox="-50 -50 100 100" style="width:92px; height:92px">
    <path class="cover-plot-shape" d="M0.55 -48.143A1.8 1.8 0 0 1 2.438 -49.941A50 50 0 0 1 14.781 47.765A1.8 1.8 0 0 1 12.505 46.493L0.55 -0.069Z" />
    <path class="cover-plot-shape" style="--tone:60%" d="M11.44 46.767A1.8 1.8 0 0 1 10.059 48.978A50 50 0 0 1 -49.241 8.678A1.8 1.8 0 0 1 -47.694 6.58L-0.412 0.606Z" />
    <path class="cover-plot-shape" style="--tone:36%" d="M-47.832 5.488A1.8 1.8 0 0 1 -49.852 3.841A50 50 0 0 1 -31.327 -38.97A1.8 1.8 0 0 1 -28.743 -38.625L-0.992 -0.429Z" />
    <path class="cover-plot-shape" style="--tone:21%" d="M-27.853 -39.272A1.8 1.8 0 0 1 -27.382 -41.836A50 50 0 0 1 -2.438 -49.941A1.8 1.8 0 0 1 -0.55 -48.143L-0.55 -1.693Z" />
  </svg>
  <span class="cover-stack" style="--gap:9px">
    <span class="cover-line" style="--gap:6px"><i class="cover-legend"></i><i class="cover-bar" style="width:34px"></i></span>
    <span class="cover-line" style="--gap:6px"><i class="cover-legend" style="--tone:60%"></i><i class="cover-bar" style="width:26px"></i></span>
    <span class="cover-line" style="--gap:6px"><i class="cover-legend" style="--tone:36%"></i><i class="cover-bar" style="width:30px"></i></span>
    <span class="cover-line" style="--gap:6px"><i class="cover-legend" style="--tone:21%"></i><i class="cover-bar" style="width:22px"></i></span>
  </span>
</span>
