---
/** Slope chart: four straight lines from one moment to the next, one in ink that rises past the others, with a knot at each end. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:16px; --gap:0">
  <svg class="cover-plot" viewBox="0 0 164 92" style="width:164px; height:92px">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" width="164" height="92" style="overflow:visible">
      <path class="cover-plot-line" d="M0 43.4L100 8.2" />
      <path class="cover-plot-line" style="--w:6px" d="M0 43.4h0" />
      <path class="cover-plot-line" style="--w:6px" d="M100 8.2h0" />
      <path class="cover-plot-line" style="--tone:60%" d="M0 17L100 28" />
      <path class="cover-plot-line" style="--tone:60%; --w:6px" d="M0 17h0" />
      <path class="cover-plot-line" style="--tone:60%; --w:6px" d="M100 28h0" />
      <path class="cover-plot-line" style="--tone:36%" d="M0 61L100 56.6" />
      <path class="cover-plot-line" style="--tone:36%; --w:6px" d="M0 61h0" />
      <path class="cover-plot-line" style="--tone:36%; --w:6px" d="M100 56.6h0" />
      <path class="cover-plot-line" style="--tone:21%" d="M0 72L100 85.2" />
      <path class="cover-plot-line" style="--tone:21%; --w:6px" d="M0 72h0" />
      <path class="cover-plot-line" style="--tone:21%; --w:6px" d="M100 85.2h0" />
    </svg>
  </svg>
</span>
