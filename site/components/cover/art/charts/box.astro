---
/** Box plot: three boxes of ink, each cut by its median, with whiskers to its lowest and highest reading and one reading far out as a small dot. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:18px 16px 14px; --gap:0">
  <svg class="cover-plot" viewBox="0 0 164 78" style="width:164px; height:78px">
    <path class="cover-plot-hair" d="M0 78H164M0 58.5H164M0 39H164M0 19.5H164M0 0H164" />
    <path class="cover-plot-line" style="--tone:40%; --w:1.5px" d="M27.33 62.4L27.33 37.44" />
    <rect class="cover-plot-shape" x="15.85" y="46.02" width="22.96" height="8.97" rx="1.5" />
    <path class="cover-plot-line" style="--tone:0%; --w:1.5px" d="M15.85 51.09L38.81 51.09" />
    <path class="cover-plot-line" style="--tone:40%; --w:1.5px" d="M82 51.48L82 23.4" />
    <rect class="cover-plot-shape" x="70.52" y="29.64" width="22.96" height="12.48" rx="1.5" />
    <path class="cover-plot-line" style="--tone:0%; --w:1.5px" d="M70.52 35.88L93.48 35.88" />
    <circle class="cover-plot-shape" cx="82" cy="3.12" r="1.5" />
    <path class="cover-plot-line" style="--tone:40%; --w:1.5px" d="M136.67 67.08L136.67 42.12" />
    <rect class="cover-plot-shape" x="125.19" y="50.7" width="22.96" height="8.58" rx="1.5" />
    <path class="cover-plot-line" style="--tone:0%; --w:1.5px" d="M125.19 54.6L148.15 54.6" />
  </svg>
  <i class="cover-rule"></i>
  <span class="cover-line" style="justify-content:space-around; padding-top:10px">
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
  </span>
</span>
