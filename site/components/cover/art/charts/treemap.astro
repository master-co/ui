---
/** Treemap: tiles of one wash, the largest first and each as large as its share, with a bar for the name on those that hold one. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:14px 16px; --gap:0">
  <svg class="cover-plot" viewBox="0 0 164 96" style="width:164px; height:96px">
    <rect class="cover-plot-shape" style="--tone:14%" x="1" y="1" width="64.04" height="94" rx="2" />
    <rect class="cover-plot-shape" style="--tone:14%" x="67.04" y="1" width="59.64" height="56.29" rx="2" />
    <rect class="cover-plot-shape" style="--tone:14%" x="67.04" y="59.29" width="59.64" height="35.71" rx="2" />
    <rect class="cover-plot-shape" style="--tone:14%" x="128.68" y="1" width="34.32" height="38.73" rx="2" />
    <rect class="cover-plot-shape" style="--tone:14%" x="128.68" y="41.73" width="34.32" height="24.18" rx="2" />
    <rect class="cover-plot-shape" style="--tone:14%" x="128.68" y="67.91" width="19.79" height="27.09" rx="2" />
    <rect class="cover-plot-shape" style="--tone:14%" x="150.47" y="67.91" width="12.53" height="27.09" rx="2" />
  </svg>
</span>
