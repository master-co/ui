---
/** Bump chart: four lines through their ranks, each in its category's hue, crossing where one overtakes another, with a knot at each rank. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:18px 18px; --gap:0">
  <svg class="cover-plot" viewBox="0 0 164 86" style="width:164px; height:86px">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" width="164" height="86" style="overflow:visible">
      <path class="cover-plot-line cover-hue-1" d="M0 62.5C12.5 62.5 12.5 62.5 25 62.5C37.5 62.5 37.5 12.5 50 12.5C62.5 12.5 62.5 12.5 75 12.5C87.5 12.5 87.5 12.5 100 12.5" />
      <path class="cover-plot-line cover-hue-1" style="--w:6px" d="M0 62.5h0" />
      <path class="cover-plot-line cover-hue-1" style="--w:6px" d="M25 62.5h0" />
      <path class="cover-plot-line cover-hue-1" style="--w:6px" d="M50 12.5h0" />
      <path class="cover-plot-line cover-hue-1" style="--w:6px" d="M75 12.5h0" />
      <path class="cover-plot-line cover-hue-1" style="--w:6px" d="M100 12.5h0" />
      <path class="cover-plot-line cover-hue-2" d="M0 12.5C12.5 12.5 12.5 37.5 25 37.5C37.5 37.5 37.5 62.5 50 62.5C62.5 62.5 62.5 62.5 75 62.5C87.5 62.5 87.5 37.5 100 37.5" />
      <path class="cover-plot-line cover-hue-2" style="--w:6px" d="M0 12.5h0" />
      <path class="cover-plot-line cover-hue-2" style="--w:6px" d="M25 37.5h0" />
      <path class="cover-plot-line cover-hue-2" style="--w:6px" d="M50 62.5h0" />
      <path class="cover-plot-line cover-hue-2" style="--w:6px" d="M75 62.5h0" />
      <path class="cover-plot-line cover-hue-2" style="--w:6px" d="M100 37.5h0" />
      <path class="cover-plot-line cover-hue-3" d="M0 37.5C12.5 37.5 12.5 12.5 25 12.5C37.5 12.5 37.5 37.5 50 37.5C62.5 37.5 62.5 37.5 75 37.5C87.5 37.5 87.5 62.5 100 62.5" />
      <path class="cover-plot-line cover-hue-3" style="--w:6px" d="M0 37.5h0" />
      <path class="cover-plot-line cover-hue-3" style="--w:6px" d="M25 12.5h0" />
      <path class="cover-plot-line cover-hue-3" style="--w:6px" d="M50 37.5h0" />
      <path class="cover-plot-line cover-hue-3" style="--w:6px" d="M75 37.5h0" />
      <path class="cover-plot-line cover-hue-3" style="--w:6px" d="M100 62.5h0" />
      <path class="cover-plot-line cover-hue-4" d="M0 87.5C12.5 87.5 12.5 87.5 25 87.5C37.5 87.5 37.5 87.5 50 87.5C62.5 87.5 62.5 87.5 75 87.5C87.5 87.5 87.5 87.5 100 87.5" />
      <path class="cover-plot-line cover-hue-4" style="--w:6px" d="M0 87.5h0" />
      <path class="cover-plot-line cover-hue-4" style="--w:6px" d="M25 87.5h0" />
      <path class="cover-plot-line cover-hue-4" style="--w:6px" d="M50 87.5h0" />
      <path class="cover-plot-line cover-hue-4" style="--w:6px" d="M75 87.5h0" />
      <path class="cover-plot-line cover-hue-4" style="--w:6px" d="M100 87.5h0" />
    </svg>
  </svg>
</span>
