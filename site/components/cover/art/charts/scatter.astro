---
/** Scatter plot: dots of two series on the hairlines of two scales, each in its category's hue, rising together. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:18px 16px 14px; --gap:0">
  <svg class="cover-plot" viewBox="0 0 164 78" style="width:164px; height:78px">
    <path class="cover-plot-hair" d="M0 0H164M0 26H164M0 52H164M41 0V78M82 0V78M123 0V78" />
    <circle class="cover-plot-shape cover-hue-2" cx="30" cy="34" r="3.5" /><circle class="cover-plot-shape cover-hue-2" cx="52" cy="40" r="3.5" /><circle class="cover-plot-shape cover-hue-2" cx="70" cy="26" r="3.5" /><circle class="cover-plot-shape cover-hue-2" cx="96" cy="22" r="3.5" /><circle class="cover-plot-shape cover-hue-2" cx="118" cy="12" r="3.5" /><circle class="cover-plot-shape cover-hue-2" cx="146" cy="8" r="3.5" />
    <circle class="cover-plot-shape cover-hue-1" cx="14" cy="66" r="3.5" /><circle class="cover-plot-shape cover-hue-1" cx="34" cy="58" r="3.5" /><circle class="cover-plot-shape cover-hue-1" cx="58" cy="60" r="3.5" /><circle class="cover-plot-shape cover-hue-1" cx="80" cy="46" r="3.5" /><circle class="cover-plot-shape cover-hue-1" cx="104" cy="44" r="3.5" /><circle class="cover-plot-shape cover-hue-1" cx="128" cy="32" r="3.5" /><circle class="cover-plot-shape cover-hue-1" cx="150" cy="26" r="3.5" />
  </svg>
  <i class="cover-rule"></i>
  <span class="cover-line" style="justify-content:space-between; padding-top:10px">
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
  </span>
</span>
