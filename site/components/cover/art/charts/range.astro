---
/** Range chart: bars that float between a low and a high value, rising and falling across the months, with no end on the baseline. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:18px 16px 14px; --gap:0">
  <svg class="cover-plot" viewBox="0 0 164 78" style="width:164px; height:78px">
    <path class="cover-plot-hair" d="M0 78H164M0 52H164M0 26H164M0 0H164" />
    <rect class="cover-plot-shape" x="4.51" y="52" width="11.48" height="20.8" rx="2" />
    <rect class="cover-plot-shape" x="25.01" y="41.6" width="11.48" height="23.4" rx="2" />
    <rect class="cover-plot-shape" x="45.51" y="26" width="11.48" height="26" rx="2" />
    <rect class="cover-plot-shape" x="66.01" y="10.4" width="11.48" height="26" rx="2" />
    <rect class="cover-plot-shape" x="86.51" y="0" width="11.48" height="26" rx="2" />
    <rect class="cover-plot-shape" x="107.01" y="10.4" width="11.48" height="23.4" rx="2" />
    <rect class="cover-plot-shape" x="127.51" y="28.6" width="11.48" height="23.4" rx="2" />
    <rect class="cover-plot-shape" x="148.01" y="46.8" width="11.48" height="20.8" rx="2" />
  </svg>
  <i class="cover-rule"></i>
  <span class="cover-line" style="justify-content:space-between; padding-top:10px">
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
  </span>
</span>
