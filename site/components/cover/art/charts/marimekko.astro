---
/** Marimekko chart: four columns as wide as their totals, each split into the same three categories, each in its hue. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:18px 16px 14px; --gap:0">
  <svg class="cover-plot" viewBox="0 0 164 78" style="width:164px; height:78px">
    <rect class="cover-plot-shape cover-hue-3" x="0" y="0" width="65.66" height="16.42" rx="2" />
    <rect class="cover-plot-shape cover-hue-2" x="0" y="16.42" width="65.66" height="28.74" rx="2" />
    <rect class="cover-plot-shape cover-hue-1" x="0" y="45.16" width="65.66" height="32.84" rx="2" />
    <rect class="cover-plot-shape cover-hue-3" x="67.63" y="0" width="44.92" height="18" rx="2" />
    <rect class="cover-plot-shape cover-hue-2" x="67.63" y="18" width="44.92" height="33" rx="2" />
    <rect class="cover-plot-shape cover-hue-1" x="67.63" y="51" width="44.92" height="27" rx="2" />
    <rect class="cover-plot-shape cover-hue-3" x="114.52" y="0" width="39.74" height="10.17" rx="2" />
    <rect class="cover-plot-shape cover-hue-2" x="114.52" y="10.17" width="39.74" height="23.74" rx="2" />
    <rect class="cover-plot-shape cover-hue-1" x="114.52" y="33.91" width="39.74" height="44.09" rx="2" />
    <rect class="cover-plot-shape cover-hue-3" x="156.22" y="0" width="7.78" height="17.33" rx="2" />
    <rect class="cover-plot-shape cover-hue-2" x="156.22" y="17.33" width="7.78" height="26" rx="2" />
    <rect class="cover-plot-shape cover-hue-1" x="156.22" y="43.33" width="7.78" height="34.67" rx="2" />
  </svg>
  <i class="cover-rule"></i>
  <span class="cover-line" style="justify-content:space-between; padding-top:10px">
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
  </span>
</span>
