---
/** Waterfall chart: an opening bar in ink, steps up and down that float from where the last left off, joined by hairlines, and a closing bar in ink. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:18px 16px 14px; --gap:0">
  <svg class="cover-plot" viewBox="0 0 164 78" style="width:164px; height:78px">
    <path class="cover-plot-hair" d="M0 78H164M0 58.5H164M0 39H164M0 19.5H164M0 0H164" />
    <rect class="cover-plot-shape" x="5.19" y="33.15" width="16.95" height="44.85" rx="2" />
    <rect class="cover-plot-shape" style="--tone:60%" x="32.53" y="3.9" width="16.95" height="29.25" rx="2" />
    <rect class="cover-plot-shape" style="--tone:30%" x="59.86" y="3.9" width="16.95" height="17.55" rx="2" />
    <rect class="cover-plot-shape" style="--tone:30%" x="87.19" y="21.45" width="16.95" height="25.35" rx="2" />
    <rect class="cover-plot-shape" style="--tone:60%" x="114.53" y="25.35" width="16.95" height="21.45" rx="2" />
    <rect class="cover-plot-shape" x="141.86" y="25.35" width="16.95" height="52.65" rx="2" />
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" width="164" height="78" style="overflow:visible">
      <path class="cover-plot-hair" d="M13.5 42.5H19.83M30.17 5H36.5M46.83 27.5H53.17M63.5 60H69.83M80.17 32.5H86.5" />
    </svg>
  </svg>
  <i class="cover-rule"></i>
  <span class="cover-line" style="justify-content:space-between; padding-top:10px">
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
  </span>
</span>
