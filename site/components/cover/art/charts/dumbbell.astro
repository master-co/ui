---
/** Dumbbell chart: five rows, each a stem between a dot stepped back and a dot in ink, so the gap between them is what is read. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:16px; --gap:0">
  <svg class="cover-plot" viewBox="0 0 164 92" style="width:164px; height:92px">
    <path class="cover-plot-line" style="--tone:40%; --w:1.5px" d="M54.67 9.2L94.76 9.2" />
    <circle class="cover-plot-shape" style="--tone:60%" cx="54.67" cy="9.2" r="3" />
    <circle class="cover-plot-shape" cx="94.76" cy="9.2" r="3" />
    <path class="cover-plot-line" style="--tone:40%; --w:1.5px" d="M83.82 27.6L145.78 27.6" />
    <circle class="cover-plot-shape" style="--tone:60%" cx="83.82" cy="27.6" r="3" />
    <circle class="cover-plot-shape" cx="145.78" cy="27.6" r="3" />
    <path class="cover-plot-line" style="--tone:40%; --w:1.5px" d="M72.89 46L112.98 46" />
    <circle class="cover-plot-shape" style="--tone:60%" cx="72.89" cy="46" r="3" />
    <circle class="cover-plot-shape" cx="112.98" cy="46" r="3" />
    <path class="cover-plot-line" style="--tone:40%; --w:1.5px" d="M32.8 64.4L54.67 64.4" />
    <circle class="cover-plot-shape" style="--tone:60%" cx="32.8" cy="64.4" r="3" />
    <circle class="cover-plot-shape" cx="54.67" cy="64.4" r="3" />
    <path class="cover-plot-line" style="--tone:40%; --w:1.5px" d="M47.38 82.8L83.82 82.8" />
    <circle class="cover-plot-shape" style="--tone:60%" cx="47.38" cy="82.8" r="3" />
    <circle class="cover-plot-shape" cx="83.82" cy="82.8" r="3" />
  </svg>
</span>
