---
/** Area chart: one series as an ink line with a wash under it that fades out toward the baseline. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:18px 16px 14px; --gap:0">
  <svg class="cover-plot" viewBox="0 0 100 100" preserveAspectRatio="none" style="width:164px; height:78px">
    <path class="cover-plot-hair" d="M0 0H100M0 33.3H100M0 66.6H100" />
    <path class="cover-plot-wash" d="M0 70C5.56 62 11.11 54 16.67 54C22.22 54 27.78 60 33.33 60C38.89 60 44.44 38 50 38C55.56 38 61.11 44 66.67 44C72.22 44 77.78 25.33 83.33 20C88.89 14.67 94.44 13.33 100 12L100 100L0 100Z" />
    <path class="cover-plot-line" d="M0 70C5.56 62 11.11 54 16.67 54C22.22 54 27.78 60 33.33 60C38.89 60 44.44 38 50 38C55.56 38 61.11 44 66.67 44C72.22 44 77.78 25.33 83.33 20C88.89 14.67 94.44 13.33 100 12" />
  </svg>
  <i class="cover-rule"></i>
  <span class="cover-line" style="justify-content:space-between; padding-top:10px">
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
  </span>
</span>
