---
/** Line chart: two series over the hairlines of a scale, one in ink and one stepped back, with the names of the steps under the baseline. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:18px 16px 14px; --gap:0">
  <svg class="cover-plot" viewBox="0 0 100 100" preserveAspectRatio="none" style="width:164px; height:78px">
    <path class="cover-plot-hair" d="M0 0H100M0 33.3H100M0 66.6H100" />
    <path class="cover-plot-line" style="--tone:36%" d="M0 80C5.56 77.67 11.11 75.33 16.67 72C22.22 68.67 27.78 60 33.33 60C38.89 60 44.44 66 50 66C55.56 66 61.11 54 66.67 54C72.22 54 77.78 58 83.33 58C88.89 58 94.44 52 100 46" />
    <path class="cover-plot-line" d="M0 66C5.56 57 11.11 48 16.67 48C22.22 48 27.78 56 33.33 56C38.89 56 44.44 32 50 32C55.56 32 61.11 40 66.67 40C72.22 40 77.78 18 83.33 18C88.89 18 94.44 21 100 24" />
  </svg>
  <i class="cover-rule"></i>
  <span class="cover-line" style="justify-content:space-between; padding-top:10px">
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
  </span>
</span>
