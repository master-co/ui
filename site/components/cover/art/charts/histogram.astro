---
/** Histogram: bins that touch, rising to a peak and falling away to one side, on the hairlines of a scale. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:18px 16px 14px; --gap:0">
  <svg class="cover-plot" viewBox="0 0 164 78" style="width:164px; height:78px">
    <path class="cover-plot-hair" d="M0 78H164M0 58.5H164M0 39H164M0 19.5H164M0 0H164" />
    <rect class="cover-plot-shape" x="0.75" y="69" width="16.72" height="8.25" rx="2" />
    <rect class="cover-plot-shape" x="18.97" y="59.25" width="16.72" height="18" rx="2" />
    <rect class="cover-plot-shape" x="37.19" y="39.75" width="16.72" height="37.5" rx="2" />
    <rect class="cover-plot-shape" x="55.42" y="20.25" width="16.72" height="57" rx="2" />
    <rect class="cover-plot-shape" x="73.64" y="0.75" width="16.72" height="76.5" rx="2" />
    <rect class="cover-plot-shape" x="91.86" y="30" width="16.72" height="47.25" rx="2" />
    <rect class="cover-plot-shape" x="110.08" y="49.5" width="16.72" height="27.75" rx="2" />
    <rect class="cover-plot-shape" x="128.31" y="59.25" width="16.72" height="18" rx="2" />
    <rect class="cover-plot-shape" x="146.53" y="69" width="16.72" height="8.25" rx="2" />
  </svg>
  <i class="cover-rule"></i>
  <span class="cover-line" style="justify-content:space-between; padding-top:10px">
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
    <i class="cover-bar cover-bar-faint" style="width:14px"></i>
  </span>
</span>
