---
/** Rings: three readings, each a ring inside the one before in its category's hue, filled from the top with round ends on a track of the same hue. */
---

<span class="cover-sheet cover-center" style="width:168px; padding:16px">
  <svg class="cover-plot" viewBox="-50 -50 100 100" style="width:100px; height:100px">
    <path class="cover-plot-line cover-hue-1" style="--tone:16%; --w:8px" d="M0 -46A46 46 0 1 1 0 46A46 46 0 1 1 0 -46" />
    <path class="cover-plot-line cover-hue-1" style="--w:8px" d="M3.995 -45.826A46 46 0 1 1 -44.266 12.511" />
    <path class="cover-plot-line cover-hue-2" style="--tone:16%; --w:8px" d="M0 -35.6A35.6 35.6 0 1 1 0 35.6A35.6 35.6 0 1 1 0 -35.6" />
    <path class="cover-plot-line cover-hue-2" style="--w:8px" d="M3.992 -35.376A35.6 35.6 0 0 1 14.728 32.411" />
    <path class="cover-plot-line cover-hue-3" style="--tone:16%; --w:8px" d="M0 -25.2A25.2 25.2 0 1 1 0 25.2A25.2 25.2 0 1 1 0 -25.2" />
    <path class="cover-plot-line cover-hue-3" style="--w:8px" d="M3.983 -24.883A25.2 25.2 0 1 1 -19.937 -15.412" />
  </svg>
</span>
