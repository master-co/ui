---
/** Segmented control: a well holding three options; the current one has risen as a sheet. */
---

<span class="cover-sheet" style="padding:14px">
  <span class="cover-well cover-line" style="--r:calc(var(--radius-control-sm) + 4px / var(--corner-scale)); padding:4px; --gap:2px">
    <span class="cover-row cover-row-current" style="height:30px; padding:0 12px"><i class="cover-bar cover-bar-strong" style="width:32px"></i></span>
    <span class="cover-row" style="height:30px; padding:0 12px"><i class="cover-bar" style="width:36px"></i></span>
    <span class="cover-row" style="height:30px; padding:0 12px"><i class="cover-bar" style="width:28px"></i></span>
  </span>
</span>
