---
/** Rating: a review on a sheet: who wrote it, four stars of five in ink, and two lines. */
---

<span class="cover-sheet cover-stack" style="--cover-surface:var(--color-surface-raised); width:196px; padding:16px; --gap:14px">
  <span class="cover-line" style="--gap:12px">
    <i class="cover-avatar cover-avatar-photo"></i>
    <span class="cover-stack">
      <i class="cover-bar cover-bar-strong" style="width:64px"></i>
      <span class="cover-line" style="--gap:2px"><i class="cover-star cover-ink"></i><i class="cover-star cover-ink"></i><i class="cover-star cover-ink"></i><i class="cover-star cover-ink"></i><i class="cover-star"></i></span>
    </span>
  </span>
  <span class="cover-stack"><i class="cover-bar" style="width:156px"></i><i class="cover-bar" style="width:112px"></i></span>
</span>
