---
/** Swatch: four discs under a label, the cover palette's own hues; the chosen one, the first, stands in a ring. */
---

<span class="cover-sheet cover-stack" style="--cover-surface:var(--color-surface-raised); padding:18px 20px 22px; --gap:16px">
  <i class="cover-bar cover-bar-strong" style="width:48px"></i>
  <span class="cover-line" style="--gap:14px"><i class="cover-swatch cover-swatch-on cover-hue-1"></i><i class="cover-swatch cover-hue-2"></i><i class="cover-swatch cover-hue-3"></i><i class="cover-swatch cover-hue-4"></i></span>
</span>
