---
/** Swatch: five discs under a label, as steps of ink since a cover holds no hue; the chosen one stands in a ring. */
---

<span class="cover-sheet cover-stack" style="--cover-surface:var(--color-surface-raised); padding:18px 20px 22px; --gap:16px">
  <i class="cover-bar cover-bar-strong" style="width:48px"></i>
  <span class="cover-line" style="--gap:12px"><i class="cover-swatch" style="--swatch:color-mix(in oklch, var(--color-text-strong) 8%, var(--color-surface-raised))"></i><i class="cover-swatch" style="--swatch:color-mix(in oklch, var(--color-text-strong) 28%, var(--color-surface-raised))"></i><i class="cover-swatch cover-swatch-on" style="--swatch:color-mix(in oklch, var(--color-text-strong) 52%, var(--color-surface-raised))"></i><i class="cover-swatch" style="--swatch:color-mix(in oklch, var(--color-text-strong) 76%, var(--color-surface-raised))"></i><i class="cover-swatch" style="--swatch:color-mix(in oklch, var(--color-text-strong) 100%, var(--color-surface-raised))"></i></span>
</span>
