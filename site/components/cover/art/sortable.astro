---
import Glyph from '../Glyph.astro'
/** Sortable: a list on a sheet with a grip on each row; the carried row floats over it and the rows below have made room. */
---

<span class="cover-sheet cover-stack" style="position:relative; width:196px; padding:6px 14px; --gap:0; --glyph:14px; color:var(--color-text-muted)">
  <span class="cover-line" style="height:32px; --gap:8px"><Glyph name="grip" /><i class="cover-bar cover-bar-strong" style="width:72px"></i></span>
  <i class="cover-rule"></i>
  <span style="height:32px"></span>
  <i class="cover-rule" style="opacity:0"></i>
  <span class="cover-line" style="height:32px; --gap:8px"><Glyph name="grip" /><i class="cover-bar cover-bar-strong" style="width:56px"></i></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:32px; --gap:8px"><Glyph name="grip" /><i class="cover-bar cover-bar-strong" style="width:88px"></i></span>
  <span class="cover-float cover-line" style="--r:var(--radius-control); position:absolute; left:4px; right:-12px; top:30px; height:36px; padding:0 10px; --gap:8px; color:var(--color-text-strong)"><Glyph name="grip" /><i class="cover-bar cover-bar-strong" style="width:64px"></i></span>
</span>
