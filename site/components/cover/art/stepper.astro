---
import Glyph from '../Glyph.astro'
/** Stepper: a setting's row with its number in a well, between the two small buttons that step it. */
---

<span class="cover-sheet cover-line" style="padding:14px 14px 14px 20px; --gap:24px">
  <i class="cover-bar cover-bar-strong" style="width:40px"></i>
  <span class="cover-well cover-line" style="height:38px; padding:0 4px; --gap:4px">
    <span class="cover-control cover-square" style="--r:calc(var(--radius-control) - 4px / var(--corner-scale)); --glyph:14px; height:30px"><Glyph name="minus" /></span>
    <span class="cover-center" style="width:40px; font-size:14px; font-weight:var(--font-weight-control)">4</span>
    <span class="cover-control cover-square" style="--r:calc(var(--radius-control) - 4px / var(--corner-scale)); --glyph:14px; height:30px"><Glyph name="plus" /></span>
  </span>
</span>
