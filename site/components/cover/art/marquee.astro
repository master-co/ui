---
/** Marquee: two rows of small cards passing in opposite directions, each fading out at both ends of the stage. */
---

<span class="cover-stack cover-fade-inline" style="align-items:center; width:240px; overflow:hidden; --gap:10px">
  <span class="cover-line" style="translate:-18px 0; --gap:10px"><span class="cover-flat cover-stack" style="flex:none; width:84px; padding:12px; --gap:8px"><i class="cover-bar cover-bar-strong" style="width:48px"></i><i class="cover-bar" style="width:36px"></i></span><span class="cover-flat cover-stack" style="flex:none; width:84px; padding:12px; --gap:8px"><i class="cover-bar cover-bar-strong" style="width:40px"></i><i class="cover-bar" style="width:56px"></i></span><span class="cover-flat cover-stack" style="flex:none; width:84px; padding:12px; --gap:8px"><i class="cover-bar cover-bar-strong" style="width:52px"></i><i class="cover-bar" style="width:32px"></i></span><span class="cover-flat cover-stack" style="flex:none; width:84px; padding:12px; --gap:8px"><i class="cover-bar cover-bar-strong" style="width:36px"></i><i class="cover-bar" style="width:48px"></i></span></span>
  <span class="cover-line" style="translate:26px 0; --gap:10px"><span class="cover-flat cover-stack" style="flex:none; width:84px; padding:12px; --gap:8px"><i class="cover-bar cover-bar-strong" style="width:40px"></i><i class="cover-bar" style="width:52px"></i></span><span class="cover-flat cover-stack" style="flex:none; width:84px; padding:12px; --gap:8px"><i class="cover-bar cover-bar-strong" style="width:56px"></i><i class="cover-bar" style="width:36px"></i></span><span class="cover-flat cover-stack" style="flex:none; width:84px; padding:12px; --gap:8px"><i class="cover-bar cover-bar-strong" style="width:44px"></i><i class="cover-bar" style="width:44px"></i></span><span class="cover-flat cover-stack" style="flex:none; width:84px; padding:12px; --gap:8px"><i class="cover-bar cover-bar-strong" style="width:32px"></i><i class="cover-bar" style="width:56px"></i></span></span>
</span>
