---
/** Thread: a comment and the two replies under it, joined to its avatar by a line that turns into each of them. */
---

<span class="cover-sheet cover-stack" style="--cover-surface:var(--color-surface-raised); width:204px; padding:14px 16px 16px 14px; --gap:0">
  <span class="cover-line" style="align-items:flex-start; --gap:10px"><span class="cover-avatar" style="--d:28px">AL</span><span class="cover-stack" style="padding-top:5px"><i class="cover-bar cover-bar-strong" style="width:56px"></i><i class="cover-bar" style="width:124px"></i></span></span>
  <span class="cover-line" style="align-items:flex-start; height:38px; padding-left:13.5px; --gap:4px"><i class="cover-elbow" style="width:21px; height:26px; margin-top:4px"></i><span class="cover-line" style="align-items:flex-start; padding-top:18px; --gap:8px"><span class="cover-avatar" style="--d:22px">JT</span><span class="cover-stack" style="padding-top:3px; --gap:6px"><i class="cover-bar cover-bar-strong" style="width:44px"></i></span></span></span>
  <span class="cover-line" style="align-items:flex-start; padding-left:13.5px; --gap:4px"><i class="cover-elbow" style="width:21px; height:36px; margin-top:-10px"></i><span class="cover-line" style="align-items:flex-start; padding-top:14px; --gap:8px"><span class="cover-avatar" style="--d:22px">MK</span><span class="cover-stack" style="padding-top:3px; --gap:6px"><i class="cover-bar cover-bar-strong" style="width:52px"></i><i class="cover-bar" style="width:88px"></i></span></span></span>
</span>
