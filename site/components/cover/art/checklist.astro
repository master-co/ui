---
/** Checklist: three steps on a sheet; two are checked, their titles struck through, and the count stands under the last. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:16px; --gap:12px">
  <span class="cover-line" style="--gap:10px"><i class="cover-check cover-check-on"></i><i class="cover-bar cover-bar-struck" style="width:84px"></i></span>
  <span class="cover-line" style="--gap:10px"><i class="cover-check cover-check-on"></i><i class="cover-bar cover-bar-struck" style="width:64px"></i></span>
  <span class="cover-line" style="--gap:10px"><i class="cover-check"></i><i class="cover-bar cover-bar-strong" style="width:100px"></i></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="--gap:6px"><i class="cover-bar cover-bar-strong" style="width:18px"></i><i class="cover-bar cover-bar-faint" style="width:52px"></i></span>
</span>
