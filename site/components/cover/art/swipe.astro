---
import Glyph from '../Glyph.astro'
/** Swipe: three rows on a sheet; the middle one has slid aside and uncovered its two actions in a well. */
---

<span class="cover-sheet cover-stack" style="--cover-surface:var(--color-surface-raised); width:204px; overflow:clip; --gap:0">
  <span class="cover-line" style="height:44px; padding:0 14px; --gap:12px"><span class="cover-avatar">AL</span><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:64px"></i><i class="cover-bar" style="width:96px"></i></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="align-items:stretch; height:44px; background:var(--color-surface-inset); box-shadow:inset 0 1px 2px -1px var(--color-shade-2); --gap:0">
    <span class="cover-line" style="flex:1; margin-left:-36px; padding:0 14px; background:var(--color-surface-raised); box-shadow:0 0 0 .5px var(--color-line-contour), 0 0 6px -1px var(--color-shade-1), 0 0 12px -2px var(--color-shade-2); --gap:12px"><span class="cover-avatar">JT</span><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:48px"></i><i class="cover-bar" style="width:72px"></i></span></span>
    <span class="cover-action" style="border:0"><Glyph name="archive" /></span>
    <span class="cover-action"><Glyph name="trash" /></span>
  </span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:44px; padding:0 14px; --gap:12px"><span class="cover-avatar">MK</span><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:72px"></i><i class="cover-bar" style="width:64px"></i></span></span>
</span>
