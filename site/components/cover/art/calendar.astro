<span class="cover-sheet cover-stack" style="position:absolute; top:8px; left:10px; padding:8px; --gap:0">
  <span class="cover-line" style="height:32px; padding:0 13px"><i class="cover-bar cover-bar-strong" style="width:72px"></i></span>
  <span class="cover-line" style="--gap:0"><span class="cover-center" style="width:36px; height:24px"><i class="cover-bar cover-bar-faint" style="width:12px"></i></span><span class="cover-center" style="width:36px; height:24px"><i class="cover-bar cover-bar-faint" style="width:12px"></i></span><span class="cover-center" style="width:36px; height:24px"><i class="cover-bar cover-bar-faint" style="width:12px"></i></span><span class="cover-center" style="width:36px; height:24px"><i class="cover-bar cover-bar-faint" style="width:12px"></i></span><span class="cover-center" style="width:36px; height:24px"><i class="cover-bar cover-bar-faint" style="width:12px"></i></span><span class="cover-center" style="width:36px; height:24px"><i class="cover-bar cover-bar-faint" style="width:12px"></i></span><span class="cover-center" style="width:36px; height:24px"><i class="cover-bar cover-bar-faint" style="width:12px"></i></span></span>
