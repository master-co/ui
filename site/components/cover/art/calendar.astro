  <span class="cover-line" style="--gap:0"><span class="cover-day"><i class="cover-bar" style="width:6px"></i></span><span class="cover-day"><i class="cover-bar" style="width:10px"></i></span><span class="cover-day cover-ink"><i class="cover-bar" style="width:10px"></i></span><span class="cover-day"><i class="cover-bar" style="width:10px"></i></span><span class="cover-day"><i class="cover-bar" style="width:10px"></i></span><span class="cover-day"><i class="cover-bar" style="width:10px"></i></span><span class="cover-day"><i class="cover-bar" style="width:10px"></i></span></span>
