---
/** Category: a legend of three categories, each a dot and its name; the dots are steps of ink, since a cover holds no hue. */
---

<span class="cover-sheet cover-stack" style="width:176px; padding:18px 18px 20px; --gap:14px">
  <span class="cover-line" style="--gap:10px"><i class="cover-dot" style="--d:8px; background:var(--color-text-strong)"></i><i class="cover-bar cover-bar-strong" style="width:72px"></i></span>
  <span class="cover-line" style="--gap:10px"><i class="cover-dot" style="--d:8px; background:color-mix(in oklch, var(--color-text-strong) 55%, var(--color-surface-raised))"></i><i class="cover-bar cover-bar-strong" style="width:96px"></i></span>
  <span class="cover-line" style="--gap:10px"><i class="cover-dot" style="--d:8px; background:color-mix(in oklch, var(--color-text-strong) 25%, var(--color-surface-raised))"></i><i class="cover-bar cover-bar-strong" style="width:56px"></i></span>
</span>
