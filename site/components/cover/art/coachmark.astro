---
import Glyph from '../Glyph.astro'
/** Coachmark: a card of ink over a toolbar, its arrow pointing down at the beacon on the middle control. */
---

<span class="cover-stack" style="align-items:center; --gap:0">
  <span class="cover-sheet cover-ink cover-stack" style="--r:calc(var(--radius-control-sm) + 12px / var(--corner-scale)); width:168px; padding:14px 12px 12px 16px; --gap:7px">
    <i class="cover-bar" style="width:24px; opacity:.6"></i>
    <i class="cover-bar" style="width:80px"></i>
    <i class="cover-bar" style="width:116px; opacity:.76"></i>
    <span class="cover-line" style="justify-content:flex-end; padding-top:5px"><span class="cover-control cover-control-sm" style="--cover-bar:initial"><i class="cover-bar cover-bar-strong" style="width:24px"></i></span></span>
  </span>
  <span class="cover-ink" style="display:block; width:10px; height:10px; margin-top:-5px; rotate:45deg"></span>
  <span class="cover-sheet cover-line" style="--r:calc(var(--radius-control-sm) + 4px / var(--corner-scale)); padding:4px; --gap:2px; margin:7px 28px 0 0">
    <span class="cover-control cover-control-sm cover-square cover-quiet"><Glyph name="search" /></span>
    <span class="cover-control cover-control-sm cover-square cover-quiet"><Glyph name="adjustments" /><span class="cover-dot cover-ink" style="--d:10px; position:absolute; top:-3px; right:-3px"></span></span>
    <span class="cover-control cover-control-sm cover-square cover-quiet"><Glyph name="upload" /></span>
  </span>
</span>
