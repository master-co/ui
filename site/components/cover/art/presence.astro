---
/** Presence: a board on a sheet, two notes on it, and another person's pointer over it with their name in a flag of ink. */
---

<span class="cover-sheet" style="position:relative; display:block; width:208px; height:124px">
  <span class="cover-tone cover-stack" style="position:absolute; top:18px; left:18px; width:76px; padding:12px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:40px"></i><i class="cover-bar" style="width:52px"></i><i class="cover-bar" style="width:32px"></i></span>
  <span class="cover-tone cover-stack" style="position:absolute; top:46px; left:112px; width:76px; padding:12px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:28px"></i><i class="cover-bar" style="width:48px"></i></span>
  <span style="position:absolute; top:70px; left:70px">
    <i class="cover-pointer" style="top:-2px; left:-2px"></i>
    <span class="cover-badge cover-ink" style="position:absolute; top:17px; left:12px; height:18px; padding:0 6px"><i class="cover-bar" style="width:30px"></i></span>
  </span>
</span>
