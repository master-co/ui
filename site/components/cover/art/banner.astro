---
import Glyph from '../Glyph.astro'
/** Banner: one line across the top of a page: a band of the tray tone with its news, a way to close it, and the page under it. */
---

<span class="cover-sheet cover-stack" style="position:absolute; top:10px; left:-12px; width:264px; height:240px; overflow:hidden; --gap:0">
  <span class="cover-band cover-line" style="height:40px; padding:0 26px; --gap:8px; color:var(--color-text-strong)">
    <Glyph name="info" /><i class="cover-bar cover-bar-strong" style="width:104px"></i><i class="cover-bar" style="width:36px"></i>
    <span class="cover-end" style="--glyph:14px; color:var(--color-text-muted)"><Glyph name="x" /></span>
  </span>
  <span class="cover-stack" style="padding:24px 28px; --gap:10px"><i class="cover-bar cover-bar-faint cover-bar-figure" style="width:112px"></i><span class="cover-stack" style="padding-top:6px"><i class="cover-bar cover-bar-faint" style="width:184px"></i><i class="cover-bar cover-bar-faint" style="width:148px"></i><i class="cover-bar cover-bar-faint" style="width:168px"></i></span></span>
</span>
