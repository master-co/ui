---
import Glyph from '../Glyph.astro'
/** Toast: two brief messages stacked over the page, each a floating sheet with an icon, its words and a way to close it. */
---

<span class="cover-stack" style="width:204px">
  <span class="cover-float cover-line" style="--r:var(--radius-control-lg); align-items:flex-start; padding:12px 14px; --gap:10px">
    <Glyph name="circle-check" />
    <span class="cover-stack" style="padding-top:5px"><i class="cover-bar cover-bar-strong" style="width:72px"></i><i class="cover-bar" style="width:104px"></i></span>
    <span class="cover-end" style="--glyph:14px; color:var(--color-text-muted)"><Glyph name="x" /></span>
  </span>
  <span class="cover-float cover-line" style="--r:var(--radius-control-lg); padding:12px 14px; --gap:10px">
    <Glyph name="info" />
    <i class="cover-bar cover-bar-strong" style="width:88px"></i>
    <span class="cover-end" style="--glyph:14px; color:var(--color-text-muted)"><Glyph name="x" /></span>
  </span>
</span>
