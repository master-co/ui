---
/** Breakout: a plan of an article whose words keep a narrow column, a picture a little wider than it, and a band that runs to both edges. */
---

<span class="cover-sheet cover-plan cover-stack" style="width:208px; height:130px; padding:13px 0 0; align-items:center; --gap:7px">
  <span class="cover-stack" style="width:96px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:64px"></i><i class="cover-bar cover-bar-faint" style="width:96px"></i><i class="cover-bar cover-bar-faint" style="width:80px"></i></span>
  <span class="cover-media" style="--r:var(--radius-chip); width:136px; height:28px; margin-block:2px"></span>
  <span class="cover-stack" style="width:96px; --gap:7px"><i class="cover-bar cover-bar-faint" style="width:92px"></i><i class="cover-bar cover-bar-faint" style="width:70px"></i></span>
  <span class="cover-tone cover-skeleton cover-line" style="--r:0px; align-self:stretch; height:26px; justify-content:center; margin-block:2px">
    <span class="cover-line" style="width:96px; --gap:12px"><i class="cover-bar cover-bar-strong" style="width:22px"></i><i class="cover-bar cover-bar-strong" style="width:18px"></i><i class="cover-bar cover-bar-strong" style="width:24px"></i></span>
  </span>
  <span class="cover-stack" style="width:96px; --gap:7px"><i class="cover-bar cover-bar-faint" style="width:88px"></i></span>
</span>
