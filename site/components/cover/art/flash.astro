---
/** Flash: three comments on a sheet; a ring stands around the one a link has just landed on. */
---

<span class="cover-sheet cover-stack" style="--cover-surface:var(--color-surface-raised); width:200px; padding:16px; --gap:14px">
  <span class="cover-line" style="--gap:10px"><span class="cover-avatar" style="--d:24px">AL</span><span class="cover-stack" style="--gap:7px"><i class="cover-bar cover-bar-faint" style="width:48px"></i><i class="cover-bar cover-bar-faint" style="width:112px"></i></span></span>
  <span class="cover-line" style="--gap:10px; border-radius:6px; outline:2px solid var(--color-line-mark); outline-offset:5px"><span class="cover-avatar" style="--d:24px">JT</span><span class="cover-stack" style="--gap:7px"><i class="cover-bar cover-bar-strong" style="width:56px"></i><i class="cover-bar" style="width:96px"></i></span></span>
  <span class="cover-line" style="--gap:10px"><span class="cover-avatar" style="--d:24px">MK</span><span class="cover-stack" style="--gap:7px"><i class="cover-bar cover-bar-faint" style="width:40px"></i><i class="cover-bar cover-bar-faint" style="width:88px"></i></span></span>
</span>
