---
/** Scroll area: lines that continue past both edges, which fade, and a thin thumb for the position. */
---

<span class="cover-sheet" style="width:176px; height:116px; overflow:hidden">
  <span class="cover-stack cover-fade" style="padding:1px 16px; --gap:12px">
    <i class="cover-bar" style="width:112px"></i>
    <i class="cover-bar" style="width:132px"></i>
    <i class="cover-bar" style="width:88px"></i>
    <i class="cover-bar" style="width:124px"></i>
    <i class="cover-bar" style="width:104px"></i>
    <i class="cover-bar" style="width:136px"></i>
    <i class="cover-bar" style="width:72px"></i>
  </span>
  <i class="cover-thumb" style="top:36px; right:5px; height:36px"></i>
</span>
