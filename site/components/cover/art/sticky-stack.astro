---
/** Sticky stack: a plan of a page under its bar, where three panels have stopped one under another, the edges of the two read above the one in view. */
---

<span class="cover-sheet cover-plan cover-stack" style="position:relative; width:208px; height:130px; --gap:0">
  <span class="cover-line" style="height:20px; padding:0 10px"><i class="cover-bar cover-bar-strong" style="width:22px"></i><span class="cover-end"><i class="cover-bar cover-bar-faint" style="width:36px"></i></span></span>
  <i class="cover-rule"></i>
  <span style="position:relative; display:block; height:109px">
    <span class="cover-sheet" style="position:absolute; inset:9px 32px auto; height:76px; --r:var(--radius-control)"></span>
    <span class="cover-sheet" style="position:absolute; inset:15px 32px auto; height:76px; --r:var(--radius-control)"></span>
    <span class="cover-sheet cover-stack" style="position:absolute; inset:21px 32px auto; height:76px; --r:var(--radius-control); padding:12px 12px; --gap:7px">
      <i class="cover-bar cover-bar-faint" style="width:22px"></i>
      <i class="cover-bar cover-bar-strong" style="width:72px"></i>
      <i class="cover-bar cover-bar-faint" style="width:96px"></i>
      <span class="cover-tone cover-skeleton" style="--r:var(--radius-chip); height:14px; margin-top:3px"></span>
    </span>
    <i class="cover-thumb" style="top:22px; right:5px; height:30px"></i>
  </span>
</span>
