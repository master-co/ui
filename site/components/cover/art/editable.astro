---
import Glyph from '../Glyph.astro'
/** Editable: a title on a sheet under the pointer: a faint well appears around the words with a pencil at their end. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:16px; --gap:8px">
  <i class="cover-bar cover-bar-faint" style="width:36px"></i>
  <span class="cover-well cover-line" style="--r:var(--radius-control-sm); height:30px; margin:0 -6px; padding:0 6px; --gap:6px; --glyph:13px; color:var(--color-text-muted); box-shadow:inset 0 0 0 .5px var(--color-line-contour)">
    <i class="cover-bar cover-bar-strong" style="width:104px; height:7px"></i>
    <Glyph name="pencil" />
  </span>
  <i class="cover-bar" style="width:120px"></i>
</span>
