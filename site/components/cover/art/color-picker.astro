---
/** Color picker: a field of the chosen hue under a thumb in a pearl ring, then a swatch of the color beside its hue and opacity tracks; the hue track runs round the wheel through the category marks. */
const mark = (name: string) => `var(--color-category-${name}-mark)`
const hues = `linear-gradient(90deg, ${['red', 'amber', 'lime', 'teal', 'blue', 'violet', 'pink', 'red'].map(mark).join(', ')})`
const opacity = `linear-gradient(90deg, transparent, ${mark('blue')}), repeating-conic-gradient(var(--color-line-strong) 0 25%, transparent 0 50%) 0 0 / 8px 8px, var(--color-surface-raised)`
---

<span class="cover-sheet cover-stack" style="--cover-surface:var(--color-surface-raised); width:200px; padding:14px; --gap:12px">
  <span class="cover-field cover-hue-1" style="height:66px">
    <i class="cover-field-thumb" style="--x:64%; --y:38%; --swatch:var(--category-mark)"></i>
  </span>
  <span class="cover-line" style="--gap:12px">
    <i class="cover-swatch cover-hue-1" style="width:28px; height:28px"></i>
    <span class="cover-stack" style="flex:1; --gap:10px">
      <span class="cover-track cover-paint" style={`--paint:${hues}; --fill:57%`}><i class="cover-knob"></i></span>
      <span class="cover-track cover-paint" style={`--paint:${opacity}; --fill:86%`}><i class="cover-knob"></i></span>
    </span>
  </span>
</span>
