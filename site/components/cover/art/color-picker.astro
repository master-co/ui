---
/** Color picker: a field of tone under a thumb in a pearl ring, then a swatch of the color beside its hue and opacity tracks; all in steps of ink. */
const ink = (share: number) => `color-mix(in oklch, var(--color-text-strong) ${share}%, var(--color-surface-raised))`
const hues = `linear-gradient(90deg, ${ink(18)}, ${ink(62)}, ${ink(30)}, ${ink(80)}, ${ink(44)}, ${ink(18)})`
const opacity = `linear-gradient(90deg, transparent, ${ink(58)}), repeating-conic-gradient(var(--color-line-strong) 0 25%, transparent 0 50%) 0 0 / 8px 8px, var(--color-surface-raised)`
---

<span class="cover-sheet cover-stack" style="--cover-surface:var(--color-surface-raised); width:200px; padding:14px; --gap:12px">
  <span class="cover-field" style="height:66px">
    <i class="cover-field-thumb" style={`--x:64%; --y:38%; --swatch:${ink(58)}`}></i>
  </span>
  <span class="cover-line" style="--gap:12px">
    <i class="cover-swatch" style={`--swatch:${ink(58)}; width:28px; height:28px`}></i>
    <span class="cover-stack" style="flex:1; --gap:10px">
      <span class="cover-track cover-paint" style={`--paint:${hues}; --fill:38%`}><i class="cover-knob"></i></span>
      <span class="cover-track cover-paint" style={`--paint:${opacity}; --fill:86%`}><i class="cover-knob"></i></span>
    </span>
  </span>
</span>
