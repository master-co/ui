---
import Glyph from '../Glyph.astro'
/** Tree: an open folder with two files set in on a guide, one current, and a closed folder after it. */
---

<span class="cover-sheet cover-stack" style="width:184px; padding:6px; --gap:0">
  <span class="cover-row" style="height:28px; padding:0 6px; gap:6px"><span style="--glyph:14px"><Glyph name="chevron-down" /></span><Glyph name="folder" /><i class="cover-bar cover-bar-strong" style="width:56px"></i></span>
  <span class="cover-guide cover-stack" style="--gap:0">
    <span class="cover-row" style="height:28px; padding:0 6px; gap:6px"><Glyph name="file" /><i class="cover-bar" style="width:72px"></i></span>
    <span class="cover-row cover-row-active" style="height:28px; padding:0 6px; gap:6px"><Glyph name="file" /><i class="cover-bar cover-bar-strong" style="width:52px"></i></span>
  </span>
  <span class="cover-row" style="height:28px; padding:0 6px; gap:6px"><span style="--glyph:14px"><Glyph name="chevron-right" /></span><Glyph name="folder" /><i class="cover-bar" style="width:44px"></i></span>
</span>
