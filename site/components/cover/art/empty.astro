---
import Glyph from '../Glyph.astro'
/** Empty: a view with nothing in it yet: an icon in a small well, what belongs here and how to add it. */
---

<span class="cover-sheet cover-stack" style="align-items:center; width:188px; padding:20px 16px 22px; --gap:0">
  <span class="cover-well cover-center" style="--r:var(--radius-control-lg); width:48px; height:48px; margin-bottom:14px; --glyph:20px; color:var(--color-text-muted)"><Glyph name="inbox" /></span>
  <span class="cover-stack" style="align-items:center"><i class="cover-bar cover-bar-strong" style="width:72px"></i><i class="cover-bar cover-bar-faint" style="width:120px"></i></span>
</span>
