---
/** Slider: a label and its value over a thin well, filled with ink up to the pearl thumb. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:18px 18px 24px; --gap:20px">
  <span class="cover-line"><i class="cover-bar cover-bar-strong" style="width:48px"></i><span class="cover-end"><i class="cover-bar" style="width:20px"></i></span></span>
  <span class="cover-track" style="--fill:62%"><i class="cover-knob"></i></span>
</span>
