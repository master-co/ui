---
/** Auto grid: six tiles that share the row in equal columns, three across. */
---

<span style="display:grid; grid-template-columns:repeat(3, 62px); gap:8px">
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); height:50px; padding:12px 10px"><i class="cover-bar cover-bar-strong" style="width:28px"></i><i class="cover-bar cover-bar-faint" style="width:36px"></i></span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); height:50px; padding:12px 10px"><i class="cover-bar cover-bar-strong" style="width:20px"></i><i class="cover-bar cover-bar-faint" style="width:40px"></i></span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); height:50px; padding:12px 10px"><i class="cover-bar cover-bar-strong" style="width:32px"></i><i class="cover-bar cover-bar-faint" style="width:28px"></i></span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); height:50px; padding:12px 10px"><i class="cover-bar cover-bar-strong" style="width:24px"></i><i class="cover-bar cover-bar-faint" style="width:36px"></i></span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); height:50px; padding:12px 10px"><i class="cover-bar cover-bar-strong" style="width:28px"></i><i class="cover-bar cover-bar-faint" style="width:32px"></i></span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); height:50px; padding:12px 10px"><i class="cover-bar cover-bar-strong" style="width:20px"></i><i class="cover-bar cover-bar-faint" style="width:40px"></i></span>
</span>
