---
import Glyph from '../Glyph.astro'
/** Dropzone: a wide well on a dashed contour, with an upload mark, what to do and what is accepted. */
---

<span class="cover-sheet" style="width:204px; padding:8px">
  <span class="cover-dashed cover-stack" style="align-items:center; padding:18px 12px 20px; color:var(--color-text-muted); --glyph:20px">
    <Glyph name="upload" />
    <span class="cover-stack" style="align-items:center; padding-top:4px"><i class="cover-bar cover-bar-strong" style="width:80px"></i><i class="cover-bar cover-bar-faint" style="width:120px"></i></span>
  </span>
</span>
