---
/** Odometer: a stat's figure whose last digit is caught rolling from 7 to 8: the 8 nearly in place, the 7 fading out over the line. */
---

<span class="cover-sheet cover-stack" style="width:184px; padding:18px; --gap:14px">
  <i class="cover-bar" style="width:56px"></i>
  <span class="cover-line" style="--gap:0; height:32px; color:var(--color-text-strong); font:400 28px/32px var(--font-family-sans); font-variant-numeric:tabular-nums; letter-spacing:-.02em">
    <span>12,84</span>
    <span class="cover-wheel" style="display:block; width:auto; height:108px; margin:-38px 0; color:inherit; font:inherit"><span style="display:grid; grid-auto-rows:36px; place-items:center; translate:0 -32px"><span>6</span><span>7</span><span>8</span></span></span>
  </span>
  <i class="cover-bar cover-bar-faint" style="width:104px"></i>
</span>
