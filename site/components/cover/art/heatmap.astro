---
/** Heatmap: a field of small cells on a sheet, each a step of ink deeper than nothing; one of them is the ink. */
---

<span class="cover-sheet cover-line" style="padding:18px; --gap:4px">
  <span class="cover-stack" style="--gap:4px"><i class="cover-cell" style="--tone:7%"></i><i class="cover-cell" style="--tone:38%"></i><i class="cover-cell" style="--tone:38%"></i><i class="cover-cell" style="--tone:7%"></i><i class="cover-cell" style="--tone:22%"></i></span>
  <span class="cover-stack" style="--gap:4px"><i class="cover-cell" style="--tone:38%"></i><i class="cover-cell" style="--tone:22%"></i><i class="cover-cell" style="--tone:54%"></i><i class="cover-cell" style="--tone:38%"></i><i class="cover-cell" style="--tone:7%"></i></span>
  <span class="cover-stack" style="--gap:4px"><i class="cover-cell" style="--tone:38%"></i><i class="cover-cell" style="--tone:7%"></i><i class="cover-cell" style="--tone:70%"></i><i class="cover-cell" style="--tone:22%"></i><i class="cover-cell" style="--tone:22%"></i></span>
  <span class="cover-stack" style="--gap:4px"><i class="cover-cell" style="--tone:38%"></i><i class="cover-cell" style="--tone:7%"></i><i class="cover-cell" style="--tone:7%"></i><i class="cover-cell" style="--tone:54%"></i><i class="cover-cell" style="--tone:22%"></i></span>
