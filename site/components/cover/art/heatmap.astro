  <span class="cover-stack" style="--gap:4px"><i class="cover-cell" style="--tone:54%"></i><i class="cover-cell" style="--tone:70%"></i><i class="cover-cell" style="--tone:7%"></i><i class="cover-cell" style="--tone:7%"></i><i class="cover-cell" style="--tone:54%"></i></span>
  <span class="cover-stack" style="--gap:4px"><i class="cover-cell" style="--tone:7%"></i><i class="cover-cell" style="--tone:70%"></i><i class="cover-cell" style="--tone:38%"></i><i class="cover-cell" style="--tone:22%"></i><i class="cover-cell" style="--tone:54%"></i></span>
  <span class="cover-stack" style="--gap:4px"><i class="cover-cell" style="--tone:7%"></i><i class="cover-cell" style="--tone:54%"></i><i class="cover-cell" style="--tone:100%"></i><i class="cover-cell" style="--tone:7%"></i><i class="cover-cell" style="--tone:7%"></i></span>
  <span class="cover-stack" style="--gap:4px"><i class="cover-cell" style="--tone:70%"></i><i class="cover-cell" style="--tone:38%"></i><i class="cover-cell" style="--tone:7%"></i><i class="cover-cell" style="--tone:22%"></i><i class="cover-cell" style="--tone:70%"></i></span>
  <span class="cover-stack" style="--gap:4px"><i class="cover-cell" style="--tone:7%"></i><i class="cover-cell" style="--tone:70%"></i><i class="cover-cell" style="--tone:70%"></i><i class="cover-cell" style="--tone:22%"></i><i class="cover-cell" style="--tone:22%"></i></span>
  <span class="cover-stack" style="--gap:4px"><i class="cover-cell" style="--tone:38%"></i><i class="cover-cell" style="--tone:54%"></i><i class="cover-cell" style="--tone:22%"></i><i class="cover-cell" style="--tone:54%"></i><i class="cover-cell" style="--tone:70%"></i></span>
