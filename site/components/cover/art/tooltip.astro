---
import Glyph from '../Glyph.astro'
/** Tooltip: three controls and, centered above the one under the pointer, a short label in ink. */
---

<span class="cover-stack" style="align-items:center">
  <span class="cover-tip"><i class="cover-bar" style="width:52px"></i></span>
  <span class="cover-line">
    <span class="cover-control cover-square"><Glyph name="pencil" /></span>
    <span class="cover-control cover-square"><Glyph name="bell" /></span>
    <span class="cover-control cover-square"><Glyph name="archive" /></span>
  </span>
</span>
