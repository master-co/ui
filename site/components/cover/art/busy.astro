---
/** Busy: a card whose words have stepped back under a veil, and the spinner that turns in its middle. */
---

<span class="cover-sheet cover-stack" style="position:relative; width:184px; padding:16px; --gap:12px">
  <i class="cover-bar cover-bar-faint" style="width:64px"></i>
  <i class="cover-bar cover-bar-faint" style="width:144px; opacity:.6"></i>
  <i class="cover-bar cover-bar-faint" style="width:112px; opacity:.6"></i>
  <span class="cover-control cover-control-sm" style="align-self:flex-end; opacity:.5"><i class="cover-bar cover-bar-faint" style="width:36px"></i></span>
  <span class="cover-center" style="position:absolute; inset:0; background:radial-gradient(circle, var(--color-surface-raised) 14px, transparent 34px)"><i class="cover-spinner" style="--d:20px"></i></span>
</span>
