---
/** Bento: six tiles of four sizes fitted into one box: a large one with its picture beside its words, a tall one, two small and two wide. */
---

<span style="display:grid; grid-template-columns:repeat(4, 47px); grid-template-rows:repeat(3, 38px); gap:6px">
  <span class="cover-sheet cover-line" style="grid-column:span 2; grid-row:span 2; --r:var(--radius-control-lg); padding:4px; align-items:stretch; --gap:9px">
    <span class="cover-media" style="--r:var(--radius-control); width:40px"></span>
    <span class="cover-stack" style="justify-content:center; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:32px"></i><i class="cover-bar cover-bar-faint" style="width:40px"></i><i class="cover-bar cover-bar-faint" style="width:28px"></i></span>
  </span>
  <span class="cover-sheet cover-stack" style="grid-row:span 2; --r:var(--radius-control-lg); padding:11px 9px; --gap:7px">
    <i class="cover-bar cover-bar-strong" style="width:24px"></i>
    <i class="cover-bar cover-bar-faint" style="width:29px"></i>
    <i class="cover-bar cover-bar-faint" style="width:20px"></i>
  </span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); padding:11px 9px; --gap:7px"><i class="cover-bar cover-bar-faint" style="width:20px"></i><i class="cover-bar cover-bar-strong" style="width:28px"></i></span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); padding:11px 9px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:24px"></i><i class="cover-bar cover-bar-faint" style="width:28px"></i></span>
  <span class="cover-sheet cover-line" style="grid-column:span 2; --r:var(--radius-control-lg); padding:9px 10px 8px; align-items:flex-end; --gap:4px">
    <i class="cover-column" style="--h:46%"></i>
    <i class="cover-column" style="--h:64%"></i>
    <i class="cover-column" style="--h:38%"></i>
    <i class="cover-column" style="--h:92%"></i>
    <i class="cover-column" style="--h:12%"></i>
    <i class="cover-column" style="--h:12%"></i>
    <i class="cover-column" style="--h:12%"></i>
  </span>
  <span class="cover-sheet cover-stack" style="grid-column:span 2; --r:var(--radius-control-lg); padding:11px 10px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:52px"></i><i class="cover-bar cover-bar-faint" style="width:72px"></i></span>
</span>
