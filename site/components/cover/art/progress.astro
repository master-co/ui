---
/** Progress: the same amount twice: around a ring, and along a thin well beside its label and its value. */
---

<span class="cover-sheet cover-line" style="width:204px; padding:16px; --gap:14px">
  <i class="cover-ring" style="--fill:64%"></i>
  <span class="cover-stack" style="flex:1; --gap:11px">
    <span class="cover-line"><i class="cover-bar cover-bar-strong" style="width:52px"></i><span class="cover-end"><i class="cover-bar" style="width:20px"></i></span></span>
    <span class="cover-track" style="--fill:64%"></span>
  </span>
</span>
