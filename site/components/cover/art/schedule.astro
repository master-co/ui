---
/** Schedule: three hours down a rail, each on a hairline with its label, events as tall as they last, two of them side by side, and the ink line of now with its dot. */
---

<span class="cover-sheet" style="width:200px; padding:14px 16px 16px">
  <span style="position:relative; display:block; height:104px">
    <i class="cover-bar cover-bar-faint" style="position:absolute; left:4px; top:1px; width:18px"></i>
    <i class="cover-bar cover-bar-faint" style="position:absolute; left:0; top:49px; width:22px"></i>
    <i class="cover-bar cover-bar-faint" style="position:absolute; left:0; top:97px; width:22px"></i>
    <i class="cover-rule" style="position:absolute; left:30px; right:0; top:4px"></i>
    <i class="cover-rule" style="position:absolute; left:30px; right:0; top:52px"></i>
    <i class="cover-rule" style="position:absolute; left:30px; right:0; top:100px"></i>
    <i class="cover-rule cover-rule-upright" style="position:absolute; left:30px; top:4px; height:96px; margin:0"></i>
    <span class="cover-tone cover-skeleton cover-quote cover-line" style="position:absolute; left:32px; top:6px; width:128px; height:21px; padding:0 8px 0 10px; --gap:6px"><i class="cover-bar cover-bar-strong" style="width:36px"></i><i class="cover-bar cover-bar-faint" style="width:26px"></i></span>
    <i class="cover-rule" style="position:absolute; left:30px; right:0; top:32px; background:var(--color-text-strong)"></i>
    <i class="cover-dot cover-ink" style="--d:7px; position:absolute; left:27px; top:29px"></i>
    <span class="cover-tone cover-skeleton cover-quote cover-stack" style="position:absolute; left:32px; top:42px; width:62px; height:45px; padding:8px 8px 0 10px; --gap:6px"><i class="cover-bar cover-bar-strong" style="width:30px"></i><i class="cover-bar cover-bar-faint" style="width:24px"></i></span>
    <span class="cover-tone cover-skeleton cover-quote cover-stack" style="position:absolute; left:97px; top:54px; width:62px; height:45px; padding:8px 8px 0 10px; --gap:6px"><i class="cover-bar cover-bar-strong" style="width:24px"></i><i class="cover-bar cover-bar-faint" style="width:28px"></i></span>
  </span>
</span>
