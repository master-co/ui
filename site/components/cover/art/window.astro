---
/** Window: a frame with three marks and a title in its bar, around a picture that runs to its edge. */
---

<span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); width:196px; overflow:clip; --gap:0">
  <span class="cover-line" style="height:40px; padding:0 14px">
    <i class="cover-marks"></i>
    <i class="cover-bar" style="width:56px; margin:0 auto; translate:-24px 0"></i>
  </span>
  <i class="cover-rule"></i>
  <span class="cover-media" style="--r:0px; display:block; height:80px"></span>
</span>
