---
/** Gradient: a preview that runs through three of the cover palette's hues, and under it the bar of stops, the one in hand ringed in ink. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:14px; --gap:12px">
  <i style="display:block; height:64px; border-radius:calc(var(--radius-control) * var(--corner-scale)); corner-shape:var(--corner-shape); background:linear-gradient(90deg, var(--color-category-teal-mark), var(--color-category-blue-mark) 55%, var(--color-category-violet-mark)); box-shadow:inset 0 0 0 .5px var(--color-line-contour)"></i>
  <span style="position:relative; display:block; height:8px; margin:0 8px; border-radius:999px; background:linear-gradient(90deg, var(--color-category-teal-mark), var(--color-category-blue-mark) 55%, var(--color-category-violet-mark)); box-shadow:var(--shadow-pressed)">
    <i class="cover-knob" style="position:absolute; left:0; top:50%; translate:-50% -50%; width:14px; height:14px"></i>
    <i class="cover-knob" style="position:absolute; left:55%; top:50%; translate:-50% -50%; width:16px; height:16px; box-shadow:0 0 0 2px var(--color-thumb-high), 0 0 0 3px var(--color-text-strong)"></i>
    <i class="cover-knob" style="position:absolute; left:100%; top:50%; translate:-50% -50%; width:14px; height:14px"></i>
  </span>
</span>
