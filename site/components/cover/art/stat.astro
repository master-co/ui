---
import Glyph from '../Glyph.astro'
/** Stat: a quiet label, one large figure with how it moved beside it, and what it is compared with. */
---

<span class="cover-sheet cover-stack" style="width:184px; padding:18px; --gap:14px">
  <i class="cover-bar" style="width:64px"></i>
  <span class="cover-line" style="--gap:10px">
    <i class="cover-bar cover-bar-strong cover-bar-figure" style="width:84px"></i>
    <span class="cover-badge"><Glyph name="arrow-up-right" /><i class="cover-bar" style="width:20px"></i></span>
  </span>
  <i class="cover-bar cover-bar-faint" style="width:104px"></i>
</span>
