---
import Glyph from '../Glyph.astro'
/** Reaction: a received message and the row of reactions under it; the reader's own sits on an ink hairline over a tint of ink. */
---

<span class="cover-stack" style="width:208px; --gap:6px">
  <span class="cover-bubble cover-stack" style="align-self:flex-start; padding:13px 14px"><i class="cover-bar cover-bar-strong" style="width:132px"></i><i class="cover-bar cover-bar-strong" style="width:88px"></i></span>
  <span class="cover-line" style="--gap:6px; font-size:12.5px; font-variant-numeric:tabular-nums">
    <span class="cover-badge cover-line" style="--r:999px; corner-shape:round; height:28px; padding:0 9px 0 6px; --gap:5px; background:color-mix(in oklab, var(--color-text-strong) 10%, transparent); box-shadow:inset 0 0 0 .5px var(--color-text-strong), 0 0 0 .5px color-mix(in oklab, var(--color-text-strong) 22%, transparent); color:var(--color-text-strong)"><i class="cover-dot" style="--d:16px; background:var(--color-line-mark)"></i>4</span>
    <span class="cover-badge cover-line" style="--r:999px; corner-shape:round; height:28px; padding:0 9px 0 6px; --gap:5px; color:var(--color-text-muted)"><i class="cover-dot" style="--d:16px; background:var(--color-line-strong)"></i>2</span>
    <span class="cover-badge cover-line" style="--r:999px; corner-shape:round; height:28px; padding:0 9px 0 6px; --gap:5px; color:var(--color-text-muted)"><i class="cover-dot" style="--d:16px; background:var(--color-line-strong)"></i>1</span>
    <span class="cover-badge cover-center" style="--r:999px; corner-shape:round; width:28px; height:28px; padding:0; color:var(--color-text-muted)"><Glyph name="plus" /></span>
  </span>
</span>
