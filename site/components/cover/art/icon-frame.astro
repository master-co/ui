---
import Glyph from '../Glyph.astro'
/** Icon frame: an icon in a frame tinted with its category beside the heading and the line it stands for. */
---

<span class="cover-sheet cover-line" style="width:196px; padding:18px; --gap:14px; align-items:center">
  <span class="cover-tone cover-center cover-hue-1" style="width:48px; height:48px; --glyph:20px; color:var(--category-text)"><Glyph name="folder" /></span>
  <span class="cover-stack" style="--gap:8px"><i class="cover-bar cover-bar-strong" style="width:72px"></i><i class="cover-bar" style="width:98px"></i></span>
</span>
