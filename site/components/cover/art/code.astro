---
/** Code: a sentence with one inline chip of code, and a block in a well with its indented lines. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:14px; --gap:12px">
  <span class="cover-line" style="--gap:6px">
    <i class="cover-bar" style="width:44px"></i>
    <span class="cover-tone cover-line" style="--r:calc(var(--radius-chip) - 2px); height:18px; padding:0 6px"><i class="cover-bar cover-bar-strong" style="width:40px"></i></span>
    <i class="cover-bar" style="width:28px"></i>
  </span>
  <span class="cover-well cover-stack" style="padding:13px 14px; --gap:9px">
    <i class="cover-bar cover-bar-strong" style="width:96px"></i>
    <span style="padding-left:14px"><i class="cover-bar" style="width:112px"></i></span>
    <span style="padding-left:14px"><i class="cover-bar" style="width:64px"></i></span>
    <i class="cover-bar cover-bar-strong" style="width:20px"></i>
  </span>
</span>
