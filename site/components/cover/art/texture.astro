---
/** Texture: three rooms cut into one sheet, each with its own drawing: dots, a grid and stripes. */
---

<span class="cover-sheet cover-stack" style="width:184px; padding:16px; --gap:14px">
  <span class="cover-stack">
    <i class="cover-bar cover-bar-strong" style="width:56px"></i>
    <i class="cover-bar" style="width:104px"></i>
  </span>
  <span class="cover-line" style="--gap:8px">
    <span class="cover-well cover-texture" style="flex:1; height:48px"></span>
    <span class="cover-well cover-texture cover-texture-grid" style="flex:1; height:48px"></span>
    <span class="cover-well cover-texture cover-texture-stripes" style="flex:1; height:48px"></span>
  </span>
</span>
