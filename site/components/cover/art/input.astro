---
/** Input: a labelled field on a sheet, focused: the well has risen and holds a caret. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:16px; --gap:10px">
  <i class="cover-bar cover-bar-strong" style="width:44px"></i>
  <span class="cover-well cover-focus cover-line" style="height:38px; padding:0 12px; --gap:4px">
    <i class="cover-bar cover-bar-strong" style="width:72px"></i>
    <i class="cover-caret"></i>
  </span>
  <i class="cover-bar cover-bar-faint" style="width:112px"></i>
</span>
