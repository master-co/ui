---
/** Gantt: four rows on one scale: a name at the start of each, a bar where it begins and ends, the current one in ink, and the line of today. */
---

<span class="cover-sheet cover-stack" style="width:204px; padding:16px; --gap:8px">
  <span class="cover-line" style="--gap:12px"><i class="cover-bar" style="width:32px"></i><span style="position:relative; flex:1"><i class="cover-lane" style="--from:0%; --to:42%"></i></span></span>
  <span class="cover-line" style="--gap:12px"><i class="cover-bar cover-bar-strong" style="width:28px; margin-right:4px"></i><span style="position:relative; flex:1"><i class="cover-lane cover-ink" style="--from:26%; --to:74%"></i></span></span>
  <span class="cover-line" style="--gap:12px"><i class="cover-bar" style="width:24px; margin-right:8px"></i><span style="position:relative; flex:1"><i class="cover-lane" style="--from:54%; --to:100%"></i></span></span>
  <span class="cover-line" style="--gap:12px"><i class="cover-bar" style="width:32px"></i><span style="position:relative; flex:1"><i class="cover-lane" style="--from:8%; --to:36%"></i></span></span>
  <i class="cover-rule cover-rule-upright" style="position:absolute; top:10px; bottom:10px; left:128px; height:auto; margin:0; background:var(--color-line-mark)"></i>
</span>
