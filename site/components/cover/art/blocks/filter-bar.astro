---
import Glyph from '../../Glyph.astro'

/** Filter bar: the Filters button with its count in ink, two applied conditions as chips that remove themselves, and the rows they leave. */
---

<span class="cover-sheet cover-stack" style="width:212px; overflow:hidden; --gap:0">
  <span class="cover-line" style="flex-wrap:wrap; padding:10px 12px; --gap:6px; --glyph:12px">
    <span class="cover-control cover-control-sm" style="height:26px; padding:0 8px"><i class="cover-bar cover-bar-strong" style="width:22px"></i><i class="cover-dot cover-ink" style="--d:12px"></i></span>
    <span class="cover-badge cover-round" style="height:22px; color:var(--color-text-muted)"><i class="cover-bar cover-bar-strong" style="width:28px"></i><Glyph name="x" /></span>
    <span class="cover-badge cover-round" style="height:22px; color:var(--color-text-muted)"><i class="cover-bar cover-bar-strong" style="width:20px"></i><Glyph name="x" /></span>
  </span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:30px; padding:0 12px; --gap:10px"><span class="cover-stack" style="--gap:4px"><i class="cover-bar cover-bar-strong" style="width:48px"></i><i class="cover-bar cover-bar-faint" style="width:72px"></i></span><span class="cover-end"><span class="cover-badge" style="height:16px; padding:0 5px"><i class="cover-bar" style="width:18px"></i></span></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:30px; padding:0 12px; --gap:10px"><span class="cover-stack" style="--gap:4px"><i class="cover-bar cover-bar-strong" style="width:60px"></i><i class="cover-bar cover-bar-faint" style="width:56px"></i></span><span class="cover-end"><span class="cover-badge" style="height:16px; padding:0 5px"><i class="cover-bar" style="width:18px"></i></span></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:30px; padding:0 12px; --gap:10px"><span class="cover-stack" style="--gap:4px"><i class="cover-bar cover-bar-strong" style="width:40px"></i><i class="cover-bar cover-bar-faint" style="width:80px"></i></span><span class="cover-end"><span class="cover-badge" style="height:16px; padding:0 5px"><i class="cover-bar" style="width:18px"></i></span></span></span>
</span>
