---
import Glyph from '../../Glyph.astro'

/** Careers: three open roles, each a title over its team and place, with its terms and the way in at the end. */
---

<span class="cover-sheet cover-stack" style="width:204px; padding:6px; --gap:0; --glyph:14px; color:var(--color-text-muted)">
  <span class="cover-line" style="height:38px; padding:0 8px 0 10px; --gap:6px"><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:88px"></i><i class="cover-bar" style="width:64px"></i></span><span class="cover-end cover-badge" style="height:18px; padding:0 6px"><i class="cover-bar" style="width:24px"></i></span><Glyph name="chevron-right" /></span>
  <span class="cover-line" style="height:38px; padding:0 8px 0 10px; --gap:6px"><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:64px"></i><i class="cover-bar" style="width:48px"></i></span><span class="cover-end cover-badge" style="height:18px; padding:0 6px"><i class="cover-bar" style="width:24px"></i></span><Glyph name="chevron-right" /></span>
  <span class="cover-line" style="height:38px; padding:0 8px 0 10px; --gap:6px"><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:76px"></i><i class="cover-bar" style="width:72px"></i></span><span class="cover-end cover-badge" style="height:18px; padding:0 6px"><i class="cover-bar" style="width:28px"></i></span><Glyph name="chevron-right" /></span>
</span>
