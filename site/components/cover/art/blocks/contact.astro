---
/** Contact: a name and an email side by side, the message under them, and the one ink button that sends it. */
---

<span class="cover-sheet cover-stack" style="width:196px; padding:14px; --gap:8px">
  <span class="cover-line" style="--gap:8px">
    <span class="cover-well cover-line" style="flex:1; height:24px; padding:0 8px; --r:var(--radius-control-sm)"><i class="cover-bar cover-bar-strong" style="width:36px"></i></span>
    <span class="cover-well cover-line" style="flex:1; height:24px; padding:0 8px; --r:var(--radius-control-sm)"><i class="cover-bar cover-bar-faint" style="width:48px"></i></span>
  </span>
  <span class="cover-well cover-stack" style="height:34px; padding:9px 8px; --r:var(--radius-control-sm); --gap:6px"><i class="cover-bar cover-bar-faint" style="width:120px"></i><i class="cover-bar cover-bar-faint" style="width:84px"></i></span>
  <span class="cover-line"><span class="cover-end cover-control cover-control-sm cover-ink" style="height:26px"><i class="cover-bar" style="width:40px"></i></span></span>
</span>
