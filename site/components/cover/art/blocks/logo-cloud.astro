---
/** Logo cloud: a quiet caption over one row of names, all in the same muted ink. */
---

<span class="cover-sheet cover-stack" style="align-items:center; width:208px; padding:20px 16px 22px; --gap:16px">
  <i class="cover-bar cover-bar-faint" style="width:72px"></i>
  <span class="cover-line" style="--gap:14px"><i class="cover-bar cover-bar-figure" style="width:40px"></i><i class="cover-bar cover-bar-figure" style="width:28px"></i><i class="cover-bar cover-bar-figure" style="width:48px"></i><i class="cover-bar cover-bar-figure" style="width:24px"></i></span>
  <span class="cover-line" style="--gap:14px"><i class="cover-bar cover-bar-figure" style="width:32px"></i><i class="cover-bar cover-bar-figure" style="width:44px"></i><i class="cover-bar cover-bar-figure" style="width:36px"></i></span>
</span>
