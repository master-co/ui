---
import Glyph from '../../Glyph.astro'

/** Header: a site header with one of its links open, a menu of rows floating under it. */
---

<span class="cover-sheet cover-stack" style="position:absolute; top:10px; left:-12px; width:264px; height:240px; --gap:0">
  <span class="cover-line" style="height:52px; padding:0 28px; --gap:16px">
    <i class="cover-bar cover-bar-strong" style="width:44px"></i><i class="cover-bar cover-bar-strong" style="width:36px"></i><i class="cover-bar" style="width:28px"></i>
    <span class="cover-end cover-control cover-control-sm cover-ink"><i class="cover-bar" style="width:28px"></i></span>
  </span>
  <i class="cover-rule"></i>
</span>
<span class="cover-float cover-stack" style="position:absolute; top:58px; left:56px; --r:calc(var(--radius-control-sm) + 4px / var(--corner-scale)); width:136px; padding:4px; --gap:2px">
  <span class="cover-row cover-row-active"><Glyph name="arrow-up" /><i class="cover-bar cover-bar-strong" style="width:56px"></i></span>
  <span class="cover-row"><Glyph name="search" /><i class="cover-bar" style="width:44px"></i></span>
</span>
