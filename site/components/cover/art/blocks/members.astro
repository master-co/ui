---
/** Members: people in rows, a face, a name and an address each; the owner's role is words, every other role a small control at the end. */
---

<span class="cover-sheet cover-stack" style="--cover-surface:var(--color-surface-raised); width:204px; --gap:0; --d:24px">
  <span class="cover-line" style="height:40px; padding:0 12px; --gap:10px"><i class="cover-avatar cover-avatar-photo"></i><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:64px"></i><i class="cover-bar cover-bar-faint" style="width:84px"></i></span><span class="cover-end"><i class="cover-bar" style="width:26px"></i></span></span>
  <i class="cover-rule" style="margin-left:46px"></i>
  <span class="cover-line" style="height:40px; padding:0 12px; --gap:10px"><i class="cover-avatar cover-avatar-photo"></i><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:72px"></i><i class="cover-bar cover-bar-faint" style="width:76px"></i></span><span class="cover-end"><span class="cover-control cover-control-sm" style="height:20px; padding:0 7px"><i class="cover-bar cover-bar-strong" style="width:24px"></i></span></span></span>
  <i class="cover-rule" style="margin-left:46px"></i>
  <span class="cover-line" style="height:40px; padding:0 12px; --gap:10px"><i class="cover-avatar cover-avatar-photo"></i><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:56px"></i><i class="cover-bar cover-bar-faint" style="width:88px"></i></span><span class="cover-end"><span class="cover-control cover-control-sm" style="height:20px; padding:0 7px"><i class="cover-bar cover-bar-strong" style="width:30px"></i></span></span></span>
</span>
