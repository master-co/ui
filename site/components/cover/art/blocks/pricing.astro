---
/** Pricing: three plans side by side; the middle one stands higher and holds the one ink button. */
---

<span class="cover-line" style="align-items:center; --gap:6px">
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); width:64px; padding:12px 10px; --gap:9px"><i class="cover-bar" style="width:24px"></i><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:28px"></i><span class="cover-control cover-control-sm" style="height:22px; padding:0; margin:2px 0"><i class="cover-bar cover-bar-strong" style="width:20px"></i></span><i class="cover-bar cover-bar-faint" style="width:40px"></i><i class="cover-bar cover-bar-faint" style="width:32px"></i></span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); width:68px; padding:16px 10px; --gap:9px; box-shadow:var(--shadow-lifted)"><i class="cover-bar" style="width:20px"></i><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:32px"></i><span class="cover-control cover-control-sm cover-ink" style="height:22px; padding:0; margin:2px 0"><i class="cover-bar" style="width:20px"></i></span><i class="cover-bar cover-bar-faint" style="width:44px"></i><i class="cover-bar cover-bar-faint" style="width:36px"></i><i class="cover-bar cover-bar-faint" style="width:40px"></i></span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); width:64px; padding:12px 10px; --gap:9px"><i class="cover-bar" style="width:32px"></i><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:36px"></i><span class="cover-control cover-control-sm" style="height:22px; padding:0; margin:2px 0"><i class="cover-bar cover-bar-strong" style="width:20px"></i></span><i class="cover-bar cover-bar-faint" style="width:36px"></i><i class="cover-bar cover-bar-faint" style="width:44px"></i></span>
</span>
