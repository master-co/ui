---
import Glyph from '../../Glyph.astro'

/** Empty state: a mark in a well, what belongs here, and the action that makes the first one. */
---

<span class="cover-sheet cover-stack" style="align-items:center; width:196px; padding:18px 16px; --gap:0">
  <span class="cover-well cover-center" style="--r:var(--radius-control-lg); width:40px; height:40px; margin-bottom:12px; --glyph:18px; color:var(--color-text-muted)"><Glyph name="folder" /></span>
  <span class="cover-stack" style="align-items:center"><i class="cover-bar cover-bar-strong" style="width:72px"></i><i class="cover-bar cover-bar-faint" style="width:124px"></i></span>
  <span class="cover-control cover-control-sm cover-ink" style="margin-top:14px; --glyph:14px"><Glyph name="plus" /><i class="cover-bar" style="width:36px"></i></span>
</span>
