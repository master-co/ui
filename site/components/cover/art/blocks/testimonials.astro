---
/** Testimonials: two quotations side by side, each over the face and the name of who said it. */
---

<span class="cover-line" style="align-items:stretch; --gap:8px">
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); --cover-surface:var(--color-surface-raised); width:100px; padding:14px 12px; --gap:12px">
    <span class="cover-stack" style="--gap:8px"><i class="cover-bar cover-bar-strong" style="width:72px"></i><i class="cover-bar cover-bar-strong" style="width:76px"></i><i class="cover-bar cover-bar-strong" style="width:48px"></i></span>
    <span class="cover-line" style="--d:20px"><i class="cover-avatar cover-avatar-photo"></i><i class="cover-bar" style="width:36px"></i></span>
  </span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); --cover-surface:var(--color-surface-raised); width:100px; padding:14px 12px; --gap:12px">
    <span class="cover-stack" style="--gap:8px"><i class="cover-bar cover-bar-strong" style="width:76px"></i><i class="cover-bar cover-bar-strong" style="width:64px"></i><i class="cover-bar cover-bar-strong" style="width:56px"></i></span>
    <span class="cover-line" style="--d:20px"><i class="cover-avatar cover-avatar-photo"></i><i class="cover-bar" style="width:44px"></i></span>
  </span>
</span>
