---
import Glyph from '../../Glyph.astro'

/** Features: three short claims side by side, each a mark in a well over a title and a line. */
---

<span class="cover-sheet cover-line" style="align-items:flex-start; width:212px; padding:16px 14px 18px; --gap:12px; --glyph:14px; color:var(--color-text-strong)">
  <span class="cover-stack" style="flex:1; --gap:7px"><span class="cover-well cover-center" style="--r:var(--radius-control-sm); width:28px; height:28px; margin-bottom:3px"><Glyph name="arrow-up" /></span><i class="cover-bar cover-bar-strong" style="width:36px"></i><i class="cover-bar cover-bar-faint" style="width:52px"></i><i class="cover-bar cover-bar-faint" style="width:40px"></i></span>
  <span class="cover-stack" style="flex:1; --gap:7px"><span class="cover-well cover-center" style="--r:var(--radius-control-sm); width:28px; height:28px; margin-bottom:3px"><Glyph name="search" /></span><i class="cover-bar cover-bar-strong" style="width:44px"></i><i class="cover-bar cover-bar-faint" style="width:48px"></i><i class="cover-bar cover-bar-faint" style="width:52px"></i></span>
  <span class="cover-stack" style="flex:1; --gap:7px"><span class="cover-well cover-center" style="--r:var(--radius-control-sm); width:28px; height:28px; margin-bottom:3px"><Glyph name="bell" /></span><i class="cover-bar cover-bar-strong" style="width:32px"></i><i class="cover-bar cover-bar-faint" style="width:52px"></i><i class="cover-bar cover-bar-faint" style="width:36px"></i></span>
</span>
