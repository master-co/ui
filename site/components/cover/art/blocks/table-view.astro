---
import Glyph from '../../Glyph.astro'

/** Table view: a filter and an action over rows with a checkbox each, one of them chosen. */
---

<span class="cover-sheet cover-stack" style="width:208px; overflow:hidden; --gap:0">
  <span class="cover-line" style="padding:10px 12px; --glyph:12px; color:var(--color-text-muted)">
    <span class="cover-well cover-line" style="--r:var(--radius-control-sm); width:84px; height:26px; padding:0 8px; --gap:6px"><Glyph name="search" /><i class="cover-bar cover-bar-faint" style="width:36px"></i></span>
    <span class="cover-end cover-control cover-control-sm" style="height:26px; padding:0 10px"><i class="cover-bar cover-bar-strong" style="width:28px"></i></span>
  </span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:30px; padding:0 12px; --gap:10px; background:var(--color-surface-chip)"><i class="cover-check cover-check-on" style="width:14px; height:14px"></i><i class="cover-bar cover-bar-strong" style="width:56px"></i><span class="cover-end"><i class="cover-bar" style="width:28px"></i></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:30px; padding:0 12px; --gap:10px"><i class="cover-check" style="width:14px; height:14px"></i><i class="cover-bar cover-bar-strong" style="width:44px"></i><span class="cover-end"><i class="cover-bar" style="width:36px"></i></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:30px; padding:0 12px; --gap:10px"><i class="cover-check" style="width:14px; height:14px"></i><i class="cover-bar cover-bar-strong" style="width:64px"></i><span class="cover-end"><i class="cover-bar" style="width:24px"></i></span></span>
</span>
