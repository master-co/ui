---
import Glyph from '../../Glyph.astro'

/** Sidebar: the workspace at the top, a search field, the navigation with its current row, and the account at the foot. */
---

<span class="cover-sheet cover-stack" style="position:absolute; top:10px; left:36px; width:168px; height:240px; padding:8px; --gap:6px; --cover-surface:var(--color-surface-raised)">
  <span class="cover-row" style="--d:20px"><i class="cover-avatar" style="border-radius:calc(var(--radius-chip) * var(--corner-scale)); corner-shape:var(--corner-shape)"></i><i class="cover-bar cover-bar-strong" style="width:56px"></i><span class="cover-end" style="--glyph:14px"><Glyph name="selector" /></span></span>
  <span class="cover-well cover-line" style="--r:var(--radius-control-sm); height:30px; padding:0 8px; --glyph:14px; color:var(--color-text-muted)"><Glyph name="search" /><i class="cover-bar cover-bar-faint" style="width:40px"></i></span>
  <span class="cover-stack" style="--gap:2px">
    <span class="cover-row"><Glyph name="home" /><i class="cover-bar" style="width:48px"></i></span>
    <span class="cover-row cover-row-current"><Glyph name="folder" /><i class="cover-bar cover-bar-strong" style="width:56px"></i></span>
    <span class="cover-row"><Glyph name="adjustments" /><i class="cover-bar" style="width:44px"></i></span>
  </span>
</span>
