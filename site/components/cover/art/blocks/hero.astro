---
/** Hero: a centered announcement, a title in two large lines, a line under it and two actions. */
---

<span class="cover-sheet cover-stack" style="position:absolute; top:10px; left:-12px; align-items:center; width:264px; height:240px; padding-top:20px; --gap:0">
  <span class="cover-badge cover-round" style="margin-bottom:12px"><i class="cover-bar" style="width:48px"></i></span>
  <span class="cover-stack" style="align-items:center; --gap:7px"><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:148px"></i><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:108px"></i></span>
  <span style="margin:12px 0 14px"><i class="cover-bar cover-bar-faint" style="width:128px"></i></span>
  <span class="cover-line"><span class="cover-control cover-control-sm cover-ink"><i class="cover-bar" style="width:36px"></i></span><span class="cover-control cover-control-sm"><i class="cover-bar cover-bar-strong" style="width:28px"></i></span></span>
</span>
