---
/** Choice cards: three plans side by side under their question; the chosen one has risen onto an ink contour. */
---

<span class="cover-sheet cover-stack" style="width:220px; padding:12px; --gap:10px">
  <i class="cover-bar cover-bar-strong" style="width:84px"></i>
  <span class="cover-line" style="--gap:6px; align-items:stretch">
    <span class="cover-flat cover-stack" style="flex:1; padding:9px; --gap:7px"><i class="cover-check cover-check-round" style="width:12px; height:12px"></i><i class="cover-bar cover-bar-strong" style="width:24px"></i><i class="cover-bar" style="width:40px"></i></span>
    <span class="cover-flat cover-chosen cover-stack" style="flex:1; padding:9px; --gap:7px"><i class="cover-check cover-check-round cover-check-on" style="width:12px; height:12px"></i><i class="cover-bar cover-bar-strong" style="width:28px"></i><i class="cover-bar" style="width:44px"></i></span>
    <span class="cover-flat cover-stack" style="flex:1; padding:9px; --gap:7px"><i class="cover-check cover-check-round" style="width:12px; height:12px"></i><i class="cover-bar cover-bar-strong" style="width:24px"></i><i class="cover-bar" style="width:36px"></i></span>
  </span>
</span>
