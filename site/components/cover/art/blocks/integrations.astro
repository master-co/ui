---
/** Integrations: three services, each a square mark beside its name, with the state of its connection at the end. */
---

<span class="cover-sheet cover-stack" style="width:204px; padding:6px; --gap:0">
  <span class="cover-line" style="height:38px; padding:0 8px; --gap:10px"><span class="cover-tone cover-center" style="width:26px; height:26px; --r:var(--radius-control-sm)"><i class="cover-bar cover-bar-strong" style="width:10px"></i></span><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:44px"></i><i class="cover-bar" style="width:56px"></i></span><span class="cover-end cover-badge" style="height:18px; padding:0 6px"><i class="cover-dot" style="--d:5px"></i><i class="cover-bar" style="width:28px"></i></span></span>
  <span class="cover-line" style="height:38px; padding:0 8px; --gap:10px"><span class="cover-tone cover-center" style="width:26px; height:26px; --r:var(--radius-control-sm)"><i class="cover-bar cover-bar-strong" style="width:10px"></i></span><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:32px"></i><i class="cover-bar" style="width:48px"></i></span><span class="cover-end cover-badge" style="height:18px; padding:0 6px"><i class="cover-dot" style="--d:5px"></i><i class="cover-bar" style="width:28px"></i></span></span>
  <span class="cover-line" style="height:38px; padding:0 8px; --gap:10px"><span class="cover-tone cover-center" style="width:26px; height:26px; --r:var(--radius-control-sm)"><i class="cover-bar cover-bar-strong" style="width:10px"></i></span><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:40px"></i><i class="cover-bar" style="width:32px"></i></span><span class="cover-end cover-badge" style="height:18px; padding:0 6px"><i class="cover-bar cover-bar-faint" style="width:36px"></i></span></span>
</span>
