---
/** Messaging: a received turn beside its author and a reply in ink, over the composer the next one is written in. */
---

<span class="cover-sheet cover-stack" style="width:212px; padding:12px; --gap:10px; --cover-surface:var(--color-surface-raised)">
  <span class="cover-line" style="align-items:flex-end; --gap:6px">
    <i class="cover-avatar cover-avatar-photo" style="--d:18px"></i>
    <span class="cover-bubble cover-stack" style="padding:9px 11px; --gap:6px"><i class="cover-bar cover-bar-strong" style="width:92px"></i><i class="cover-bar cover-bar-strong" style="width:56px"></i></span>
  </span>
  <span class="cover-bubble cover-bubble-sent cover-end" style="padding:10px 11px"><i class="cover-bar" style="width:72px"></i></span>
  <span class="cover-well cover-line" style="--r:var(--radius-control); height:28px; padding:0 6px 0 10px"><i class="cover-bar cover-bar-faint" style="width:64px"></i><span class="cover-end cover-control cover-control-sm" style="width:18px; height:18px; padding:0"></span></span>
</span>
