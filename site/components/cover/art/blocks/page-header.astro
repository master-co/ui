---
import Glyph from '../../Glyph.astro'

/** Page header: a way back, the title of the page with its action at the end, and the tabs under them. */
---

<span class="cover-sheet cover-stack" style="width:208px; padding-top:14px; --gap:0">
  <span class="cover-line" style="padding:0 16px; --gap:5px; --glyph:10px; color:var(--color-text-muted)"><i class="cover-bar cover-bar-faint" style="width:28px"></i><Glyph name="chevron-right" /><i class="cover-bar cover-bar-faint" style="width:36px"></i></span>
  <span class="cover-line" style="padding:12px 16px 14px"><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:72px"></i><span class="cover-end cover-control cover-control-sm cover-ink"><i class="cover-bar" style="width:28px"></i></span></span>
  <span class="cover-line" style="height:34px; padding:0 16px; --gap:16px; box-shadow:inset 0 -1px 0 var(--color-line-divider)">
    <span class="cover-tab cover-tab-current"><i class="cover-bar cover-bar-strong" style="width:32px"></i></span><span class="cover-tab"><i class="cover-bar" style="width:40px"></i></span><span class="cover-tab"><i class="cover-bar" style="width:28px"></i></span>
  </span>
  <span style="height:14px"></span>
</span>
