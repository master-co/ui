---
/** Activity feed: a day's heading over events joined by a line, each with its person as the marker and a badge under its words. */
---

<span class="cover-sheet cover-stack" style="width:208px; padding:12px 14px 14px; --gap:8px; --cover-surface:var(--color-surface-raised)">
  <i class="cover-bar cover-bar-faint" style="width:28px"></i>
  <span class="cover-stack" style="--gap:0">
    <span class="cover-line" style="align-items:stretch; --gap:10px"><span class="cover-stack" style="align-items:center; width:20px; --gap:3px"><i class="cover-avatar cover-avatar-photo" style="--d:20px"></i><i class="cover-rule cover-rule-upright" style="flex:1; margin:0"></i></span><span class="cover-stack" style="padding:5px 0 14px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:112px"></i><span class="cover-badge" style="height:16px; padding:0 6px"><i class="cover-bar" style="width:24px"></i></span></span></span>
    <span class="cover-line" style="align-items:stretch; --gap:10px"><span class="cover-stack" style="align-items:center; width:20px; --gap:3px"><i class="cover-avatar" style="--d:20px"></i><i class="cover-rule cover-rule-upright" style="flex:1; margin:0"></i></span><span class="cover-stack" style="padding:5px 0 14px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:96px"></i><i class="cover-bar" style="width:128px"></i></span></span>
    <span class="cover-line" style="align-items:stretch; --gap:10px"><span class="cover-stack" style="align-items:center; width:20px"><i class="cover-avatar cover-avatar-photo" style="--d:20px"></i></span><span class="cover-stack" style="padding:5px 0 0; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:104px"></i><span class="cover-badge" style="height:16px; padding:0 6px"><i class="cover-bar" style="width:32px"></i></span></span></span>
  </span>
</span>
