---
import Glyph from '../../Glyph.astro'

/** Notification inbox: three notifications, from a person or from the system; the two still unread carry an ink dot. */
---

<span class="cover-sheet cover-stack" style="--cover-surface:var(--color-surface-raised); width:204px; --gap:0; --d:24px; --glyph:12px; color:var(--color-text-muted)">
  <span class="cover-line" style="height:40px; padding:0 14px 0 12px; --gap:10px"><i class="cover-avatar cover-avatar-photo"></i><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:96px"></i><i class="cover-bar" style="width:72px"></i></span><span class="cover-end"><i class="cover-dot cover-ink" style="--d:7px"></i></span></span>
  <i class="cover-rule" style="margin-left:46px"></i>
  <span class="cover-line" style="height:40px; padding:0 14px 0 12px; --gap:10px"><span class="cover-well cover-center" style="width:24px; height:24px; --r:var(--radius-control-sm)"><Glyph name="bell" /></span><span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:80px"></i><i class="cover-bar" style="width:104px"></i></span><span class="cover-end"><i class="cover-dot cover-ink" style="--d:7px"></i></span></span>
  <i class="cover-rule" style="margin-left:46px"></i>
  <span class="cover-line" style="height:40px; padding:0 14px 0 12px; --gap:10px"><i class="cover-avatar cover-avatar-photo"></i><span class="cover-stack"><i class="cover-bar" style="width:88px"></i><i class="cover-bar cover-bar-faint" style="width:64px"></i></span></span>
</span>
