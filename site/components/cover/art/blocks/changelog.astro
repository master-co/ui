---
/** Changelog: two releases on one line, newest first: each a version beside its date over what it changed, the latest in ink. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:12px 16px 14px 12px; --gap:3px">
  <span class="cover-line" style="align-items:stretch; --gap:10px"><span class="cover-stack" style="align-items:center; width:20px; --gap:3px"><span class="cover-center" style="height:18px"><i class="cover-dot cover-ink"></i></span><i class="cover-rule cover-rule-upright" style="flex:1; margin:0"></i></span><span class="cover-stack" style="padding:0 0 13px; --gap:7px"><span class="cover-line" style="height:18px; --gap:6px"><i class="cover-bar cover-bar-strong" style="width:44px"></i><span class="cover-badge" style="height:16px; padding:0 6px"><i class="cover-bar" style="width:20px"></i></span></span><span class="cover-line" style="--gap:6px; --d:3px"><i class="cover-dot"></i><i class="cover-bar" style="width:112px"></i></span><span class="cover-line" style="--gap:6px; --d:3px"><i class="cover-dot"></i><i class="cover-bar" style="width:88px"></i></span></span></span>
  <span class="cover-line" style="align-items:stretch; --gap:10px"><span class="cover-stack" style="align-items:center; width:20px"><span class="cover-center" style="height:18px"><i class="cover-dot"></i></span></span><span class="cover-stack" style="--gap:7px"><span class="cover-line" style="height:18px; --gap:6px"><i class="cover-bar cover-bar-strong" style="width:44px"></i><i class="cover-bar cover-bar-faint" style="width:40px"></i></span><span class="cover-line" style="--gap:6px; --d:3px"><i class="cover-dot"></i><i class="cover-bar" style="width:96px"></i></span><span class="cover-line" style="--gap:6px; --d:3px"><i class="cover-dot"></i><i class="cover-bar" style="width:120px"></i></span></span></span>
</span>
