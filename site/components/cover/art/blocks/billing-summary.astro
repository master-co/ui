---
/** Billing summary: a plan and its state, what it costs, how much of it is used, and two facts about the account. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:14px 16px; --gap:0">
  <span class="cover-line" style="--gap:6px"><i class="cover-bar cover-bar-strong" style="width:40px"></i><span class="cover-badge" style="height:16px; padding:0 6px"><i class="cover-dot" style="--d:5px"></i><i class="cover-bar" style="width:20px"></i></span></span>
  <span class="cover-line" style="align-items:flex-end; padding-top:9px; --gap:6px"><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:48px"></i><i class="cover-bar cover-bar-faint" style="width:40px"></i></span>
  <span class="cover-track" style="--fill:62%; margin:13px 0 12px"></span>
  <span class="cover-line" style="height:18px"><i class="cover-bar cover-bar-faint" style="width:36px"></i><span class="cover-end"><i class="cover-bar" style="width:56px"></i></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:18px; margin-bottom:-4px"><i class="cover-bar cover-bar-faint" style="width:44px"></i><span class="cover-end"><i class="cover-bar" style="width:40px"></i></span></span>
</span>
