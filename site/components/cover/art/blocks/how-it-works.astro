---
/** How it works: three steps side by side, each a small sheet with what the step leaves behind, over its number, its title and a line; the last one is done. */
---

<span class="cover-line" style="align-items:flex-start; --gap:9px">
  <span class="cover-stack" style="width:62px; --gap:6px"><span class="cover-sheet cover-line" style="--r:var(--radius-control-sm); height:24px; padding:0 8px; --gap:6px; margin-bottom:5px"><i class="cover-bar cover-bar-strong" style="width:26px"></i><span class="cover-end"><i class="cover-dot" style="--d:6px"></i></span></span><i class="cover-bar cover-bar-faint" style="width:16px"></i><i class="cover-bar cover-bar-strong" style="width:44px"></i><i class="cover-bar cover-bar-faint" style="width:56px"></i><i class="cover-bar cover-bar-faint" style="width:36px"></i></span>
  <span class="cover-stack" style="width:62px; --gap:6px"><span class="cover-sheet cover-line" style="--r:var(--radius-control-sm); height:24px; padding:0 8px; --gap:6px; margin-bottom:5px"><i class="cover-bar cover-bar-strong" style="width:32px"></i><span class="cover-end"><i class="cover-dot" style="--d:6px"></i></span></span><i class="cover-bar cover-bar-faint" style="width:16px"></i><i class="cover-bar cover-bar-strong" style="width:36px"></i><i class="cover-bar cover-bar-faint" style="width:52px"></i><i class="cover-bar cover-bar-faint" style="width:44px"></i></span>
  <span class="cover-stack" style="width:62px; --gap:6px"><span class="cover-sheet cover-line" style="--r:var(--radius-control-sm); height:24px; padding:0 8px; --gap:6px; margin-bottom:5px"><i class="cover-bar cover-bar-strong" style="width:28px"></i><span class="cover-end"><i class="cover-dot cover-ink" style="--d:6px"></i></span></span><i class="cover-bar cover-bar-faint" style="width:16px"></i><i class="cover-bar cover-bar-strong" style="width:40px"></i><i class="cover-bar cover-bar-faint" style="width:56px"></i><i class="cover-bar cover-bar-faint" style="width:32px"></i></span>
</span>
