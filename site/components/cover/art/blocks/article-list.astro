---
/** Article list: two articles side by side, each a picture over its title, its summary and who wrote it. */
---

<span class="cover-line" style="align-items:stretch; --gap:8px">
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); --cover-surface:var(--color-surface-raised); width:100px; padding:4px; --gap:0">
    <span class="cover-media" style="height:44px; --r:var(--radius-control)"></span>
    <span class="cover-stack" style="padding:10px 8px 8px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:64px"></i><i class="cover-bar cover-bar-faint" style="width:72px"></i><i class="cover-bar cover-bar-faint" style="width:48px"></i><span class="cover-line" style="padding-top:3px; --gap:6px; --d:14px"><i class="cover-avatar cover-avatar-photo"></i><i class="cover-bar" style="width:32px"></i></span></span>
  </span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); --cover-surface:var(--color-surface-raised); width:100px; padding:4px; --gap:0">
    <span class="cover-media" style="height:44px; --r:var(--radius-control)"></span>
    <span class="cover-stack" style="padding:10px 8px 8px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:52px"></i><i class="cover-bar cover-bar-faint" style="width:68px"></i><i class="cover-bar cover-bar-faint" style="width:60px"></i><span class="cover-line" style="padding-top:3px; --gap:6px; --d:14px"><i class="cover-avatar cover-avatar-photo"></i><i class="cover-bar" style="width:40px"></i></span></span>
  </span>
</span>
