---
/** Stats: three large figures in a row, each over a quiet label, parted by hairlines. */
---

<span class="cover-sheet cover-line" style="align-items:stretch; width:208px; padding:20px 4px; --gap:0">
  <span class="cover-stack" style="flex:1; padding:0 12px; --gap:10px"><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:36px"></i><i class="cover-bar cover-bar-faint" style="width:40px"></i></span>
  <i class="cover-rule cover-rule-upright" style="margin:0"></i>
  <span class="cover-stack" style="flex:1; padding:0 12px; --gap:10px"><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:28px"></i><i class="cover-bar cover-bar-faint" style="width:32px"></i></span>
  <i class="cover-rule cover-rule-upright" style="margin:0"></i>
  <span class="cover-stack" style="flex:1; padding:0 12px; --gap:10px"><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:40px"></i><i class="cover-bar cover-bar-faint" style="width:36px"></i></span>
</span>
