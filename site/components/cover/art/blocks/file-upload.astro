---
import Glyph from '../../Glyph.astro'

/** File upload: the dashed zone where files are chosen, over one file that is tinted as far as its upload has come. */
---

<span class="cover-sheet cover-stack" style="width:204px; padding:8px; --gap:8px; --glyph:14px; color:var(--color-text-muted)">
  <span class="cover-dashed cover-line" style="justify-content:center; height:48px; --gap:10px; --r:var(--radius-control)"><Glyph name="upload" /><i class="cover-bar cover-bar-strong" style="width:80px"></i></span>
  <span class="cover-flat cover-line" style="padding:8px 12px 8px 8px; --gap:10px; --r:var(--radius-control); background:linear-gradient(90deg, var(--color-surface-chip) 58%, transparent 0) var(--color-surface-raised)">
    <span class="cover-page"><i class="cover-bar cover-bar-faint" style="width:12px; height:3px"></i></span>
    <span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:72px"></i><i class="cover-bar" style="width:52px"></i></span>
    <span class="cover-end"><Glyph name="x" /></span>
  </span>
</span>
