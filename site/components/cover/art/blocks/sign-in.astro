---
/** Sign in: a card with its title, two fields and the button that signs in. */
---

<span class="cover-sheet cover-stack" style="width:156px; padding:14px; --gap:9px">
  <span style="align-self:center; padding:2px 0 3px"><i class="cover-bar cover-bar-strong" style="width:64px"></i></span>
  <span class="cover-well" style="height:24px; --r:var(--radius-control-sm)"></span>
  <span class="cover-well" style="height:24px; --r:var(--radius-control-sm)"></span>
  <span class="cover-control cover-control-sm cover-ink" style="height:26px"><i class="cover-bar" style="width:36px"></i></span>
</span>
