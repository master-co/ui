---
/** Call to action: a sheet of ink with a title, a line under it and one raised button. */
---

<span class="cover-sheet cover-ink cover-stack" style="align-items:center; width:204px; padding:22px 16px 20px; --gap:0">
  <span class="cover-stack" style="align-items:center; --gap:7px"><i class="cover-bar cover-bar-figure" style="width:132px"></i><i class="cover-bar cover-bar-figure" style="width:92px"></i></span>
  <i class="cover-bar cover-bar-faint" style="width:112px; margin:12px 0 16px"></i>
  <span class="cover-control cover-control-sm" style="--cover-bar:color-mix(in oklch, var(--color-text-strong) 74%, transparent)"><i class="cover-bar" style="width:44px"></i></span>
</span>
