---
/** Schedule view: a month on a sheet: the period's name and the view switch, then weeks of days, whole-day events in lanes, each in its category's tint, and today in ink. */
const cells = Array.from({ length: 21 }, (_, index) => index)
---

<span class="cover-sheet cover-stack" style="width:212px; padding:12px; --gap:10px">
  <span class="cover-line" style="justify-content:space-between"><i class="cover-bar cover-bar-strong" style="width:58px"></i><span class="cover-line" style="--gap:3px"><i class="cover-tone" style="width:20px; height:8px; --r:var(--radius-chip)"></i><i class="cover-flat" style="width:20px; height:8px; --r:var(--radius-chip)"></i><i class="cover-tone" style="width:20px; height:8px; --r:var(--radius-chip)"></i></span></span>
  <span style="position:relative; display:grid; grid-template-columns:repeat(7, 1fr); box-shadow:0 -1px 0 var(--color-line-hair)">
    {cells.map(index => (
      <i style={`display:block; height:26px; box-shadow:0 1px 0 var(--color-line-hair)${index % 7 === 6 ? '' : ', inset -1px 0 0 var(--color-line-hair)'}`}>
        <i class={index === 11 ? 'cover-dot cover-ink' : 'cover-bar cover-bar-faint'} style={index === 11 ? '--d:8px; margin:3px 0 0 3px' : 'width:6px; margin:5px 0 0 4px'}></i>
      </i>
    ))}
    <i class="cover-tone cover-quote cover-hue-1" style="position:absolute; padding:0; left:calc(100% / 7 + 2px); top:14px; width:calc(300% / 7 - 4px); height:8px; --r:2px"></i>
    <i class="cover-tone cover-quote cover-hue-2" style="position:absolute; padding:0; left:calc(400% / 7 + 2px); top:66px; width:calc(300% / 7 - 2px); height:8px; --r:2px"></i>
  </span>
</span>
