---
/** Schedule view: a month on a sheet: the header's name and switch, then weeks of days with an event in a lane and one in ink. */
---

<span class="cover-sheet cover-stack" style="width:212px; padding:14px; --gap:10px">
  <span class="cover-line" style="justify-content:space-between"><i class="cover-bar cover-bar-strong" style="width:64px"></i><span class="cover-line" style="--gap:4px"><i class="cover-tone" style="width:22px; height:8px; --r:var(--radius-chip)"></i><i class="cover-tone" style="width:22px; height:8px; --r:var(--radius-chip)"></i><i class="cover-flat" style="width:22px; height:8px; --r:var(--radius-chip)"></i></span></span>
  <span class="cover-stack" style="--gap:0">
    <span class="cover-rule"></span>
    <span class="cover-line" style="--gap:0; height:26px; align-items:flex-start; padding-top:5px"><i class="cover-bar cover-bar-faint" style="width:8px; margin-left:4px"></i><span style="flex:1"></span></span>
    <span class="cover-line" style="--gap:0; margin-top:-14px; padding:0 2px"><i class="cover-tone" style="width:88px; height:7px; --r:2px"></i></span>
    <span class="cover-rule" style="margin-top:8px"></span>
    <span class="cover-line" style="--gap:0; height:26px; padding:0 2px; justify-content:flex-end"><i class="cover-ink" style="width:56px; height:7px; border-radius:2px; margin-right:28px"></i></span>
    <span class="cover-rule"></span>
  </span>
</span>
