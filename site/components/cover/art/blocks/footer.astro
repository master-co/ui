---
/** Footer: the foot of a page: columns of quiet links over a hairline and the small print. */
---

<span class="cover-sheet cover-stack" style="position:absolute; bottom:10px; left:-12px; justify-content:flex-end; width:264px; height:240px; --gap:0">
  <i class="cover-rule"></i>
  <span class="cover-line" style="align-items:flex-start; padding:18px 28px 16px; --gap:20px">
    <span class="cover-stack" style="--gap:9px"><i class="cover-bar cover-bar-strong" style="width:40px"></i><i class="cover-bar cover-bar-faint" style="width:56px"></i></span>
    <span class="cover-end cover-stack" style="--gap:9px"><i class="cover-bar cover-bar-strong" style="width:28px"></i><i class="cover-bar cover-bar-faint" style="width:36px"></i><i class="cover-bar cover-bar-faint" style="width:28px"></i><i class="cover-bar cover-bar-faint" style="width:40px"></i></span>
    <span class="cover-stack" style="--gap:9px"><i class="cover-bar cover-bar-strong" style="width:32px"></i><i class="cover-bar cover-bar-faint" style="width:40px"></i><i class="cover-bar cover-bar-faint" style="width:24px"></i><i class="cover-bar cover-bar-faint" style="width:32px"></i></span>
    <span class="cover-stack" style="--gap:9px"><i class="cover-bar cover-bar-strong" style="width:24px"></i><i class="cover-bar cover-bar-faint" style="width:28px"></i><i class="cover-bar cover-bar-faint" style="width:36px"></i></span>
  </span>
  <i class="cover-rule" style="align-self:auto; margin:0 28px"></i>
  <span class="cover-line" style="height:34px; padding:0 28px"><i class="cover-bar cover-bar-faint" style="width:56px"></i><span class="cover-end cover-line" style="--gap:10px"><i class="cover-bar cover-bar-faint" style="width:16px"></i><i class="cover-bar cover-bar-faint" style="width:16px"></i></span></span>
</span>
