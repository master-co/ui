---
/** Team: three people side by side, each a face over a name, a role and a line about the work. */
---

<span class="cover-line" style="align-items:stretch; --gap:6px">
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); --cover-surface:var(--color-surface-raised); width:64px; padding:12px 10px; --gap:7px; --d:28px"><i class="cover-avatar cover-avatar-photo" style="margin-bottom:3px"></i><i class="cover-bar cover-bar-strong" style="width:36px"></i><i class="cover-bar" style="width:28px"></i><i class="cover-bar cover-bar-faint" style="width:44px; margin-top:3px"></i><i class="cover-bar cover-bar-faint" style="width:32px"></i></span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); --cover-surface:var(--color-surface-raised); width:64px; padding:12px 10px; --gap:7px; --d:28px"><i class="cover-avatar cover-avatar-photo" style="margin-bottom:3px"></i><i class="cover-bar cover-bar-strong" style="width:40px"></i><i class="cover-bar" style="width:24px"></i><i class="cover-bar cover-bar-faint" style="width:40px; margin-top:3px"></i><i class="cover-bar cover-bar-faint" style="width:44px"></i></span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); --cover-surface:var(--color-surface-raised); width:64px; padding:12px 10px; --gap:7px; --d:28px"><i class="cover-avatar cover-avatar-photo" style="margin-bottom:3px"></i><i class="cover-bar cover-bar-strong" style="width:32px"></i><i class="cover-bar" style="width:36px"></i><i class="cover-bar cover-bar-faint" style="width:44px; margin-top:3px"></i><i class="cover-bar cover-bar-faint" style="width:28px"></i></span>
</span>
