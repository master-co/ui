---
/** Password reset: a card that asks for the new password twice, each hidden as it is typed, and the button that confirms it. */
---

<span class="cover-sheet cover-stack" style="width:156px; padding:14px; --gap:9px">
  <span style="padding:2px 0 3px"><i class="cover-bar cover-bar-strong" style="width:76px"></i></span>
  <span class="cover-well cover-line" style="height:24px; padding:0 9px; --r:var(--radius-control-sm); --gap:4px; --d:5px"><i class="cover-dot"></i><i class="cover-dot"></i><i class="cover-dot"></i><i class="cover-dot"></i><i class="cover-dot"></i><i class="cover-dot"></i><i class="cover-dot"></i></span>
  <span class="cover-well cover-line" style="height:24px; padding:0 9px; --r:var(--radius-control-sm); --gap:4px; --d:5px"><i class="cover-dot"></i><i class="cover-dot"></i><i class="cover-dot"></i><i class="cover-dot"></i><i class="cover-dot"></i><i class="cover-dot"></i><i class="cover-dot"></i></span>
  <span class="cover-control cover-control-sm cover-ink" style="height:26px"><i class="cover-bar" style="width:52px"></i></span>
</span>
