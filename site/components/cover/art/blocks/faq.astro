---
import Glyph from '../../Glyph.astro'

/** FAQ: a title beside a list of questions, the first one open with its answer. */
---

<span class="cover-sheet cover-line" style="align-items:flex-start; width:208px; padding:16px 12px 14px 16px; --gap:14px; --glyph:14px; color:var(--color-text-muted)">
  <span class="cover-stack" style="padding-top:2px; --gap:8px"><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:48px"></i><i class="cover-bar cover-bar-faint" style="width:36px"></i></span>
  <span class="cover-stack" style="flex:1; --gap:0">
    <span class="cover-line" style="height:24px"><i class="cover-bar cover-bar-strong" style="width:56px"></i><span class="cover-end"><Glyph name="chevron-up" /></span></span>
    <span class="cover-stack" style="padding-bottom:10px"><i class="cover-bar" style="width:92px"></i><i class="cover-bar" style="width:64px"></i></span>
    <i class="cover-rule"></i>
    <span class="cover-line" style="height:28px"><i class="cover-bar cover-bar-strong" style="width:44px"></i><span class="cover-end"><Glyph name="chevron-down" /></span></span>
    <i class="cover-rule"></i>
    <span class="cover-line" style="height:28px"><i class="cover-bar cover-bar-strong" style="width:64px"></i><span class="cover-end"><Glyph name="chevron-down" /></span></span>
  </span>
</span>
