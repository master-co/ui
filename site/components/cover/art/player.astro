---
import Glyph from '../Glyph.astro'
/** Player: an audio player as one raised sheet: play, the time so far, a seek track in ink up to its thumb, the length and the sound. */
---

<span class="cover-sheet cover-line" style="--r:calc(var(--radius-control) + 6px); width:212px; padding:6px; --gap:6px; --glyph:16px; color:var(--color-text-muted)">
  <span class="cover-control cover-control-sm cover-square cover-quiet cover-center"><svg class="cover-glyph" viewBox="0 0 24 24" style="--glyph:16px; fill:currentColor; stroke:none"><path d="M7 4.8v14.4a1 1 0 0 0 1.5.86l11.5-7.2a1 1 0 0 0 0-1.72L8.5 3.94A1 1 0 0 0 7 4.8" /></svg></span>
  <i class="cover-bar" style="width:18px"></i>
  <span class="cover-track" style="flex:1; --fill:42%"><i class="cover-knob"></i></span>
  <i class="cover-bar" style="width:18px"></i>
  <span class="cover-control cover-control-sm cover-square cover-quiet cover-center"><Glyph name="volume" /></span>
</span>
