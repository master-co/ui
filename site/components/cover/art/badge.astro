---
/** Badge: small chips beside a title and under it: a category, a status with a dot and a count. */
---

<span class="cover-sheet cover-stack" style="width:192px; padding:16px; --gap:14px">
  <span class="cover-line"><i class="cover-bar cover-bar-strong" style="width:80px"></i><span class="cover-badge"><i class="cover-bar" style="width:24px"></i></span></span>
  <span class="cover-line" style="--gap:6px">
    <span class="cover-badge"><i class="cover-dot" style="--d:6px"></i><i class="cover-bar" style="width:32px"></i></span>
    <span class="cover-badge"><i class="cover-bar" style="width:40px"></i></span>
    <span class="cover-badge cover-round"><i class="cover-bar" style="width:10px"></i></span>
  </span>
</span>
