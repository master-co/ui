---
/** Wheel: two columns of a time in one well; a small sheet lies across the middle, under the value each column has come to rest on. */
---

<span class="cover-sheet" style="padding:12px">
  <span class="cover-well cover-line" style="--r:var(--radius-control-lg); height:108px; padding:0 4px; --gap:0">
    <span class="cover-row cover-row-current" style="--r:calc(var(--radius-control-lg) - 4px / var(--corner-scale)); position:absolute; inset:36px 4px auto; height:36px"></span>
    <span class="cover-wheel" style="position:relative"><span>08</span><span>09</span><span>10</span></span>
    <span style="position:relative; color:var(--color-text-muted); font-size:15px">:</span>
    <span class="cover-wheel" style="position:relative"><span>25</span><span>30</span><span>35</span></span>
  </span>
</span>
