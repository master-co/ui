---
import Glyph from '../Glyph.astro'
/** Alert: a chip-toned message in the flow of a page, with its icon and two lines, above the text it is about. */
---

<span class="cover-sheet cover-stack" style="width:204px; padding:10px 10px 18px; --gap:16px">
  <span class="cover-tone cover-line" style="align-items:flex-start; padding:12px 14px; --gap:10px">
    <span style="color:var(--color-text-muted)"><Glyph name="info" /></span>
    <span class="cover-stack" style="padding-top:5px"><i class="cover-bar cover-bar-strong" style="width:64px"></i><i class="cover-bar" style="width:120px"></i></span>
  </span>
  <span class="cover-stack" style="padding:0 8px"><i class="cover-bar cover-bar-faint" style="width:152px"></i><i class="cover-bar cover-bar-faint" style="width:104px"></i></span>
</span>
