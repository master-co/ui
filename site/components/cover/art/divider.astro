---
/** Divider: one hairline between two sections, parted around a label. */
---

<span class="cover-sheet cover-stack" style="width:184px; padding:18px 16px; --gap:14px">
  <span class="cover-stack">
    <i class="cover-bar cover-bar-strong" style="width:64px"></i>
    <i class="cover-bar" style="width:128px"></i>
  </span>
  <span class="cover-line" style="--gap:10px">
    <i class="cover-rule" style="flex:1; align-self:center"></i>
    <i class="cover-bar cover-bar-faint" style="width:28px"></i>
    <i class="cover-rule" style="flex:1; align-self:center"></i>
  </span>
  <span class="cover-stack">
    <i class="cover-bar" style="width:144px"></i>
    <i class="cover-bar" style="width:96px"></i>
  </span>
</span>
