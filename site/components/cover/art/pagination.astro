---
import Glyph from '../Glyph.astro'
/** Pagination: page numbers as quiet square buttons; the current page stays sunk, and dots stand for the skipped ones. */
---

<span class="cover-sheet cover-line" style="--r:calc(var(--radius-control-sm) + 6px / var(--corner-scale)); padding:6px; --gap:2px">
  <span class="cover-control cover-control-sm cover-square cover-quiet" style="font-size:12.5px">1</span><span class="cover-control cover-control-sm cover-square cover-pressed" style="font-size:12.5px">2</span><span class="cover-control cover-control-sm cover-square cover-quiet" style="font-size:12.5px">3</span>
  <span class="cover-control cover-control-sm cover-square cover-quiet"><Glyph name="dots" /></span>
  <span class="cover-control cover-control-sm cover-square cover-quiet" style="font-size:12.5px">9</span>
</span>
