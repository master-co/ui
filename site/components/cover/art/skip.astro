---
/** Skip link: the top of a page, and the one ink control that has dropped into its corner over the bar because it has focus. */
---

<span class="cover-sheet cover-stack" style="position:absolute; top:10px; left:-12px; width:264px; height:240px; overflow:hidden; --gap:0">
  <span class="cover-line" style="height:56px; padding:0 28px; --gap:16px">
    <i class="cover-bar cover-bar-faint" style="width:52px; margin-left:108px"></i>
    <span class="cover-end cover-line" style="--gap:16px"><i class="cover-bar cover-bar-faint" style="width:28px"></i><i class="cover-bar cover-bar-faint" style="width:32px"></i></span>
  </span>
  <i class="cover-rule"></i>
  <span class="cover-stack" style="padding:22px 28px; --gap:10px"><i class="cover-bar cover-bar-faint cover-bar-figure" style="width:112px"></i><span class="cover-stack" style="padding-top:6px"><i class="cover-bar cover-bar-faint" style="width:184px"></i><i class="cover-bar cover-bar-faint" style="width:148px"></i></span></span>
</span>
<span class="cover-control cover-control-sm cover-ink" style="position:absolute; top:22px; left:16px; outline:2px solid var(--color-focus); outline-offset:2px"><i class="cover-bar" style="width:64px"></i></span>
