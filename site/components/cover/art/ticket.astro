---
/** Ticket: a pass in two faces that meet on a perforation between two notches: the journey above, the seat and its code on the stub. */
---

<span class="cover-stack" style="width:184px; --gap:0">
  <span class="cover-ticket cover-stack" style="padding:16px 16px 18px; --gap:12px">
    <i class="cover-bar cover-bar-faint" style="width:48px"></i>
    <span class="cover-line" style="justify-content:space-between"><i class="cover-bar cover-bar-figure cover-bar-strong" style="width:44px"></i><i class="cover-bar cover-bar-faint" style="width:28px; height:2px"></i><i class="cover-bar cover-bar-figure cover-bar-strong" style="width:44px"></i></span>
    <i class="cover-bar" style="width:104px"></i>
  </span>
  <span class="cover-stub cover-line" style="justify-content:space-between; padding:13px 16px 14px">
    <i class="cover-bar cover-bar-strong" style="width:40px"></i>
    <span class="cover-key"><i class="cover-bar" style="width:36px"></i></span>
  </span>
</span>
