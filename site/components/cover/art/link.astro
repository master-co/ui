---
import Glyph from '../Glyph.astro'
/** Link: three lines of a paragraph; one phrase is the ink of its sentence over an underline. */
---

<span class="cover-sheet cover-stack" style="width:192px; padding:22px 18px; --gap:16px">
  <i class="cover-bar" style="width:156px"></i>
  <span class="cover-line" style="--gap:8px">
    <i class="cover-bar" style="width:36px"></i>
    <span class="cover-link" style="--glyph:12px"><i class="cover-bar cover-bar-strong" style="width:64px"></i><Glyph name="arrow-up-right" /></span>
    <i class="cover-bar" style="width:24px"></i>
  </span>
  <i class="cover-bar" style="width:112px"></i>
</span>
