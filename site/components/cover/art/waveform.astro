---
/** Waveform: a voice message in a received bubble: a play button, a row of thin bars in ink as far as it has played, and its length. */
---

<span class="cover-bubble cover-line" style="padding:8px 14px 8px 8px; --gap:10px">
  <span class="cover-control cover-control-sm cover-square cover-round"><svg class="cover-glyph" viewBox="0 0 24 24" style="--glyph:14px; fill:currentColor; stroke:none"><path d="M8 5.6v12.8a1 1 0 0 0 1.5.86l10.2-6.4a1 1 0 0 0 0-1.72L9.5 4.74A1 1 0 0 0 8 5.6" /></svg></span>
  <span class="cover-line" style="height:32px; --gap:2px"><i class="cover-tick" style="flex:none; width:3px; height:8px; --tone:100%"></i><i class="cover-tick" style="flex:none; width:3px; height:14px; --tone:100%"></i><i class="cover-tick" style="flex:none; width:3px; height:22px; --tone:100%"></i><i class="cover-tick" style="flex:none; width:3px; height:18px; --tone:100%"></i><i class="cover-tick" style="flex:none; width:3px; height:28px; --tone:100%"></i><i class="cover-tick" style="flex:none; width:3px; height:32px; --tone:100%"></i><i class="cover-tick" style="flex:none; width:3px; height:24px; --tone:100%"></i><i class="cover-tick" style="flex:none; width:3px; height:16px; --tone:100%"></i><i class="cover-tick" style="flex:none; width:3px; height:12px; --tone:100%"></i><i class="cover-tick" style="flex:none; width:3px; height:20px"></i><i class="cover-tick" style="flex:none; width:3px; height:26px"></i><i class="cover-tick" style="flex:none; width:3px; height:18px"></i><i class="cover-tick" style="flex:none; width:3px; height:10px"></i><i class="cover-tick" style="flex:none; width:3px; height:16px"></i><i class="cover-tick" style="flex:none; width:3px; height:24px"></i><i class="cover-tick" style="flex:none; width:3px; height:30px"></i><i class="cover-tick" style="flex:none; width:3px; height:20px"></i><i class="cover-tick" style="flex:none; width:3px; height:14px"></i><i class="cover-tick" style="flex:none; width:3px; height:10px"></i><i class="cover-tick" style="flex:none; width:3px; height:16px"></i><i class="cover-tick" style="flex:none; width:3px; height:12px"></i><i class="cover-tick" style="flex:none; width:3px; height:6px"></i></span>
  <i class="cover-bar" style="width:22px"></i>
</span>
