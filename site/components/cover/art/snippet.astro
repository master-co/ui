---
import Glyph from '../Glyph.astro'
/** Snippet: a command in a well, its prompt before it and a copy button at its end, under a row of package managers with the chosen one risen. */
---

<span class="cover-sheet" style="width:200px; padding:16px">
  <span class="cover-well cover-stack" style="--gap:0">
    <span class="cover-line" style="height:38px; padding:0 4px; --gap:2px">
      <span class="cover-row cover-row-current" style="--r:calc(var(--radius-control) - 4px / var(--corner-scale)); height:30px; padding:0 10px"><i class="cover-bar cover-bar-strong" style="width:20px"></i></span>
      <span class="cover-row" style="height:30px; padding:0 10px"><i class="cover-bar" style="width:28px"></i></span>
      <span class="cover-row" style="height:30px; padding:0 10px"><i class="cover-bar" style="width:20px"></i></span>
    </span>
    <i class="cover-rule"></i>
    <span class="cover-line" style="height:38px; padding:0 4px 0 12px; --gap:8px">
      <span style="color:var(--color-text-muted); font:400 13px/1 var(--font-family-mono)">$</span>
      <i class="cover-bar cover-bar-strong" style="width:88px"></i>
      <span class="cover-end cover-center" style="width:30px; height:30px; --glyph:14px; color:var(--color-text-body)"><Glyph name="copy" /></span>
    </span>
  </span>
</span>
