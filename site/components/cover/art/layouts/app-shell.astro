---
/** App shell: a plan of a sidebar that stays, with its current row, beside a main region under a bar. */
---

<span class="cover-sheet cover-plan cover-line" style="align-items:stretch; width:208px; height:130px; --gap:0">
  <span class="cover-stack" style="width:62px; padding:11px 8px; --gap:0">
    <span style="padding:0 4px 9px"><i class="cover-bar cover-bar-strong" style="width:24px"></i></span>
    <span class="cover-line" style="height:16px; padding:0 4px"><i class="cover-bar" style="width:30px"></i></span>
    <span class="cover-tone cover-skeleton cover-line" style="height:16px; padding:0 4px"><i class="cover-bar cover-bar-strong" style="width:34px"></i></span>
    <span class="cover-line" style="height:16px; padding:0 4px"><i class="cover-bar" style="width:26px"></i></span>
    <span class="cover-line" style="height:16px; padding:0 4px"><i class="cover-bar" style="width:36px"></i></span>
  </span>
  <i class="cover-rule cover-rule-upright"></i>
  <span class="cover-stack" style="flex:1; --gap:0">
    <span class="cover-line" style="height:22px; padding:0 10px"><i class="cover-bar cover-bar-strong" style="width:32px"></i><span class="cover-end"><i class="cover-bar cover-bar-strong" style="width:16px"></i></span></span>
    <i class="cover-rule"></i>
    <span style="display:grid; grid-template-columns:1fr 1fr; gap:6px; padding:10px"><i class="cover-tone cover-skeleton" style="display:block; height:36px"></i><i class="cover-tone cover-skeleton" style="display:block; height:36px"></i><i class="cover-tone cover-skeleton" style="display:block; height:36px"></i><i class="cover-tone cover-skeleton" style="display:block; height:36px"></i></span>
  </span>
</span>
