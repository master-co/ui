---
/** Form: two short fields side by side in a row, each under its label, and the actions that close the form. */
---

<span class="cover-sheet cover-stack" style="width:204px; padding:16px; --gap:16px">
  <span class="cover-line" style="--gap:12px">
    <span class="cover-stack" style="flex:1"><i class="cover-bar cover-bar-strong" style="width:36px"></i><span class="cover-well" style="height:40px"></span></span>
    <span class="cover-stack" style="flex:1"><i class="cover-bar cover-bar-strong" style="width:48px"></i><span class="cover-well" style="height:40px"></span></span>
  </span>
  <span class="cover-line" style="justify-content:flex-end">
    <span class="cover-control cover-control-sm"><i class="cover-bar cover-bar-strong" style="width:32px"></i></span>
    <span class="cover-control cover-control-sm cover-ink"><i class="cover-bar" style="width:28px"></i></span>
  </span>
</span>
