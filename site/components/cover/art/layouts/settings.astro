---
/** Settings: a short navigation with its current row, beside a field and the button that saves it. */
---

<span class="cover-sheet cover-line" style="align-items:flex-start; width:204px; padding:12px 14px 14px 8px; --gap:10px">
  <span class="cover-stack" style="width:64px; --gap:2px">
    <span class="cover-row cover-row-current" style="height:28px"><i class="cover-bar cover-bar-strong" style="width:32px"></i></span>
    <span class="cover-row" style="height:28px"><i class="cover-bar" style="width:28px"></i></span>
    <span class="cover-row" style="height:28px"><i class="cover-bar" style="width:36px"></i></span>
  </span>
  <span class="cover-stack" style="flex:1; padding-top:6px; --gap:8px">
    <i class="cover-bar cover-bar-strong" style="width:36px"></i>
    <span class="cover-well" style="height:32px; --r:var(--radius-control-sm)"></span>
    <span class="cover-control cover-control-sm cover-ink" style="align-self:flex-end; margin-top:4px"><i class="cover-bar" style="width:24px"></i></span>
  </span>
</span>
