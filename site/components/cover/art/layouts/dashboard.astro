---
/** Dashboard: three figures across the top and a wide panel under them. */
---

<span class="cover-stack" style="width:204px; --gap:8px">
  <span style="display:grid; grid-template-columns:repeat(3, 1fr); gap:8px">
    <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); padding:11px 10px; --gap:9px"><i class="cover-bar cover-bar-faint" style="width:28px"></i><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:34px"></i></span>
    <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); padding:11px 10px; --gap:9px"><i class="cover-bar cover-bar-faint" style="width:22px"></i><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:26px"></i></span>
    <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); padding:11px 10px; --gap:9px"><i class="cover-bar cover-bar-faint" style="width:32px"></i><i class="cover-bar cover-bar-strong cover-bar-figure" style="width:30px"></i></span>
  </span>
  <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); padding:12px 12px 14px; --gap:9px">
    <span class="cover-line"><i class="cover-bar cover-bar-strong" style="width:44px"></i><span class="cover-end"><i class="cover-bar cover-bar-faint" style="width:24px"></i></span></span>
    <i class="cover-rule"></i>
    <span class="cover-line"><i class="cover-bar" style="width:64px"></i><span class="cover-end"><i class="cover-bar" style="width:20px"></i></span></span>
    <span class="cover-line"><i class="cover-bar" style="width:48px"></i><span class="cover-end"><i class="cover-bar" style="width:28px"></i></span></span>
  </span>
</span>
