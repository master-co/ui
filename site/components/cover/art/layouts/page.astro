---
/** Page: a plan of a header, a main column at a reading measure and a footer at the foot. */
---

<span class="cover-sheet cover-plan cover-stack" style="width:208px; height:130px; --gap:0">
  <span class="cover-line" style="height:22px; padding:0 12px; --gap:8px"><i class="cover-bar cover-bar-strong" style="width:20px"></i><i class="cover-bar" style="width:14px"></i><i class="cover-bar" style="width:14px"></i><span class="cover-end"><i class="cover-bar cover-bar-strong" style="width:18px"></i></span></span>
  <i class="cover-rule"></i>
  <span class="cover-stack" style="flex:1; align-self:center; justify-content:center; width:104px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:64px"></i><i class="cover-bar cover-bar-faint" style="width:104px"></i><i class="cover-bar cover-bar-faint" style="width:88px"></i><i class="cover-bar cover-bar-faint" style="width:96px"></i></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:20px; padding:0 12px"><i class="cover-bar cover-bar-faint" style="width:32px"></i><span class="cover-end cover-line" style="--gap:6px"><i class="cover-bar cover-bar-faint" style="width:14px"></i><i class="cover-bar cover-bar-faint" style="width:14px"></i></span></span>
</span>
