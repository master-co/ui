---
/** Arrangements: a split, with a title at the start and a button at the end, over a cluster of chips that wraps. */
---

<span class="cover-sheet cover-stack" style="width:204px; padding:14px 16px 16px; --gap:14px">
  <span class="cover-line"><i class="cover-bar cover-bar-strong" style="width:64px"></i><span class="cover-end cover-control cover-control-sm"><i class="cover-bar cover-bar-strong" style="width:28px"></i></span></span>
  <span class="cover-line" style="flex-wrap:wrap; --gap:6px">
    <span class="cover-chip"><i class="cover-bar" style="width:28px"></i></span><span class="cover-chip"><i class="cover-bar" style="width:44px"></i></span><span class="cover-chip"><i class="cover-bar" style="width:36px"></i></span><span class="cover-chip"><i class="cover-bar" style="width:52px"></i></span>
  </span>
</span>
