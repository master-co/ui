---
/** Mark: three lines of a result; one phrase under a wash of highlighter, and the match the reader stepped to in ink. */
---

<span class="cover-sheet cover-stack" style="width:200px; padding:16px; --gap:6px">
  <span class="cover-line" style="height:18px"><i class="cover-bar" style="width:44px"></i><span class="cover-mark"><i class="cover-bar cover-bar-strong" style="width:56px"></i></span><i class="cover-bar" style="width:40px"></i></span>
  <span class="cover-line" style="height:18px"><i class="cover-bar" style="width:136px"></i></span>
  <span class="cover-line" style="height:18px"><i class="cover-bar" style="width:28px"></i><span class="cover-mark cover-ink"><i class="cover-bar" style="width:44px"></i></span><i class="cover-bar" style="width:64px"></i></span>
</span>
