---
/** Splitter: two panes on one sheet and the handle between them, touched: the line is ink and carries its grip. */
---

<span class="cover-sheet cover-line" style="align-items:stretch; width:204px; height:116px; --gap:0">
  <span class="cover-stack" style="width:78px; padding:16px 14px"><i class="cover-bar cover-bar-strong" style="width:40px"></i><i class="cover-bar" style="width:50px"></i><i class="cover-bar" style="width:32px"></i></span>
  <i class="cover-rule cover-rule-upright cover-ink" style="margin:0"><i class="cover-grip"></i></i>
  <span class="cover-stack" style="padding:16px 14px"><i class="cover-bar cover-bar-strong" style="width:56px"></i><i class="cover-bar" style="width:96px"></i><i class="cover-bar" style="width:72px"></i><i class="cover-bar" style="width:88px"></i></span>
</span>
