---
/** Choice: two options that explain themselves; the chosen one has risen onto an ink contour. */
---

<span class="cover-stack" style="width:196px">
  <span class="cover-flat cover-chosen cover-line" style="align-items:flex-start; padding:14px; --gap:12px">
    <i class="cover-check cover-check-round cover-check-on"></i>
    <span class="cover-stack" style="padding-top:1px"><i class="cover-bar cover-bar-strong" style="width:56px"></i><i class="cover-bar" style="width:112px"></i></span>
  </span>
  <span class="cover-flat cover-line" style="align-items:flex-start; padding:14px; --gap:12px">
    <i class="cover-check cover-check-round"></i>
    <span class="cover-stack" style="padding-top:1px"><i class="cover-bar cover-bar-strong" style="width:44px"></i><i class="cover-bar" style="width:88px"></i></span>
  </span>
</span>
