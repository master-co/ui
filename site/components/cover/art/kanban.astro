---
import Glyph from '../Glyph.astro'
/** Kanban: two columns of a board at real size, running off the stage; a card carried from the first floats over the line that marks its place in the second. */
---

<span class="cover-sheet cover-line" style="position:absolute; top:10px; left:10px; align-items:flex-start; width:420px; height:200px; padding:10px; --gap:10px; --glyph:14px; color:var(--color-text-muted)">
  <span class="cover-tray cover-stack" style="--r:var(--radius-control-lg); --inset:6px; flex:none; width:118px; padding:0 6px 6px; --gap:6px">
    <span class="cover-line" style="height:34px; padding:0 12px"><i class="cover-bar cover-bar-strong" style="width:40px"></i></span>
    <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); padding:12px; --gap:10px; opacity:.45">
      <span class="cover-line"><i class="cover-bar cover-bar-strong" style="width:56px"></i><span class="cover-end"><Glyph name="grip" /></span></span>
      <span class="cover-line"><i class="cover-badge"><i class="cover-bar" style="width:22px"></i></i><span class="cover-end cover-avatar" style="--d:16px; --cover-surface:var(--color-surface-raised)"></span></span>
    </span>
    <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); padding:12px; --gap:10px">
      <span class="cover-line"><i class="cover-bar cover-bar-strong" style="width:44px"></i><span class="cover-end"><Glyph name="grip" /></span></span>
      <span class="cover-line"><i class="cover-badge"><i class="cover-bar" style="width:28px"></i></i><span class="cover-end cover-avatar" style="--d:16px; --cover-surface:var(--color-surface-raised)"></span></span>
    </span>
  </span>
  <span class="cover-tray cover-stack" style="--r:var(--radius-control-lg); --inset:6px; flex:none; width:118px; padding:0 6px 6px; --gap:6px">
    <span class="cover-line" style="height:34px; padding:0 12px"><i class="cover-bar cover-bar-strong" style="width:52px"></i></span>
    <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); padding:12px; --gap:10px">
      <span class="cover-line"><i class="cover-bar cover-bar-strong" style="width:48px"></i><span class="cover-end"><Glyph name="grip" /></span></span>
      <span class="cover-line"><i class="cover-badge"><i class="cover-bar" style="width:24px"></i></i><span class="cover-end cover-avatar" style="--d:16px; --cover-surface:var(--color-surface-raised)"></span></span>
    </span>
    <i class="cover-ink" style="display:block; height:2px; margin:-4px 0; border-radius:1px"></i>
    <span class="cover-sheet cover-stack" style="--r:var(--radius-control-lg); padding:12px; --gap:10px">
      <span class="cover-line"><i class="cover-bar cover-bar-strong" style="width:60px"></i><span class="cover-end"><Glyph name="grip" /></span></span>
      <span class="cover-line"><i class="cover-badge"><i class="cover-bar" style="width:20px"></i></i><span class="cover-end cover-avatar" style="--d:16px; --cover-surface:var(--color-surface-raised)"></span></span>
    </span>
  </span>
  <span class="cover-float cover-line" style="--r:var(--radius-control-lg); position:absolute; left:78px; top:60px; width:106px; height:36px; padding:0 12px; color:var(--color-text-strong)"><i class="cover-bar cover-bar-strong" style="width:56px"></i><span class="cover-end"><Glyph name="grip" /></span></span>
</span>
