---
import Glyph from '../Glyph.astro'
/** Listbox: a floating list of options; the keys are on one and another is the chosen value. */
---

<span class="cover-float cover-stack" style="--r:calc(var(--radius-control-sm) + 4px / var(--corner-scale)); width:172px; padding:4px; --gap:0">
  <span class="cover-row"><i class="cover-bar" style="width:64px"></i></span>
  <span class="cover-row cover-row-active"><i class="cover-bar cover-bar-strong" style="width:84px"></i></span>
  <span class="cover-row cover-row-checked"><i class="cover-bar cover-bar-strong" style="width:56px"></i><span class="cover-end"><Glyph name="check" /></span></span>
  <span class="cover-row"><i class="cover-bar" style="width:72px"></i></span>
</span>
