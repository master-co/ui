---
import Glyph from '../Glyph.astro'
/** File: two files as flat sheets, each a small folded page beside its name and facts; the second is tinted as far as its upload has come. */
---

<span class="cover-stack" style="width:204px; --gap:8px; --glyph:14px; color:var(--color-text-muted)">
  <span class="cover-flat cover-line" style="padding:10px 14px 10px 10px; --gap:12px">
    <span class="cover-page"><i class="cover-bar cover-bar-faint" style="width:12px; height:3px"></i></span>
    <span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:84px"></i><i class="cover-bar" style="width:52px"></i></span>
    <span class="cover-end"><Glyph name="x" /></span>
  </span>
  <span class="cover-flat cover-line" style="padding:10px 14px 10px 10px; --gap:12px; background:linear-gradient(90deg, var(--color-surface-chip) 58%, transparent 0) var(--color-surface-raised)">
    <span class="cover-page"><i class="cover-bar cover-bar-faint" style="width:12px; height:3px"></i></span>
    <span class="cover-stack"><i class="cover-bar cover-bar-strong" style="width:64px"></i><i class="cover-bar" style="width:76px"></i></span>
    <span class="cover-end"><Glyph name="x" /></span>
  </span>
</span>
