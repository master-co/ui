---
/** Results: a plan of a page under a bar: a search across the top, the conditions in a column beside it and the results as tiles. */
---

<span class="cover-sheet cover-plan cover-stack" style="width:208px; height:130px; --gap:0">
  <span class="cover-line" style="height:20px; padding:0 10px"><i class="cover-bar cover-bar-strong" style="width:22px"></i><span class="cover-end"><i class="cover-bar cover-bar-faint" style="width:32px"></i></span></span>
  <i class="cover-rule"></i>
  <span class="cover-stack" style="flex:1; padding:10px 12px 0; --gap:8px">
    <span class="cover-line" style="--gap:6px"><span class="cover-well" style="flex:1; height:14px; --r:var(--radius-chip)"></span><i class="cover-bar cover-bar-faint" style="width:24px"></i></span>
    <span class="cover-line" style="flex:1; align-items:stretch; --gap:10px">
      <span class="cover-stack" style="width:44px; padding-top:2px; --gap:7px">
        <i class="cover-bar cover-bar-strong" style="width:24px"></i>
        <span class="cover-line" style="--gap:5px"><i class="cover-tone" style="width:7px; height:7px; --r:2px"></i><i class="cover-bar" style="width:26px"></i></span>
        <span class="cover-line" style="--gap:5px"><i class="cover-tone" style="width:7px; height:7px; --r:2px"></i><i class="cover-bar" style="width:20px"></i></span>
        <span class="cover-line" style="--gap:5px"><i class="cover-tone" style="width:7px; height:7px; --r:2px"></i><i class="cover-bar" style="width:30px"></i></span>
      </span>
      <span style="flex:1; display:grid; grid-template-columns:repeat(3, 1fr); grid-auto-rows:30px; gap:6px"><i class="cover-tone cover-skeleton" style="display:block"></i><i class="cover-tone cover-skeleton" style="display:block"></i><i class="cover-tone cover-skeleton" style="display:block"></i><i class="cover-tone cover-skeleton" style="display:block"></i><i class="cover-tone cover-skeleton" style="display:block"></i><i class="cover-tone cover-skeleton" style="display:block"></i></span>
    </span>
  </span>
</span>
