---
/** Holy grail: a plan of a header, three columns with the middle one widest, and a footer across the foot. */
---

<span class="cover-sheet cover-plan cover-stack" style="width:208px; height:130px; --gap:0">
  <span class="cover-line" style="height:20px; padding:0 10px"><i class="cover-bar cover-bar-strong" style="width:22px"></i><span class="cover-end"><i class="cover-bar cover-bar-strong" style="width:16px"></i></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="flex:1; align-items:stretch; --gap:0">
    <span class="cover-stack" style="width:42px; padding:10px 8px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:24px"></i><i class="cover-bar" style="width:20px"></i><i class="cover-bar" style="width:26px"></i></span>
    <i class="cover-rule cover-rule-upright"></i>
    <span class="cover-stack" style="flex:1; padding:10px 12px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:52px"></i><i class="cover-bar cover-bar-faint" style="width:88px"></i><i class="cover-bar cover-bar-faint" style="width:72px"></i><i class="cover-bar cover-bar-faint" style="width:80px"></i></span>
    <i class="cover-rule cover-rule-upright"></i>
    <span class="cover-stack" style="width:46px; padding:10px 8px; --gap:7px"><i class="cover-bar cover-bar-faint" style="width:22px"></i><i class="cover-bar" style="width:28px"></i><i class="cover-bar" style="width:20px"></i></span>
  </span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="height:18px; padding:0 10px"><i class="cover-bar cover-bar-faint" style="width:28px"></i><span class="cover-end"><i class="cover-bar cover-bar-faint" style="width:36px"></i></span></span>
</span>
