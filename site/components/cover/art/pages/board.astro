---
/** Board: a plan of a sidebar that stays beside a bar and, under it, the columns of a board that run off the end, each holding a few cards. */
---

<span class="cover-sheet cover-plan cover-line" style="align-items:stretch; width:208px; height:130px; --gap:0">
  <span class="cover-stack" style="width:44px; padding:11px 8px; --gap:8px">
    <i class="cover-bar cover-bar-strong" style="width:20px; margin-bottom:2px"></i>
    <i class="cover-bar" style="width:24px"></i>
    <i class="cover-bar cover-bar-strong" style="width:28px"></i>
    <i class="cover-bar" style="width:18px"></i>
  </span>
  <i class="cover-rule cover-rule-upright"></i>
  <span class="cover-stack" style="flex:1; min-width:0; --gap:0">
    <span class="cover-line" style="height:22px; padding:0 10px"><i class="cover-bar cover-bar-strong" style="width:32px"></i><span class="cover-end"><i class="cover-bar cover-bar-faint" style="width:18px"></i></span></span>
    <i class="cover-rule"></i>
    <span class="cover-line" style="flex:1; align-items:flex-start; padding:9px 0 0 10px; --gap:6px; overflow:hidden">
      <span class="cover-tray cover-stack" style="--r:4px; --inset:3px; flex:none; width:46px; padding:6px 3px 3px; --gap:3px"><i class="cover-bar cover-bar-strong" style="width:20px; margin:0 4px 3px"></i><i class="cover-sheet" style="--r:4px; display:block; height:16px"></i><i class="cover-sheet" style="--r:4px; display:block; height:22px"></i><i class="cover-sheet" style="--r:4px; display:block; height:16px"></i></span>
      <span class="cover-tray cover-stack" style="--r:4px; --inset:3px; flex:none; width:46px; padding:6px 3px 3px; --gap:3px"><i class="cover-bar cover-bar-strong" style="width:26px; margin:0 4px 3px"></i><i class="cover-sheet" style="--r:4px; display:block; height:22px"></i><i class="cover-sheet" style="--r:4px; display:block; height:16px"></i></span>
      <span class="cover-tray cover-stack" style="--r:4px; --inset:3px; flex:none; width:46px; padding:6px 3px 3px; --gap:3px"><i class="cover-bar cover-bar-strong" style="width:16px; margin:0 4px 3px"></i><i class="cover-sheet" style="--r:4px; display:block; height:16px"></i></span>
      <span class="cover-tray cover-stack" style="--r:4px; --inset:3px; flex:none; width:46px; padding:6px 3px 3px; --gap:3px"><i class="cover-bar cover-bar-strong" style="width:22px; margin:0 4px 3px"></i><i class="cover-sheet" style="--r:4px; display:block; height:16px"></i><i class="cover-sheet" style="--r:4px; display:block; height:16px"></i></span>
    </span>
  </span>
</span>
