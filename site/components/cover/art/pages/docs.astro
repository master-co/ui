---
/** Documentation: a plan of three columns under a bar: the navigation, the article and the contents of the page. */
---

<span class="cover-sheet cover-plan cover-stack" style="width:208px; height:130px; --gap:0">
  <span class="cover-line" style="height:20px; padding:0 10px"><i class="cover-bar cover-bar-strong" style="width:22px"></i><span class="cover-end"><i class="cover-bar cover-bar-faint" style="width:36px"></i></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="flex:1; align-items:stretch; --gap:0">
    <span class="cover-stack" style="width:48px; padding:10px 8px; --gap:7px"><i class="cover-bar cover-bar-faint" style="width:20px"></i><i class="cover-bar" style="width:28px"></i><i class="cover-bar cover-bar-strong" style="width:32px"></i><i class="cover-bar" style="width:24px"></i><i class="cover-bar" style="width:30px"></i></span>
    <i class="cover-rule cover-rule-upright"></i>
    <span class="cover-stack" style="flex:1; padding:11px 12px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:48px"></i><i class="cover-bar cover-bar-faint" style="width:88px"></i><i class="cover-bar cover-bar-faint" style="width:76px"></i><i class="cover-bar cover-bar-faint" style="width:84px"></i><i class="cover-bar cover-bar-faint" style="width:60px"></i></span>
    <span class="cover-rail cover-stack" style="align-self:flex-start; width:40px; margin:12px 8px 0 0; padding-left:6px; --gap:7px"><i class="cover-bar cover-bar-strong" style="width:22px"></i><i class="cover-bar" style="width:28px"></i><i class="cover-bar" style="width:18px"></i></span>
  </span>
</span>
