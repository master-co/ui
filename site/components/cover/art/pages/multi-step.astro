---
/** Multi-step task: a plan of a page under a bar: the steps down one side, one done and one current, beside the fields of the step in hand and the way on. */
---

<span class="cover-sheet cover-plan cover-stack" style="width:208px; height:130px; --gap:0">
  <span class="cover-line" style="height:20px; padding:0 10px"><i class="cover-bar cover-bar-strong" style="width:22px"></i><span class="cover-end"><i class="cover-bar cover-bar-faint" style="width:26px"></i></span></span>
  <i class="cover-rule"></i>
  <span class="cover-line" style="flex:1; align-items:flex-start; padding:14px 14px 0; --gap:16px">
    <span class="cover-stack" style="width:58px; --gap:9px">
      <span class="cover-line" style="--gap:6px"><i class="cover-dot cover-ink" style="--d:8px"></i><i class="cover-bar" style="width:30px"></i></span>
      <span class="cover-line" style="--gap:6px"><i class="cover-dot" style="--d:8px; box-shadow:0 0 0 1px var(--color-text-strong)"></i><i class="cover-bar cover-bar-strong" style="width:38px"></i></span>
      <span class="cover-line" style="--gap:6px"><i class="cover-dot" style="--d:8px"></i><i class="cover-bar cover-bar-faint" style="width:26px"></i></span>
    </span>
    <span class="cover-stack" style="flex:1; --gap:7px">
      <i class="cover-bar cover-bar-strong" style="width:44px"></i>
      <span class="cover-well" style="height:14px; margin-top:2px; --r:var(--radius-chip)"></span>
      <span class="cover-well" style="height:14px; --r:var(--radius-chip)"></span>
      <span class="cover-line" style="justify-content:flex-end; margin-top:4px; --gap:5px"><i class="cover-tone" style="width:24px; height:12px; --r:var(--radius-chip)"></i><i class="cover-tone" style="width:28px; height:12px; --r:var(--radius-chip); background:var(--color-text-muted); box-shadow:none"></i></span>
    </span>
  </span>
</span>
