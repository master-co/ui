---
/** Master-detail: a list with one row chosen, beside what that row holds. */
---

<span class="cover-sheet cover-line" style="align-items:stretch; width:204px; height:120px; overflow:hidden; --gap:0">
  <span class="cover-stack" style="width:84px; padding:6px; --gap:2px">
    <span class="cover-row"><i class="cover-bar" style="width:44px"></i></span>
    <span class="cover-row cover-row-active"><i class="cover-bar cover-bar-strong" style="width:52px"></i></span>
    <span class="cover-row"><i class="cover-bar" style="width:36px"></i></span>
  </span>
  <i class="cover-rule cover-rule-upright" style="margin:0"></i>
  <span class="cover-stack" style="flex:1; padding:16px 14px; --gap:10px"><i class="cover-bar cover-bar-strong" style="width:48px"></i><i class="cover-bar cover-bar-faint" style="width:84px"></i><i class="cover-bar cover-bar-faint" style="width:64px"></i><span class="cover-control cover-control-sm" style="align-self:flex-start; margin-top:6px"><i class="cover-bar cover-bar-strong" style="width:24px"></i></span></span>
</span>
