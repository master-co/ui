---
import Glyph from '../Glyph.astro'
/** Editor: a field on a sheet whose well holds a flat band of quiet tools over a hairline, then lines of text and a caret. */
---

<span class="cover-sheet cover-stack" style="width:212px; padding:14px; --gap:8px">
  <i class="cover-bar cover-bar-strong" style="width:52px"></i>
  <span class="cover-well cover-stack" style="--r:var(--radius-control-lg); --gap:0">
    <span class="cover-line" style="padding:3px; --gap:1px">
      <span class="cover-control cover-control-sm cover-square cover-pressed"><Glyph name="bold" /></span>
      <span class="cover-control cover-control-sm cover-square cover-quiet"><Glyph name="italic" /></span>
      <span class="cover-control cover-control-sm cover-square cover-quiet"><Glyph name="align-left" /></span>
      <span class="cover-control cover-control-sm cover-square cover-quiet"><Glyph name="link" /></span>
    </span>
    <i class="cover-rule"></i>
    <span class="cover-stack" style="padding:10px 12px 14px; --gap:8px">
      <i class="cover-bar cover-bar-strong" style="width:84px"></i>
      <span class="cover-line" style="--gap:4px"><i class="cover-bar" style="width:132px"></i></span>
      <span class="cover-line" style="--gap:2px"><i class="cover-bar" style="width:96px"></i><i class="cover-caret"></i></span>
    </span>
  </span>
</span>
