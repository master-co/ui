---
import Glyph from '../Glyph.astro'
/** Lightbox: a picture standing large over the page it dims, with a close button in its corner and its caption on a bar under it. */
---

<span class="cover-sheet" style="position:absolute; top:6px; left:-12px; width:264px; height:240px"></span>
<i class="cover-scrim"></i>
<span class="cover-stack" style="position:relative; width:176px; --gap:6px">
  <span class="cover-media" style="--r:var(--radius-control-lg); display:block; height:100px; background:linear-gradient(160deg, color-mix(in oklch, var(--color-text-strong) 5%, var(--color-surface-floating)), color-mix(in oklch, var(--color-text-strong) 14%, var(--color-surface-floating))); box-shadow:inset 0 0 0 .5px var(--color-line-contour), var(--shadow-floating)">
    <span class="cover-control cover-control-sm cover-square" style="position:absolute; top:6px; right:6px; width:22px; height:22px; --r:var(--radius-chip); --glyph:12px"><Glyph name="x" /></span>
  </span>
  <span class="cover-float cover-center" style="--r:var(--radius-control-sm); height:22px"><i class="cover-bar" style="width:96px"></i></span>
</span>
