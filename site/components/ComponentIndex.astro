---
import { components } from '~/site/components/catalog'
import { siteOf } from '@master/internal-site/astro/site-context'
const { t } = siteOf(Astro)
---

<ul class="component-index">
  {components.map(component => (
    <li>
      <a class="component-index-item" href={`/components/${component.slug}`}>
        <span class="component-index-name">{t(component.name)}</span>
        <span class="component-index-description">{t(component.description)}</span>
      </a>
    </li>
  ))}
</ul>

<style is:global>
  @layer components {
    .component-index {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
      gap: .75rem;
      margin: 1.5rem 0 0;
      padding: 0;
      list-style: none;
    }

    .component-index-item {
      display: flex;
      flex-direction: column;
      gap: .375rem;
      height: 100%;
      padding: 1rem 1.125rem;
      border-radius: .75rem;
      box-shadow: 0 0 0 1px var(--color-line-divider);
      color: var(--color-text-body);
      text-decoration: none;
      transition: box-shadow var(--duration-fast) var(--easing-smooth);

      &:hover {
        box-shadow: 0 0 0 1px var(--color-line-control), var(--shadow-sm);
      }
    }

    .component-index-name {
      color: var(--color-text-strong);
      font-weight: 600;
    }

    .component-index-description {
      font-size: .875rem;
      line-height: 1.5;
    }
  }
</style>
