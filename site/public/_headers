/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# What programs read is open to any origin: a registry client, an agent in a browser sandbox, a CDN-less demo.
/r/*
  Access-Control-Allow-Origin: *
/*.json
  Access-Control-Allow-Origin: *
/*.md
  Access-Control-Allow-Origin: *
  Content-Type: text/markdown; charset=utf-8
/*.css
  Access-Control-Allow-Origin: *
/llms.txt
  Access-Control-Allow-Origin: *

# The production alias and every immutable deployment URL on pages.dev serve the canonical site's content;
# keep both host shapes out of search indexes without affecting ui.master.co. Release delivery requires it.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:deployment.:project.pages.dev/*
  X-Robots-Tag: noindex
