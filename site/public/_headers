/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Named by their content, so a change is a new URL: never ask again. Each page links some 50 of these, and from
# far away a revalidation costs a round trip apiece.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/preview-styles/*
  Cache-Control: public, max-age=31536000, immutable
/preview-scripts/*
  Cache-Control: public, max-age=31536000, immutable
# The fonts keep their names across releases: a month fresh, then served while the next copy is checked.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# What programs read is open to any origin: a registry client, an agent in a browser sandbox, a CDN-less demo.
/r/*
  Access-Control-Allow-Origin: *
/*.json
  Access-Control-Allow-Origin: *
/*.md
  Access-Control-Allow-Origin: *
  Content-Type: text/markdown; charset=utf-8
/*.css
  Access-Control-Allow-Origin: *
/llms.txt
  Access-Control-Allow-Origin: *

# The production alias and every immutable deployment URL on pages.dev serve the canonical site's content;
# keep both host shapes out of search indexes without affecting ui.master.co. Release delivery requires it.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:deployment.:project.pages.dev/*
  X-Robots-Tag: noindex
