{
  "name": "@master/ui-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare-site": "node --import tsx scripts/prepare.ts",
    "dev": "bun run prepare-site && astro dev",
    "build": "bun run prepare-site && astro build",
    "preview": "wrangler pages dev out",
    "clean": "rm -rf out .astro .categories public/search node_modules/.vite",
    "type-check": "bun run prepare-site && astro sync && astro-check --tsconfig tsconfig.json && svelte-check --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@master/css": "2.1.7",
    "@master/css-astro": "2.1.7",
    "@master/css-compiler": "2.1.7",
    "@master/css-language-service": "2.1.7",
    "@master/css-preset": "2.1.7",
    "@master/css-schema": "2.1.7",
    "@master/css-tooling": "2.1.7",
    "@master/icons": "1.0.3",
    "@master/icons-astro": "1.0.3",
    "@master/icons-svelte": "1.0.3",
    "@master/internal-site": "0.3.2",
    "@master/ui": "workspace:*",
    "@tiptap/core": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "astro": "7.4.2",
    "clsx": "2.1.1",
    "svelte": "5.57.2",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "esbuild": "0.28.1",
    "github-slugger": "2.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-to-string": "4.0.0",
    "parse5": "8.1.1",
    "sax": "1.6.1",
    "svelte-check": "4.7.7",
    "unist-util-visit": "5.2.0",
    "wrangler": "4.129.0"
  }
}
