{
    "name": "site",
    "private": true,
    "scripts": {
        "prepare": "tsx ../internal/scripts/prepare-app",
        "dev": "pnpm prepare && next dev --port 3600",
        "build": "pnpm prepare && ext build && mcss render \".next/**/*.html\"",
        "start": "next start --port 3600",
        "lint": "next lint",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@master/ui": "workspace:^",
        "@master/ui.react": "workspace:^"
    },
    "devDependencies": {
        "@next/mdx": "^14.2.3",
        "@types/node": "^20.14.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "eslint": "^8.57.0",
        "eslint-config-next": "^14.2.3",
        "internal": "workspace:^",
        "next": "^14.2.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tsx": "^4.11.2",
        "typescript": "^5.4.5"
    }
}