{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "~/site/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src/env.d.ts",
    "**/*.ts",
    "**/*.astro",
    "**/*.svelte"
  ],
  "exclude": [
    "out",
    "node_modules",
    ".astro",
    "public"
  ]
}
