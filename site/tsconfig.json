{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "~/site/*": [
        "./*"
      ],
      "@tabler/icons-svelte-runes/icons/*": [
        "../node_modules/@tabler/icons-svelte-runes/dist/icons/*.svelte"
      ]
    }
  },
  "include": [
    "src/env.d.ts",
    "**/*.ts",
    "**/*.astro",
    "**/*.svelte"
  ],
  "exclude": [
    "out",
    "node_modules",
    ".astro",
    "public"
  ]
}
